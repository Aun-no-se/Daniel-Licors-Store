@using Daniel_Licors_Store.Data
@using Daniel_Licors_Store.Data.Entities
@using Daniel_Licors_Store.Data.Repositories.Interfaces
@using Daniel_Licors_Store.Models.Product
@using Daniel_Licors_Store.Services
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization

<MudDialog Class="pd-root pd-shell" MaxWidth="MaxWidth.Small" FullWidth="true">

    <DialogContent>

        @if (isLoading)
        {
            <!-- Skeleton loader -->
            <div style="padding:0">
                <div style="padding:22px 24px 18px; background:rgba(26,0,0,0.8); border-bottom:1px solid rgba(255,23,68,0.15)">
                    <div class="pd-skeleton" style="height:22px; width:45%; border-radius:6px;"></div>
                    <div class="pd-skeleton" style="height:13px; width:28%; border-radius:4px; margin-top:8px;"></div>
                </div>
                <div class="pd-skeleton pd-skel-img"></div>
                <div style="padding:0 20px">
                    <div class="pd-skeleton pd-skel-line"></div>
                    <div class="pd-skeleton pd-skel-line"></div>
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px">
                        <div class="pd-skeleton pd-skel-line"></div>
                        <div class="pd-skeleton pd-skel-line"></div>
                    </div>
                    <div class="pd-skeleton pd-skel-line"></div>
                    <div class="pd-skeleton pd-skel-line"></div>
                </div>
            </div>
        }
        else
        {
            <MudForm @ref="form" @bind-IsValid="formIsValid">
                <div class="pd-body">

                    <!-- ── Header ── -->
                    <div class="pd-header">
                        <div style="display:flex; align-items:center; gap:12px; justify-content:space-between">
                            <div style="display:flex; align-items:center; gap:12px">
                                <div class="pd-header-accent"></div>
                                <div>
                                    <div class="pd-title">
                                        @(ProductId == null ? "Nueva Bebida" : "Editar Bebida")
                                    </div>
                                    <div class="pd-subtitle">
                                        @(ProductId == null ? "Agrega un nuevo producto al catálogo" : $"Modificando ID #{ProductId}")
                                    </div>
                                </div>
                            </div>
                            <span class="pd-badge @(ProductId == null ? "pd-badge-new" : "pd-badge-edit")">
                                @(ProductId == null ? "NUEVO" : "EDITAR")
                            </span>
                        </div>
                    </div>

                    <!-- ── Image Upload Zone (obligatoria) ── -->
                    <div class="pd-section" style="padding-bottom:0">
                        <div class="pd-section-label">📷 Imagen del producto *</div>
                    </div>

                    <!-- InputFile PRIMERO, fuera del label — el label lo activa nativamente (funciona en móvil) -->
                    <InputFile id="pd-file-input"
                               class="pd-hidden-input"
                               OnChange="OnImageSelected"
                               accept="image/*" />

                    <label for="pd-file-input" style="display:block; margin:0 20px; cursor:pointer">
                        <div class="pd-image-zone @(HasImage ? "has-image" : "") @(isDragOver ? "drag-over" : "") @(imageError ? "has-error" : "")"
                             @ondragover:preventDefault
                             @ondragover="() => isDragOver = true"
                             @ondragleave="() => isDragOver = false"
                             @ondrop:preventDefault
                             @ondrop="HandleDrop">

                            @if (HasImage)
                            {
                                <img src="@(previewImage ?? Model.ImageUrl)" alt="Preview" />
                                <div class="pd-image-overlay">
                                    <span class="pd-overlay-btn">🔄 Cambiar</span>
                                    <span class="pd-overlay-btn" @onclick:stopPropagation @onclick="ClearImage">🗑 Quitar</span>
                                </div>
                            }
                            else
                            {
                                <div class="pd-image-placeholder">
                                    <div class="pd-image-icon">🍾</div>
                                    <div class="pd-image-text-main">Toca aquí para subir imagen</div>
                                    <div class="pd-image-text-sub">PNG, JPG, WEBP · máx 10 MB</div>
                                </div>
                            }
                        </div>
                    </label>

                    @if (imageError)
                    {
                        <div class="pd-image-error-text">La imagen del producto es obligatoria.</div>
                    }

                    <!-- ── Info Básica ── -->
                    <div class="pd-section">
                        <div class="pd-section-label">📋 Información básica</div>

                        <div class="pd-field-row cols-1">
                            <MudTextField @bind-Value="Model.Name"
                                          Label="Nombre del producto"
                                          Variant="Variant.Outlined"
                                          Placeholder="Ej. Brugal Añejo 750ml"
                                          Required="true"
                                          RequiredError="El nombre es obligatorio"
                                          Validation="@(new Func<string, string?>(ValidateName))"
                                          FullWidth />
                        </div>

                        <div class="pd-field-row cols-2">
                            <MudSelect T="int"
                                       Label="Categoría"
                                       @bind-Value="Model.CategoryId"
                                       Variant="Variant.Outlined"
                                       AnchorOrigin="Origin.BottomCenter"
                                       TransformOrigin="Origin.TopCenter"
                                       Required="true"
                                       RequiredError="Selecciona una categoría"
                                       Validation="@(new Func<int, string?>(ValidateCategory))"
                                       FullWidth>
                                @foreach (var c in categories)
                                {
                                    <MudSelectItem @key="c.CategoryId" Value="@c.CategoryId">@c.Name</MudSelectItem>
                                }
                            </MudSelect>

                            <MudSelect T="int?"
                                       Label="Marca"
                                       @bind-Value="Model.BrandId"
                                       Variant="Variant.Outlined"
                                       AnchorOrigin="Origin.BottomCenter"
                                       TransformOrigin="Origin.TopCenter"
                                       FullWidth>
                                <MudSelectItem @key="@("none")" T="int?" Value="@(null)">Sin marca</MudSelectItem>
                                @foreach (var b in brands)
                                {
                                    <MudSelectItem @key="b.BrandId" T="int?" Value="@b.BrandId">@b.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                    </div>

                    <!-- ── Precio & Stock ── -->
                    <div class="pd-section">
                        <div class="pd-section-label">💰 Precio y stock</div>

                        <div class="pd-field-row cols-2">
                            <MudTextField T="decimal"
                                          @bind-Value="Model.Price"
                                          Label="Precio"
                                          Variant="Variant.Outlined"
                                          Adornment="Adornment.Start"
                                          AdornmentText="$"
                                          Required="true"
                                          RequiredError="El precio es obligatorio"
                                          Validation="@(new Func<decimal, string?>(ValidatePrice))"
                                          FullWidth />

                            <MudTextField T="int"
                                          @bind-Value="Model.Stock"
                                          Label="Stock disponible"
                                          Variant="Variant.Outlined"
                                          Adornment="Adornment.End"
                                          AdornmentText="un."
                                          Required="true"
                                          RequiredError="El stock es obligatorio"
                                          Validation="@(new Func<int, string?>(ValidateStock))"
                                          FullWidth />
                        </div>

                        <div class="pd-field-row cols-1">
                            <MudTextField T="int?"
                                          @bind-Value="Model.AgingYears"
                                          Label="Años de añejamiento"
                                          Variant="Variant.Outlined"
                                          Placeholder="Ej. 12"
                                          Adornment="Adornment.End"
                                          AdornmentText="años"
                                          Required="true"
                                          RequiredError="Los años de añejamiento son obligatorios"
                                          Validation="@(new Func<int?, string?>(ValidateAging))"
                                          FullWidth />
                        </div>
                    </div>

                    <!-- ── Opciones ── -->
                    <div class="pd-section">
                        <div class="pd-section-label">⚙️ Opciones</div>

                        <div class="pd-toggle-group">

                            <!-- Premium toggle -->
                            <div class="pd-toggle-card @(Model.IsPremium ? "active-premium" : "")"
                                 @onclick="() => Model.IsPremium = !Model.IsPremium">
                                <div class="pd-toggle-dot @(Model.IsPremium ? "premium" : "off")"></div>
                                <div>
                                    <div class="pd-toggle-label">Premium</div>
                                    <div class="pd-toggle-hint">@(Model.IsPremium ? "Activo" : "No activo")</div>
                                </div>
                            </div>

                            <!-- Activo toggle (solo en edición) -->
                            @if (ProductId.HasValue)
                            {
                                <div class="pd-toggle-card @(Model.IsActive ? "active-status" : "")"
                                     @onclick="() => Model.IsActive = !Model.IsActive">
                                    <div class="pd-toggle-dot @(Model.IsActive ? "status" : "off")"></div>
                                    <div>
                                        <div class="pd-toggle-label">Estado</div>
                                        <div class="pd-toggle-hint">@(Model.IsActive ? "Visible" : "Oculto")</div>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>

                    <div class="pd-spacer"></div>

                </div>
            </MudForm>
        }

    </DialogContent>

    <DialogActions>

        @if (isSaving)
        {
            <div class="pd-saving-badge">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Error" />
                Guardando...
            </div>
        }

        <MudSpacer />

        <MudButton Class="pd-cancel-btn"
                   OnClick="Cancelar"
                   Disabled="isSaving">
            Cancelar
        </MudButton>

        <MudButton Class="pd-save-btn"
                   ButtonType="ButtonType.Button"
                   Disabled="@(isSaving || isLoading)"
                   OnClick="SaveProduct">
            @(ProductId == null ? "✦ Crear producto" : "✦ Guardar cambios")
        </MudButton>

    </DialogActions>

</MudDialog>
