@using Daniel_Licors_Store.Models.Cart
@using MudBlazor

<MudCard Elevation="1"
         Class="@CardClass"
         @onclick="ToggleSelection">
    <MudCardContent Class="pa-3">
        <div class="cart-item-layout">

            <div class="cart-image-container">
                <img src="@(GetImage() ?? "images/placeholder-bottle.png")"
                     alt="@GetItemName()"
                     class="cart-image" />

                <span class="custom-badge @GetBadgeClass()">
                    @GetItemTypeLabel()
                </span>
            </div>

            <div class="cart-info-block">

                <div class="d-flex justify-space-between align-start width-100 gap-2">
                    <div class="flex-grow-1 min-width-0">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold text-truncate-custom line-height-tight">
                            @GetItemName()
                        </MudText>
                        <MudText Typo="Typo.caption" Class="text-muted d-block mt-0">
                            @GetCategory()
                        </MudText>
                    </div>

                    <div @onclick:stopPropagation="true">
                        <MudCheckBox T="bool"
                                     Checked="_isSelected"
                                     CheckedChanged="OnSelectionChanged"
                                     Color="Color.Primary"
                                     Dense="true"
                                     Class="ma-0 pa-0" />
                    </div>
                </div>

                <div class="cart-meta-actions mt-auto pt-3">

                    <div class="qty-selector-container" @onclick:stopPropagation="true">
                        <button type="button" class="qty-btn"
                                disabled="@(_quantity <= 1)"
                                @onclick="DecreaseQuantity">
                            <MudIcon Icon="@Icons.Material.Filled.Remove" Size="Size.Small" />
                        </button>

                        <input type="number"
                               value="@_quantity"
                               @onchange="QuantityChanged"
                               min="1"
                               class="qty-numeric-input" />

                        <button type="button" class="qty-btn" @onclick="IncreaseQuantity">
                            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                        </button>
                    </div>

                    <div class="d-flex align-center gap-3 ml-auto" @onclick:stopPropagation="true">
                        <div class="text-right">
                            <MudText Typo="Typo.caption" Class="text-muted d-block font-size-xs">
                                @_quantity x $@GetUnitPrice().ToString("N2")
                            </MudText>
                            <MudText Typo="Typo.body1" Class="font-weight-bold price-highlight">
                                $@GetSubTotal().ToString("N2")
                            </MudText>
                        </div>

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Medium"
                                       Color="Color.Error"
                                       OnClick="Remove"
                                       Class="delete-action-btn pa-2" />
                    </div>

                </div>

            </div>

        </div>
    </MudCardContent>
</MudCard>
