@using MudBlazor
@using Daniel_Licors_Store.Models.Product
@using Microsoft.AspNetCore.Components.Authorization

<div class="dlc-section">

    <div class="dlc-header">
        <div class="dlc-header-line"></div>
        <h2 class="dlc-title">
            <span class="dlc-title-icon-wrap">
                <MudIcon Icon="@GetCategoryIcon(Title)" Size="Size.Small" />
            </span>
            @Title
        </h2>
        <div class="dlc-header-line"></div>
    </div>

    @if (IsLoading)
    {
        <div class="dlc-skeleton-row">
            @for (int i = 0; i < 5; i++)
            {
                int idx = i;
                <div class="dlc-skel-card @(idx == 2 ? "skel-center" : idx == 1 || idx == 3 ? "skel-side" : "skel-far")">
                    <div class="dlc-skel-img"></div>
                    <div class="dlc-skel-line"></div>
                    <div class="dlc-skel-line short"></div>
                </div>
            }
        </div>
    }
    else if (Products != null && Products.Any())
    {
        <div class="dlc-stage"
             @ontouchstart="OnTouchStart"
             @ontouchend="OnTouchEnd"
             @onmousedown="OnMouseDown"
             @onmouseup="OnMouseUp"
             @onmouseleave="OnMouseLeave">

            <button class="dlc-btn dlc-btn-prev" @onclick="Prev" aria-label="Anterior">
                <span class="dlc-btn-arrow">‹</span>
            </button>

            <div class="dlc-track">
                @for (int i = 0; i < Products.Count; i++)
                {
                    var product = Products[i];
                    int pos = GetPosition(i);
                    string cls = GetCardClass(pos);
                    bool isCenter = pos == 0;
                    int idx2 = i;

                    <div class="dlc-card @cls" @onclick="@(() => CardClicked(idx2))">
                        <div class="dlc-card-glow"></div>
                        <div class="dlc-card-inner">

                            <div class="dlc-img-wrap">
                                <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/placeholder.png" : product.ImageUrl)"
                                     class="dlc-img"
                                     loading="lazy"
                                     alt="@product.Name" />
                                @if (isCenter)
                                {
                                    <div class="dlc-img-shine"></div>
                                }
                            </div>

                            <div class="dlc-info">
                                <span class="dlc-cat-badge">
                                    <MudIcon Icon="@GetCategoryIcon(product.Category)" Size="Size.Small" Class="dlc-cat-badge-icon" />
                                    @product.Category
                                </span>
                                <p class="dlc-name">@product.Name</p>

                                @if (!string.IsNullOrEmpty(product.Description))
                                {
                                    <p class="dlc-desc">@product.Description</p>
                                }

                                @if (isCenter)
                                {
                                    @if (product.Price > 0)
                                    {
                                        <p class="dlc-price">RD$@product.Price.ToString("N0")</p>
                                    }

                                    <div class="dlc-actions">
                                        <button class="dlc-btn-action dlc-btn-view" @onclick:stopPropagation="true"
                                                @onclick="@(() => Nav.NavigateTo($"/producto/{product.ProductId}"))">
                                            <span class="dlc-btn-shine"></span>
                                            <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" />
                                            <span>Ver</span>
                                        </button>

                                        <AuthorizeView Roles="Admin, Empleado, Cliente">
                                            <Authorized>
                                                <button class="dlc-btn-action dlc-btn-add" @onclick:stopPropagation="true"
                                                        @onclick="@(async () => await AgregarAlCarrito(product.ProductId))">
                                                    <span class="dlc-btn-shine"></span>
                                                    <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart" Size="Size.Small" />
                                                    <span>Añadir</span>
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>

                                        <AuthorizeView Roles="Admin, Empleado">
                                            <Authorized>
                                                <button class="dlc-btn-action dlc-btn-edit" @onclick:stopPropagation="true"
                                                        @onclick="@(() => EditarProducto(product.ProductId))">
                                                    <span class="dlc-btn-shine"></span>
                                                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                                                    <span>Editar</span>
                                                </button>
                                                <button class="dlc-btn-action dlc-btn-delete" @onclick:stopPropagation="true"
                                                        @onclick="@(async () => await DeleteProduct(product.ProductId))">
                                                    <span class="dlc-btn-shine"></span>
                                                    <MudIcon Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Small" />
                                                    <span>Ocultar</span>
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <button class="dlc-btn dlc-btn-next" @onclick="Next" aria-label="Siguiente">
                <span class="dlc-btn-arrow">›</span>
            </button>

        </div>

        <div class="dlc-dots">
            @for (int i = 0; i < Products.Count; i++)
            {
                int idx = i;
                <button class="dlc-dot @(idx == _activeIndex ? "active" : "")"
                        @onclick="@(() => GoTo(idx))"
                        aria-label="Ir a @(idx + 1)">
                </button>
            }
        </div>
    }
    else
    {
        <div class="dlc-empty">
            <span>🍾</span>
            <p>No hay productos disponibles</p>
        </div>
    }
</div>
