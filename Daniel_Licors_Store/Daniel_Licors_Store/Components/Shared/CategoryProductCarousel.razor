@using MudBlazor
@using Daniel_Licors_Store.Models.Product
@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JS

<div class="category-section">
    <h2 class="category-title">@Title</h2>

    @if (IsLoading)
    {
        <!--
            FIX: En vez de no renderizar nada mientras carga,
            mostramos un skeleton. Esto mantiene el nodo en el DOM
            y evita que Blazor haga insert/remove violento de la
            sección justo cuando Swiper tiene referencias activas.
        -->
        <div class="swiper-skeleton">
            @for (int i = 0; i < 3; i++)
            {
                <div class="skeleton-card">
                    <div class="skeleton-img"></div>
                    <div class="skeleton-line"></div>
                    <div class="skeleton-line short"></div>
                </div>
            }
        </div>
    }
    else if (Products != null && Products.Any())
    {
        <div class="swiper-container-wrapper">

            <div @ref="swiperElement" class="swiper product-swiper js-product-swiper">
                <div class="swiper-wrapper">

                    @foreach (var product in Products)
                    {
                        <div class="swiper-slide">
                            <div class="product-card">
                                <img src="@product.ImageUrl" class="product-image" />

                                <div class="product-info">
                                    <h3>@product.Name</h3>
                                    <p class="product-category">@product.Category</p>

                                    <div class="actions">
                                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                       Size="Size.Small"
                                                       Variant="Variant.Text"
                                                       Class="action-btn btn-ver"
                                                       Title="Ver detalle"
                                                       OnClick="@(() => Nav.NavigateTo($"/producto/{product.ProductId}"))" />

                                        <AuthorizeView Roles="Admin, Empleado">
                                            <Authorized>
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                               Size="Size.Small"
                                                               Variant="Variant.Text"
                                                               Class="action-btn btn-editar"
                                                               Title="Editar"
                                                               OnClick="@(() => EditarProducto(product.ProductId))" />

                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                               Size="Size.Small"
                                                               Variant="Variant.Text"
                                                               Class="action-btn btn-borrar"
                                                               Title="Eliminar"
                                                               OnClick="@(() => DeleteProduct(product.ProductId))" />
                                            </Authorized>
                                        </AuthorizeView>

                                        <AuthorizeView Roles="Admin, Empleado, Cliente">
                                            <Authorized>
                                                <MudIconButton Icon="@Icons.Material.Filled.Add"
                                                               Size="Size.Small"
                                                               Variant="Variant.Text"
                                                               Class="action-btn btn-anadir"
                                                               Title="Añadir al carrito"
                                                               OnClick="@(async () => await AgregarAlCarrito(product.ProductId))" />
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }

                </div>

                <div class="swiper-button-prev custom-swiper-btn"></div>
                <div class="swiper-button-next custom-swiper-btn"></div>

            </div>

        </div>
    }
    else
    {
        <p class="empty-state">No hay productos disponibles</p>
    }
</div>
