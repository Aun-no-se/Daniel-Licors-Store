@using Daniel_Licors_Store.Models.Cart
@using System.Net.Http
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

<MudDialog>
    <TitleContent>
        <div class="d-flex justify-space-between align-center px-2">
            <div class="d-flex align-center gap-2">
                <div class="receipt-logo-dot"></div>
                <MudText Typo="Typo.h6" Class="font-weight-black receipt-title-text">
                    Daniel Licors Store
                </MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Color="Color.Default"
                           Size="Size.Small"
                           OnClick="@CloseDialog"
                           Style="color:#555;" />
        </div>
    </TitleContent>

    <DialogContent>
        @if (Receipt != null)
        {
            <div class="receipt-container">

                <!-- Cabecera del recibo -->
                <div class="receipt-header text-center mb-3">
                    <MudText Typo="Typo.h5" Class="font-weight-black receipt-store-name">
                        🧾 RECIBO DE COMPRA
                    </MudText>
                    <MudText Typo="Typo.body2" Class="receipt-location mt-1">
                        📍 @Receipt.StoreLocation
                    </MudText>
                    <div class="receipt-dashed-line my-3"></div>
                </div>

                <!-- Info del recibo -->
                <div class="receipt-info-grid mb-3">
                    <div class="receipt-row">
                        <span class="receipt-label">Recibo #</span>
                        <span class="receipt-value font-weight-bold">@Receipt.ReceiptNumber</span>
                    </div>
                    <div class="receipt-row">
                        <span class="receipt-label">Cliente</span>
                        <span class="receipt-value font-weight-bold">@Receipt.CustomerName</span>
                    </div>
                    <div class="receipt-row">
                        <span class="receipt-label">Fecha</span>
                        <span class="receipt-value">@Receipt.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")</span>
                    </div>
                </div>

                <div class="receipt-dashed-line my-3"></div>

                <!-- Detalle de items -->
                <div class="receipt-items-section mb-3">
                    <MudText Typo="Typo.body2" Class="font-weight-black receipt-section-title mb-2">
                        ARTÍCULOS
                    </MudText>

                    @if (Receipt.Items == null || !Receipt.Items.Any())
                    {
                        <div class="text-center py-3" style="color:#999;">
                            <MudText Typo="Typo.body2">No hay artículos en este recibo.</MudText>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in Receipt.Items)
                        {
                            <div class="receipt-item-row">
                                <div class="item-left">
                                    <div class="item-name">@item.ItemName</div>
                                    <div class="item-meta">@item.Category · Cant: @item.Quantity · $@item.UnitPrice.ToString("N2") c/u</div>
                                </div>
                                <div class="item-subtotal">$@item.SubTotal.ToString("N2")</div>
                            </div>
                        }
                    }
                </div>

                <div class="receipt-dashed-line my-3"></div>

                <!-- Total -->
                <div class="receipt-total-row mb-2">
                    <span class="total-label">TOTAL NETO</span>
                    <span class="total-amount">$@Receipt.TotalAmount.ToString("N2")</span>
                </div>

                <div class="receipt-dashed-line my-3"></div>

                <!-- Pie del recibo -->
                <div class="receipt-footer text-center mt-3">
                    <MudText Typo="Typo.body2" Class="font-weight-bold receipt-thanks">
                        ¡Gracias por tu preferencia! 🙏
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color:#999;" Class="d-block mt-1">
                        El detalle completo será enviado por WhatsApp.
                    </MudText>
                </div>

            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="rounded-lg">
                Error: No se pudo procesar la información del recibo.
            </MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <div class="d-flex justify-center gap-3 px-4 pb-4 w-100 flex-wrap">

            <MudButton Variant="Variant.Filled"
                       Style="background:linear-gradient(135deg,#25D366,#128C7E); color:white; font-weight:700; border-radius:10px; min-width:160px;"
                       StartIcon="@Icons.Custom.Brands.WhatsApp"
                       Href="@WhatsAppLink"
                       Target="_blank"
                       Class="py-2">
                Enviar por WhatsApp
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Style="border-color:#667eea; color:#667eea; font-weight:700; border-radius:10px; min-width:120px;"
                       OnClick="@ConfirmAndClose"
                       Class="py-2">
                Confirmar Compra
            </MudButton>

            <MudButton Variant="Variant.Text"
                       Style="color:#999; font-weight:600; border-radius:10px;"
                       OnClick="@CloseDialog"
                       Class="py-2">
                Cancelar
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>
