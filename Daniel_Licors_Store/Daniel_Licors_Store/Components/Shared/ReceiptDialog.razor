@using Daniel_Licors_Store.Models.Cart
@using System.Net.Http
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

<MudDialog>
    <TitleContent>
        <div class="d-flex justify-space-between align-center px-2">
            <MudText Typo="Typo.h5" Class="receipt-black-text font-weight-bold">Tu Recibo</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Color="Color.Default"
                           OnClick="@CloseDialog"
                           Class="cursor-pointer receipt-black-text" />
        </div>
    </TitleContent>

    <DialogContent>
        @if (Receipt != null)
        {
            <div class="receipt-container">

                <div class="receipt-header text-center mb-4">
                    <MudText Typo="Typo.h5" Class="font-weight-black receipt-black-text tracking-wide">DANIEL LICORS STORE</MudText>
                    <MudText Typo="Typo.body2" Class="receipt-black-text font-weight-medium">@Receipt.StoreLocation</MudText>
                    <div class="receipt-dashed-line my-3"></div>
                </div>

                <div class="receipt-info mb-4">
                    <div class="d-flex justify-space-between mb-2">
                        <MudText Typo="Typo.body2" Class="receipt-black-text">Recibo:</MudText>
                        <MudText Typo="Typo.body2" Class="font-weight-bold receipt-black-text">#@Receipt.ReceiptNumber</MudText>
                    </div>
                    <div class="d-flex justify-space-between mb-2">
                        <MudText Typo="Typo.body2" Class="receipt-black-text">Cliente:</MudText>
                        <MudText Typo="Typo.body2" Class="font-weight-bold receipt-black-text">@Receipt.CustomerName</MudText>
                    </div>
                    <div class="d-flex justify-space-between mb-2">
                        <MudText Typo="Typo.body2" Class="receipt-black-text">Fecha:</MudText>
                        <MudText Typo="Typo.body2" Class="font-weight-bold receipt-black-text">@Receipt.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")</MudText>
                    </div>
                </div>

                <div class="receipt-dashed-line my-3"></div>

                <div class="receipt-items mb-4">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-black receipt-black-text mb-2">DETALLE DE COMPRA</MudText>

                    @foreach (var item in Receipt.Items)
                    {
                        <div class="receipt-item d-flex justify-space-between align-center py-2">
                            <div class="item-info">
                                <MudText Typo="Typo.body1" Class="font-weight-bold receipt-black-text">
                                    @item.ItemName
                                </MudText>
                                <MudText Typo="Typo.body2" Class="receipt-black-text opacity-75">
                                    @item.Category - Cantidad: @item.Quantity
                                </MudText>
                            </div>
                            <MudText Typo="Typo.body1" Class="font-weight-bold receipt-black-text">
                                $@item.SubTotal.ToString("N2")
                            </MudText>
                        </div>
                    }
                </div>

                <div class="receipt-dashed-line my-3"></div>

                <div class="receipt-total d-flex justify-space-between align-center my-4">
                    <MudText Typo="Typo.h6" Class="font-weight-black receipt-black-text">TOTAL NETO:</MudText>
                    <MudText Typo="Typo.h5" Class="font-weight-black receipt-black-text">
                        $@Receipt.TotalAmount.ToString("N2")
                    </MudText>
                </div>

                <div class="receipt-dashed-line my-3"></div>

                <div class="receipt-footer text-center mt-4">
                    <MudText Typo="Typo.body1" Class="font-weight-bold receipt-black-text mb-1">¡Gracias por tu preferencia!</MudText>
                    <MudText Typo="Typo.body2" Class="receipt-black-text opacity-75">
                        Tu detalle completo ha sido enviado.
                    </MudText>
                </div>

            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="rounded-lg">
                Error: No se pudo procesar la información del recibo.
            </MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <div class="d-flex justify-center gap-3 px-6 pb-6 w-100">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       StartIcon="@Icons.Custom.Brands.WhatsApp"
                       Href="@WhatsAppLink"
                       Target="_blank"
                       Class="rounded-pill px-4 py-2 font-weight-bold text-transform-none">
                Enviar por WhatsApp
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       OnClick="@CloseDialog"
                       Class="rounded-pill px-4 py-2 font-weight-bold text-transform-none">
                Cerrar
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

<style>
    /* El contenedor exterior que te gusta se queda, mejorando la tipografía interna */
    .receipt-container {
        background: #ffffff;
        padding: 24px;
        border-radius: 12px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        max-width: 420px;
        margin: 0 auto;
    }

    /* Forzar el color negro estricto a las letras interiores */
    .receipt-black-text {
        color: #111111 !important;
    }

    /* Opacidad sutil para descripciones sin perder el color negro */
    .opacity-75 {
        opacity: 0.75;
    }

    .tracking-wide {
        letter-spacing: 1px;
    }

    /* Separador estilo ticket real */
    .receipt-dashed-line {
        border-top: 2px dashed #222222;
        height: 0;
        width: 100%;
    }

    .receipt-item {
        border-bottom: 1px solid #eeeeee;
    }

        .receipt-item:last-child {
            border-bottom: none;
        }

    .item-info {
        flex: 1;
    }

    /* Resaltador del total limpio sin fondos grises opacos */
    .receipt-total {
        background: #f9f9f9;
        padding: 16px;
        border-radius: 8px;
        border: 1px solid #111111;
    }
</style>

@code {
    [Parameter]
    public ReceiptDto? Receipt { get; set; }

    [Parameter]
    public string WhatsAppLink { get; set; } = string.Empty;

    // 🚀 CORREGIDO PARA MUDBLAZOR v8: Usamos IMudDialogInstance
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private void CloseDialog()
    {
        // Se ejecuta el cierre nativo de la v8 perfectamente
        MudDialog.Close();
    }

    private void ShareReceipt()
    {
        // lógica futura
    }
}