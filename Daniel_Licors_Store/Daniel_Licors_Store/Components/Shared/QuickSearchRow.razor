@using Daniel_Licors_Store.Data.Services
@using Daniel_Licors_Store.Models.Product

<div class="qs-row @(Active ? "qs-row-active" : "")"
     role="option"
     aria-selected="@(Active ? "true" : "false")"
     @onclick="() => OnOpen.InvokeAsync(Product)">

    <img class="qs-thumb"
         src="@(string.IsNullOrEmpty(Product.ImageUrl) ? "/images/placeholder.png" : Product.ImageUrl)"
         loading="lazy"
         draggable="false"
         alt="" />

    <div class="qs-row-main">
        <div class="qs-row-name">
            @foreach (var part in _parts)
            {
                if (part.IsHit)
                {
                    <mark class="qs-hit">@part.Text</mark>
                }
                else
                {
                    <span>@part.Text</span>
                }
            }
        </div>
        <div class="qs-row-meta">@_meta</div>
    </div>

    <div class="qs-row-side">
        @if (Product.Price > 0)
        {
            <span class="qs-row-price">RD$@Product.Price.ToString("N0")</span>
        }

        @if (!Product.InStock)
        {
            <span class="qs-row-out">Agotado</span>
        }
        else if (CanAdd)
        {
            <button type="button"
                    class="qs-add @(Added ? "qs-add-done" : "")"
                    disabled="@Busy"
                    aria-label="Añadir @Product.Name al carrito"
                    @onclick="() => OnAdd.InvokeAsync(Product)"
                    @onclick:stopPropagation="true">
                @if (Added)
                {
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 12 10 18 20 6"></polyline></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                }
            </button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SearchProductDto Product { get; set; } = default!;
    [Parameter] public string Query { get; set; } = string.Empty;
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool CanAdd { get; set; }
    [Parameter] public bool Added { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<SearchProductDto> OnOpen { get; set; }
    [Parameter] public EventCallback<SearchProductDto> OnAdd { get; set; }

    private List<HighlightPart> _parts = new();
    private string _meta = string.Empty;

    protected override void OnParametersSet()
    {
        _parts = ProductSearchService.Highlight(Product.Name, Query);

        _meta = string.Join(" · ", new[] { Product.Brand, Product.Category, Product.Size }
            .Where(x => !string.IsNullOrWhiteSpace(x)));
    }
}
