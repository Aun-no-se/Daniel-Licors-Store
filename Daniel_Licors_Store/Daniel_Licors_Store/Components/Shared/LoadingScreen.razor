@namespace Daniel_Licors_Store.Components.Shared

<div class="ld-stage">

    <div class="ld-vignette"></div>

    <div class="ld-content">

        <svg class="ld-scene" viewBox="0 0 360 340" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="ldGlassBottle" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#2a2a2a" />
                    <stop offset="55%" stop-color="#161616" />
                    <stop offset="100%" stop-color="#050505" />
                </linearGradient>
                <linearGradient id="ldLabel" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#F5DFA0" />
                    <stop offset="100%" stop-color="#C89B45" />
                </linearGradient>
                <linearGradient id="ldLiquid" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#FF4569" />
                    <stop offset="100%" stop-color="#B71C1C" />
                </linearGradient>
                <clipPath id="ldTumblerClip">
                    <path d="M 250,232 L 300,232 L 293,300 C 292,306 288,309 282,309 L 268,309 C 262,309 258,306 257,300 Z" />
                </clipPath>
            </defs>

            <!-- ══ VASO ══ -->
            <g class="ld-tumbler">
                <path class="ld-tumbler-glass" d="M 250,232 L 300,232 L 293,300 C 292,306 288,309 282,309 L 268,309 C 262,309 258,306 257,300 Z"
                      fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.28)" stroke-width="2" />
                <g clip-path="url(#ldTumblerClip)">
                    <rect class="ld-tumbler-liquid" x="250" y="300" width="50" height="0" fill="url(#ldLiquid)" />
                    <circle class="ld-bubble ld-bubble-1" cx="266" cy="300" r="2.4" fill="rgba(255,255,255,0.6)" />
                    <circle class="ld-bubble ld-bubble-2" cx="278" cy="300" r="1.8" fill="rgba(255,255,255,0.5)" />
                    <circle class="ld-bubble ld-bubble-3" cx="286" cy="300" r="2" fill="rgba(255,255,255,0.55)" />
                </g>
                <path d="M 250,232 L 300,232 L 293,300 C 292,306 288,309 282,309 L 268,309 C 262,309 258,306 257,300 Z"
                      fill="none" stroke="rgba(255,255,255,0.28)" stroke-width="2" />
            </g>

            <!-- ══ CHORRO ══ -->
            <path class="ld-stream" d="M 148,110 C 175,140 205,165 248,222" fill="none"
                  stroke="url(#ldLiquid)" stroke-width="5" stroke-linecap="round" />

            <!-- ══ BOTELLA ══ -->
            <g class="ld-bottle">
                <!-- cuerpo -->
                <rect x="78" y="140" width="104" height="180" rx="24" fill="url(#ldGlassBottle)" stroke="#3a3a3a" stroke-width="1.5" />
                <!-- etiqueta -->
                <rect x="98" y="222" width="64" height="52" rx="6" fill="url(#ldLabel)" opacity="0.95" />
                <rect x="98" y="222" width="64" height="52" rx="6" fill="none" stroke="#7A0C1E" stroke-width="1.3" opacity="0.5" />
                <!-- hombro + cuello -->
                <path d="M 100,140 C 100,105 112,85 117,80 L 143,80 C 148,85 160,105 160,140 Z"
                      fill="url(#ldGlassBottle)" stroke="#3a3a3a" stroke-width="1.5" />
                <rect x="117" y="52" width="26" height="32" rx="4" fill="url(#ldGlassBottle)" stroke="#3a3a3a" stroke-width="1.5" />
            </g>

            <!-- ══ CORCHO ══ -->
            <rect class="ld-cork" x="114" y="34" width="32" height="24" rx="5" fill="#C89B45" />

        </svg>

        <div class="ld-text">
            <p class="ld-message">
                @Message<span class="ld-dots"><span>.</span><span>.</span><span>.</span></span>
            </p>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="ld-subtitle">@Subtitle</p>
            }
        </div>

        <div class="ld-progress"><span></span></div>

    </div>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;900&family=Poppins:wght@300;400;500;600;700&display=swap');

    .ld-stage {
        --ld-black: #050505;
        --ld-crimson: #FF1744;
        --ld-crimson-deep: #7A0C1E;
        --ld-gold: #E8C468;
        --ld-gold-soft: #F5DFA0;
        --ld-ink: #F3EFE7;
        --ld-muted: #B9AFAE;

        position: fixed;
        inset: 0;
        z-index: 4000;
        background:
            radial-gradient(120% 90% at 50% -10%, rgba(255,23,68,0.12), transparent 55%),
            radial-gradient(90% 70% at 90% 110%, rgba(232,196,104,0.08), transparent 60%),
            var(--ld-black);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Poppins', sans-serif;
    }

    .ld-vignette {
        position: absolute;
        inset: 0;
        pointer-events: none;
        box-shadow: inset 0 0 160px 40px rgba(0,0,0,0.75);
    }

    .ld-content {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .ld-scene {
        width: min(70vw, 300px);
        height: auto;
        filter: drop-shadow(0 24px 34px rgba(0,0,0,0.55));
    }

    /* ── Botella: leve balanceo al servir ── */
    .ld-bottle {
        transform-origin: 78px 320px;
        animation: ld-pour 4.5s ease-in-out infinite;
    }

    @@keyframes ld-pour {
        0%, 12%   { transform: rotate(0deg); }
        30%, 62%  { transform: rotate(22deg); }
        82%, 100% { transform: rotate(0deg); }
    }

    /* ── Corcho: se dispara y vuelve a aparecer ── */
    .ld-cork {
        transform-origin: 130px 58px;
        animation: ld-cork-pop 4.5s ease-in infinite;
    }

    @@keyframes ld-cork-pop {
        0%, 6%   { opacity: 1; transform: translate(0, 0) rotate(0deg); }
        20%      { opacity: 1; transform: translate(6px, -70px) rotate(160deg); }
        26%      { opacity: 0; transform: translate(10px, -95px) rotate(220deg); }
        90%      { opacity: 0; }
        100%     { opacity: 1; transform: translate(0, 0) rotate(0deg); }
    }

    /* ── Chorro de licor ── */
    .ld-stream {
        opacity: 0;
        stroke-dasharray: 130;
        stroke-dashoffset: 130;
        animation: ld-stream 4.5s ease-in-out infinite;
    }

    @@keyframes ld-stream {
        0%, 26%   { opacity: 0; stroke-dashoffset: 130; }
        30%       { opacity: 1; }
        34%, 60%  { opacity: 1; stroke-dashoffset: 0; }
        66%       { opacity: 0; stroke-dashoffset: 0; }
        100%      { opacity: 0; stroke-dashoffset: 130; }
    }

    /* ── Vaso llenándose ── */
    .ld-tumbler-liquid {
        animation: ld-fill 4.5s ease-in-out infinite;
    }

    @@keyframes ld-fill {
        0%, 30%  { y: 300; height: 0; }
        68%      { y: 246; height: 54; }
        88%      { y: 246; height: 54; }
        100%     { y: 300; height: 0; }
    }

    .ld-bubble {
        opacity: 0;
        animation: ld-bubble-rise 2.2s ease-in infinite;
    }

    .ld-bubble-2 { animation-delay: 0.5s; }
    .ld-bubble-3 { animation-delay: 1.1s; }

    @@keyframes ld-bubble-rise {
        0%   { opacity: 0; transform: translateY(0); }
        15%  { opacity: 0.8; }
        90%  { opacity: 0; transform: translateY(-55px); }
        100% { opacity: 0; transform: translateY(-58px); }
    }

    /* ── Texto ── */
    .ld-text {
        margin-top: 22px;
    }

    .ld-message {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: clamp(1.1rem, 3vw, 1.5rem);
        color: var(--ld-ink);
        margin: 0;
        letter-spacing: 0.01em;
    }

    .ld-dots span {
        animation: ld-dot-blink 1.4s infinite;
        opacity: 0;
    }

    .ld-dots span:nth-child(2) { animation-delay: 0.2s; }
    .ld-dots span:nth-child(3) { animation-delay: 0.4s; }

    @@keyframes ld-dot-blink {
        0%, 20%  { opacity: 0; }
        50%      { opacity: 1; }
        100%     { opacity: 0; }
    }

    .ld-subtitle {
        font-size: 0.82rem;
        color: var(--ld-muted);
        margin: 6px 0 0;
    }

    /* ── Barra de progreso ambiental ── */
    .ld-progress {
        width: 180px;
        height: 3px;
        border-radius: 3px;
        background: rgba(255,255,255,0.08);
        overflow: hidden;
        margin-top: 22px;
    }

        .ld-progress span {
            display: block;
            height: 100%;
            width: 40%;
            border-radius: 3px;
            background: linear-gradient(90deg, var(--ld-gold), var(--ld-crimson));
            animation: ld-progress-slide 1.6s ease-in-out infinite;
        }

    @@keyframes ld-progress-slide {
        0%   { transform: translateX(-100%); }
        100% { transform: translateX(350%); }
    }

    @@media (prefers-reduced-motion: reduce) {
        .ld-bottle, .ld-cork, .ld-stream, .ld-tumbler-liquid, .ld-bubble, .ld-dots span, .ld-progress span {
            animation: none !important;
        }
    }
</style>

@code {
    /// <summary>Título principal (ej. "Autorizando tu acceso"). Se le anima un "..." al final.</summary>
    [Parameter] public string Message { get; set; } = "Preparando tu pedido";

    /// <summary>Línea secundaria opcional, más pequeña y en tono apagado.</summary>
    [Parameter] public string? Subtitle { get; set; }
}
