@namespace Daniel_Licors_Store.Components.Shared

<div class="ld-stage">

    <div class="ld-vignette"></div>

    <div class="ld-content">

        <svg class="ld-scene" viewBox="0 0 360 340" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="ldGlassBottle" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#2a2a2a" />
                    <stop offset="55%" stop-color="#161616" />
                    <stop offset="100%" stop-color="#050505" />
                </linearGradient>
                <linearGradient id="ldLabel" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#F5DFA0" />
                    <stop offset="100%" stop-color="#C89B45" />
                </linearGradient>
                <linearGradient id="ldLiquid" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#FF4569" />
                    <stop offset="100%" stop-color="#B71C1C" />
                </linearGradient>
                <clipPath id="ldTumblerClip">
                    <path d="M 250,232 L 300,232 L 293,300 C 292,306 288,309 282,309 L 268,309 C 262,309 258,306 257,300 Z" />
                </clipPath>
            </defs>

            <!-- ══ VASO ══ -->
            <g class="ld-tumbler">
                <path class="ld-tumbler-glass" d="M 250,232 L 300,232 L 293,300 C 292,306 288,309 282,309 L 268,309 C 262,309 258,306 257,300 Z"
                      fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.28)" stroke-width="2" />
                <g clip-path="url(#ldTumblerClip)">
                    <rect class="ld-tumbler-liquid" x="250" y="300" width="50" height="0" fill="url(#ldLiquid)" />
                    <circle class="ld-bubble ld-bubble-1" cx="266" cy="300" r="2.4" fill="rgba(255,255,255,0.6)" />
                    <circle class="ld-bubble ld-bubble-2" cx="278" cy="300" r="1.8" fill="rgba(255,255,255,0.5)" />
                    <circle class="ld-bubble ld-bubble-3" cx="286" cy="300" r="2" fill="rgba(255,255,255,0.55)" />
                </g>
                <path d="M 250,232 L 300,232 L 293,300 C 292,306 288,309 282,309 L 268,309 C 262,309 258,306 257,300 Z"
                      fill="none" stroke="rgba(255,255,255,0.28)" stroke-width="2" />
            </g>

            <!-- ══ CHORRO ══ -->
            <path class="ld-stream" d="M 148,110 C 175,140 205,165 248,222" fill="none"
                  stroke="url(#ldLiquid)" stroke-width="5" stroke-linecap="round" />

            <!-- ══ BOTELLA ══ -->
            <g class="ld-bottle">
                <!-- cuerpo -->
                <rect x="78" y="140" width="104" height="180" rx="24" fill="url(#ldGlassBottle)" stroke="#3a3a3a" stroke-width="1.5" />
                <!-- etiqueta -->
                <rect x="98" y="222" width="64" height="52" rx="6" fill="url(#ldLabel)" opacity="0.95" />
                <rect x="98" y="222" width="64" height="52" rx="6" fill="none" stroke="#7A0C1E" stroke-width="1.3" opacity="0.5" />
                <!-- hombro + cuello -->
                <path d="M 100,140 C 100,105 112,85 117,80 L 143,80 C 148,85 160,105 160,140 Z"
                      fill="url(#ldGlassBottle)" stroke="#3a3a3a" stroke-width="1.5" />
                <rect x="117" y="52" width="26" height="32" rx="4" fill="url(#ldGlassBottle)" stroke="#3a3a3a" stroke-width="1.5" />
            </g>

            <!-- ══ CORCHO ══ -->
            <rect class="ld-cork" x="114" y="34" width="32" height="24" rx="5" fill="#C89B45" />

        </svg>

        <div class="ld-text">
            <p class="ld-message">
                @Message<span class="ld-dots"><span>.</span><span>.</span><span>.</span></span>
            </p>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="ld-subtitle">@Subtitle</p>
            }
        </div>

        <div class="ld-progress"><span></span></div>

    </div>
</div>

@code {
    /// <summary>Título principal (ej. "Autorizando tu acceso"). Se le anima un "..." al final.</summary>
    [Parameter] public string Message { get; set; } = "Preparando tu pedido";

    /// <summary>Línea secundaria opcional, más pequeña y en tono apagado.</summary>
    [Parameter] public string? Subtitle { get; set; }
}
