@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider Theme="@Theme" />
<MudBreakpointProvider />
<MudPopoverProvider />

<MudLayout>

    <TopBar />

    <MudMainContent Class="main-content">
        <MudContainer MaxWidth="MaxWidth.False">
            @Body
        </MudContainer>
    </MudMainContent>

</MudLayout>

@code {
    private MudTheme Theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#F44336",         // Red Default
            AppbarBackground = "#B71C1C", // Red Darken2
            AppbarText = "#FFFFFF",      // Shades White
            Background = "#FAFAFA",      // Gray Lighten5
            Surface = "#FFFFFF",
            TextPrimary = "#212121",     // Gray Darken4
            TextSecondary = "#616161"    // Gray Darken2
        }
    };
}
