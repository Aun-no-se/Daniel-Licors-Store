@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider Theme="@Theme" />
<MudBreakpointProvider />
<MudPopoverProvider />
<MudDialogProvider />

<MudLayout>

    <TopBar />

    <MudMainContent Class="main-content">
        <MudContainer MaxWidth="MaxWidth.False">
            @Body
        </MudContainer>
    </MudMainContent>

</MudLayout>

@code {
    private MudTheme Theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#F44336",
            AppbarBackground = "#B71C1C",
            AppbarText = "#FFFFFF",
            // Cambiamos Background para que coincida con tu inicio de gradiente
            Background = "#B71C1C",
            Surface = "#B71C1C", // Cambia Surface también si ves bordes blancos en AbrirAgregarBebida
            TextPrimary = "#FFFFFF", // Probablemente quieras texto blanco sobre fondo rojo
  
        }
    };
}
