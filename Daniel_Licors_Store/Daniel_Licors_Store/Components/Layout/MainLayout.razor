@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider Theme="@Theme" IsDarkMode="true" />
<MudBreakpointProvider />
<MudPopoverProvider />
<MudDialogProvider />

<MudLayout>

    <TopBar />

    <MudMainContent Class="mud-main-content-reset">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
            @Body
        </MudContainer>
    </MudMainContent>

</MudLayout>

@code {
    private MudTheme Theme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#FF1744",
            Secondary = "#E53935",
            Background = "#0D0D0D",
            Surface = "#1A1A1A",
            AppbarBackground = "#0D0D0D00",
            TextPrimary = "#FFFFFF",
            TextSecondary = "#BDBDBD",
            DrawerBackground = "#121212"
        }
    };
}