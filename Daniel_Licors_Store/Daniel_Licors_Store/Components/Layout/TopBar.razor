@using Daniel_Licors_Store.Components.Product
@using Daniel_Licors_Store.Data.Services
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider

<MudAppBar Fixed="true" Elevation="0" Class="topbar">
    <div class="topbar-grid">

        <NavLink Href="/" Style="text-decoration: none; color: inherit;">
            <div class="topbar-left" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                <MudIcon Icon="@Icons.Material.Filled.LocalBar"
                         Size="Size.Medium"
                         Style="color: #FF1744; filter: drop-shadow(0 0 5px rgba(255,23,68,0.5));" />
                DANIEL LIQUOR STORE
            </div>
        </NavLink>

        <div class="topbar-center"></div>

        <div class="topbar-right">

            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
                    <ActivatorContent>
                        <MudIconButton Icon="@Icons.Material.Filled.Menu" Style="color: white;" />
                    </ActivatorContent>

                    <ChildContent>
                        <AuthorizeView>
                            <NotAuthorized>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/login"))" Icon="@Icons.Material.Filled.Login">Login</MudMenuItem>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/register"))" Icon="@Icons.Material.Filled.PersonAdd">Registrarse</MudMenuItem>
                            </NotAuthorized>
                        </AuthorizeView>

                        @* SECCIÓN DE COMPRAS / CLIENTE (Disponible para todos los autenticados) *@
                        <AuthorizeView>
                            <Authorized>
                                <p class="menu-mobile-header">Tienda</p>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/combos"))" Icon="@Icons.Material.Filled.LocalMall">
                                    Combos
                                </MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.ShoppingCart">
                                    Carrito
                                </MudMenuItem>
                            </Authorized>
                        </AuthorizeView>

                        @* SECCIÓN DE GESTIÓN (Solo Empleados y Admins) *@
                        <AuthorizeView Roles="Empleado, Admin">
                            <Authorized>
                                <MudDivider Class="my-2" />
                                <p class="menu-mobile-header-work">Gestión Empleado</p>

                                <MudMenuItem OnClick="AbrirAgregarBebida" Icon="@Icons.Material.Filled.AddCircle">
                                    Agregar Bebida
                                </MudMenuItem>
                            </Authorized>
                        </AuthorizeView>

                        @* SECCIÓN DE ADMINISTRACIÓN (Solo Admins) *@
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <MudDivider Class="my-2" />
                                <p class="menu-mobile-header-admin">Administración</p>

                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/dashboard"))" Icon="@Icons.Material.Filled.Dashboard">
                                    Panel de Control
                                </MudMenuItem>
                            </Authorized>
                        </AuthorizeView>

                        @* BOTÓN DE LOGOUT (Al final y bien separado) *@
                        <AuthorizeView>
                            <Authorized>
                                <MudDivider Class="my-2" />
                                <MudMenuItem OnClick="Logout" Style="color:#FF5252" Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error">
                                    Cerrar sesión
                                </MudMenuItem>
                            </Authorized>
                        </AuthorizeView>
                    </ChildContent>
                </MudMenu>
            </MudHidden>

            <MudHidden Breakpoint="Breakpoint.SmAndDown">

                <AuthorizeView>
                    <NotAuthorized>
                        <MudMenu>
                            <ActivatorContent>
                                <MudButton Variant="Variant.Text" Class="btn-licol-text">Servicios</MudButton>
                            </ActivatorContent>
                            <ChildContent>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/combos"))">Combos</MudMenuItem>
                            </ChildContent>
                        </MudMenu>

                        <MudButton Variant="Variant.Text" Class="btn-licol-text" OnClick="@(() => Nav.NavigateTo("/login"))">Login</MudButton>
                        <MudButton Variant="Variant.Filled" Class="btn-licol-highlight" OnClick="@(() => Nav.NavigateTo("/register"))">Registrarse</MudButton>
                    </NotAuthorized>
                </AuthorizeView>

                <AuthorizeView Roles="Cliente">
                    <MudMenu>
                        <ActivatorContent>
                            <MudButton Variant="Variant.Text" Class="btn-licol-text">Servicios</MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/combos"))">Combos</MudMenuItem>
                        </ChildContent>
                    </MudMenu>

                    <MudButton Variant="Variant.Text" Class="btn-licol-text" StartIcon="@Icons.Material.Filled.ShoppingCart">
                        Carrito
                    </MudButton>

                    <MudButton Variant="Variant.Text" Class="btn-licol-logout-text" OnClick="Logout">
                        Cierre de Sesión
                    </MudButton>
                </AuthorizeView>

                <AuthorizeView Roles="Empleado">
                    <MudButton Variant="Variant.Filled" Class="btn-licol-highlight"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AbrirAgregarBebida">
                        Agregar Bebida
                    </MudButton>

                    <MudMenu>
                        <ActivatorContent>
                            <MudButton Variant="Variant.Text" Class="btn-licol-text">Servicios</MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/combos"))">Combos</MudMenuItem>
                        </ChildContent>
                    </MudMenu>

                    <MudButton Variant="Variant.Text" Class="btn-licol-text" StartIcon="@Icons.Material.Filled.ShoppingCart">
                        Carrito
                    </MudButton>

                    <MudButton Variant="Variant.Text" Class="btn-licol-logout-text" OnClick="Logout">
                        Cierre de Sesión
                    </MudButton>
                </AuthorizeView>

                <AuthorizeView Roles="Admin">
                    <MudButton Variant="Variant.Filled" Class="btn-licol-highlight"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AbrirAgregarBebida">
                        Agregar Bebida
                    </MudButton>

                    <MudMenu>
                        <ActivatorContent>
                            <MudButton Variant="Variant.Text" Class="btn-licol-text"
                                       StartIcon="@Icons.Material.Filled.Settings">
                                Servicios
                            </MudButton>
                        </ActivatorContent>
                        <ChildContent>
                            <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/dashboard"))">
                                Panel de Control
                            </MudMenuItem>
                            <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/combos"))">
                                Combos
                            </MudMenuItem>
                        </ChildContent>
                    </MudMenu>

                    <MudButton Variant="Variant.Text" Class="btn-licol-text" StartIcon="@Icons.Material.Filled.ShoppingCart">
                        Carrito
                    </MudButton>

                    <MudButton Variant="Variant.Text" Class="btn-licol-logout-text" OnClick="Logout">
                        Cierre de Sesión
                    </MudButton>
                </AuthorizeView>

            </MudHidden>

        </div>
    </div>
</MudAppBar>

@code {
    void AbrirAgregarBebida()
    {
        DialogService.Show<ProductDialog>("Agregar Bebida");
    }

    private async Task Logout()
    {
        if (AuthStateProvider is CustomAuthStateProvider custom)
        {
            await custom.Logout();
        }
        Nav.NavigateTo("/", forceLoad: true);
    }
}