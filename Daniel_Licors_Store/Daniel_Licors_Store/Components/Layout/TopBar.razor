@using Daniel_Licors_Store.Components.Product
@using Daniel_Licors_Store.Data.Services
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider

<MudAppBar Fixed="true" Elevation="0" Class="topbar">
    <div class="topbar-inner">

        <NavLink Href="/" class="brand-link">
            <div class="brand-badge">
                <MudIcon Icon="@Icons.Material.Filled.LocalBar" Size="Size.Medium" />
            </div>
            <div class="brand-text">
                <span class="brand-text-main">DANIEL LIQUOR</span>
                <span class="brand-text-sub">Fine Spirits &amp; Store</span>
            </div>
        </NavLink>

        <div class="actions-bar">

            <!-- ═══════════════ MÓVIL ═══════════════ -->
            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
                    <ActivatorContent>
                        <MudIconButton Icon="@Icons.Material.Filled.Menu" Class="liq-mobile-trigger" />
                    </ActivatorContent>

                    <ChildContent>

                        <!-- Cliente sin sesión -->
                        <AuthorizeView>
                            <NotAuthorized>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/login"))" Icon="@Icons.Material.Filled.Login">Login</MudMenuItem>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/register"))" Icon="@Icons.Material.Filled.PersonAdd">Registrarse</MudMenuItem>
                            </NotAuthorized>
                        </AuthorizeView>

                        <!-- Empleado / Admin: acción rápida + Servicios agrupados -->
                        <AuthorizeView Roles="Empleado, Admin">
                            <Authorized>
                                <MudMenuItem OnClick="AbrirAgregarBebida" Icon="@Icons.Material.Filled.AddCircle">
                                    Agregar Bebida
                                </MudMenuItem>

                                <div class="svc-divider"></div>
                                <p class="svc-group-title">Gestión de Tienda</p>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/dashboard"))" Icon="@Icons.Material.Filled.Dashboard">
                                    Panel de Control
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/combos"))" Icon="@Icons.Material.Filled.LocalMall">
                                    Combos
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/promociones"))" Icon="@Icons.Material.Filled.LocalOffer">
                                    Promociones
                                </MudMenuItem>
                            </Authorized>
                        </AuthorizeView>

                        <!-- Solo Admin: Administración -->
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <div class="svc-divider"></div>
                                <p class="svc-group-title">Administración</p>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/stock"))" Icon="@Icons.Material.Filled.Inventory2">
                                    Stock General
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/usuarios"))" Icon="@Icons.Material.Filled.ManageAccounts">
                                    Gestión de Cuentas
                                </MudMenuItem>
                            </Authorized>
                        </AuthorizeView>

                        <!-- Común a todo usuario autenticado -->
                        <AuthorizeView>
                            <Authorized>
                                <div class="svc-divider"></div>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/carrito"))" Icon="@Icons.Material.Filled.ShoppingCart">
                                    Carrito
                                </MudMenuItem>
                                <MudMenuItem OnClick="Logout" Icon="@Icons.Material.Filled.Logout" Class="svc-logout">
                                    Cerrar sesión
                                </MudMenuItem>
                            </Authorized>
                        </AuthorizeView>

                    </ChildContent>
                </MudMenu>
            </MudHidden>

            <!-- ═══════════════ DESKTOP ═══════════════ -->
            <MudHidden Breakpoint="Breakpoint.SmAndDown">

                <!-- Sin sesión -->
                <AuthorizeView>
                    <NotAuthorized>
                        <MudButton Variant="Variant.Text" Class="btn-liq-ghost" OnClick="@(() => Nav.NavigateTo("/login"))">Login</MudButton>
                        <MudButton Variant="Variant.Filled" Class="btn-liq-solid" OnClick="@(() => Nav.NavigateTo("/register"))">Registrarse</MudButton>
                    </NotAuthorized>
                </AuthorizeView>

                <!-- Cliente -->
                <AuthorizeView Roles="Cliente">
                    <Authorized>
                        <MudButton Variant="Variant.Text" Class="btn-liq-ghost btn-liq-cart"
                                   StartIcon="@Icons.Material.Filled.ShoppingCart"
                                   OnClick="@(() => Nav.NavigateTo("/carrito"))">
                            Carrito
                        </MudButton>

                        <MudButton Variant="Variant.Text" Class="btn-liq-ghost btn-liq-logout" OnClick="Logout">
                            Cerrar sesión
                        </MudButton>
                    </Authorized>
                </AuthorizeView>

                <!-- Empleado -->
                <AuthorizeView Roles="Empleado">
                    <Authorized>
                        <MudButton Variant="Variant.Filled" Class="btn-liq-solid"
                                   StartIcon="@Icons.Material.Filled.AddCircle"
                                   OnClick="AbrirAgregarBebida">
                            Agregar Bebida
                        </MudButton>

                        <MudMenu>
                            <ActivatorContent>
                                <MudButton Variant="Variant.Outlined" Class="btn-liq-services"
                                           EndIcon="@Icons.Material.Filled.ExpandMore">
                                    Servicios
                                </MudButton>
                            </ActivatorContent>
                            <ChildContent>
                                <p class="svc-group-title">Gestión de Tienda</p>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/dashboard"))" Icon="@Icons.Material.Filled.Dashboard">
                                    Panel de Control
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/combos"))" Icon="@Icons.Material.Filled.LocalMall">
                                    Combos
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/promociones"))" Icon="@Icons.Material.Filled.LocalOffer">
                                    Promociones
                                </MudMenuItem>
                            </ChildContent>
                        </MudMenu>

                        <MudButton Variant="Variant.Text" Class="btn-liq-ghost btn-liq-cart"
                                   StartIcon="@Icons.Material.Filled.ShoppingCart"
                                   OnClick="@(() => Nav.NavigateTo("/carrito"))">
                            Carrito
                        </MudButton>

                        <MudButton Variant="Variant.Text" Class="btn-liq-ghost btn-liq-logout" OnClick="Logout">
                            Cerrar sesión
                        </MudButton>
                    </Authorized>
                </AuthorizeView>

                <!-- Admin -->
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <MudButton Variant="Variant.Filled" Class="btn-liq-solid"
                                   StartIcon="@Icons.Material.Filled.AddCircle"
                                   OnClick="AbrirAgregarBebida">
                            Agregar Bebida
                        </MudButton>

                        <MudMenu>
                            <ActivatorContent>
                                <MudButton Variant="Variant.Outlined" Class="btn-liq-services"
                                           EndIcon="@Icons.Material.Filled.ExpandMore">
                                    Servicios
                                </MudButton>
                            </ActivatorContent>
                            <ChildContent>
                                <p class="svc-group-title">Gestión de Tienda</p>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/dashboard"))" Icon="@Icons.Material.Filled.Dashboard">
                                    Panel de Control
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/combos"))" Icon="@Icons.Material.Filled.LocalMall">
                                    Combos
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/promociones"))" Icon="@Icons.Material.Filled.LocalOffer">
                                    Promociones
                                </MudMenuItem>

                                <div class="svc-divider"></div>
                                <p class="svc-group-title">Administración</p>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/stock"))" Icon="@Icons.Material.Filled.Inventory2">
                                    Stock General
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin/usuarios"))" Icon="@Icons.Material.Filled.ManageAccounts">
                                    Gestión de Cuentas
                                </MudMenuItem>
                            </ChildContent>
                        </MudMenu>

                        <MudButton Variant="Variant.Text" Class="btn-liq-ghost btn-liq-cart"
                                   StartIcon="@Icons.Material.Filled.ShoppingCart"
                                   OnClick="@(() => Nav.NavigateTo("/carrito"))">
                            Carrito
                        </MudButton>

                        <MudButton Variant="Variant.Text" Class="btn-liq-ghost btn-liq-logout" OnClick="Logout">
                            Cerrar sesión
                        </MudButton>
                    </Authorized>
                </AuthorizeView>

            </MudHidden>

        </div>
    </div>
</MudAppBar>

@code {
    void AbrirAgregarBebida()
    {
        DialogService.Show<ProductDialog>("Agregar Bebida");
    }

    private async Task Logout()
    {
        if (AuthStateProvider is CustomAuthStateProvider custom)
        {
            await custom.Logout();
        }
        Nav.NavigateTo("/", forceLoad: true);
    }
}
