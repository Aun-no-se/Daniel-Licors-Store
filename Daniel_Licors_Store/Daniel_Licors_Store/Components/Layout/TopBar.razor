@using Daniel_Licors_Store.Components.Product
@using Daniel_Licors_Store.Data.Services
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider

<MudAppBar Fixed="true" Elevation="0" Class="topbar">
    <div class="topbar-grid">

        <NavLink Href="/" Style="text-decoration: none; color: inherit;">
            <div class="topbar-left" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                <MudIcon Icon="@Icons.Material.Filled.LocalBar"
                         Size="Size.Medium"
                         Style="color: #FF1744; filter: drop-shadow(0 0 5px rgba(255,23,68,0.5));" />
                DANIEL LIQUOR STORE
            </div>
        </NavLink>

        <div class="topbar-center">
        </div>

        <div class="topbar-right">

            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <MudIconButton Icon="@Icons.Material.Filled.Menu" Style="color: white;" />
                    </ActivatorContent>
                    <ChildContent>
                        <AuthorizeView>
                            <NotAuthorized>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/login"))">Login</MudMenuItem>
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/register"))">Registrarse</MudMenuItem>
                                <MudDivider Dense="true" Style="background: rgba(255,255,255,0.1);" />
                                <MudMenuItem>Servicios</MudMenuItem>
                            </NotAuthorized>
                        </AuthorizeView>

                        <AuthorizeView Roles="Cliente">
                            <MudMenuItem>Servicios</MudMenuItem>
                            <MudMenuItem>Carrito</MudMenuItem>
                            <MudDivider Dense="true" Style="background: rgba(255,255,255,0.1);" />
                            <MudMenuItem OnClick="Logout" Style="color: #FF5252;">Logout</MudMenuItem>
                        </AuthorizeView>

                        <AuthorizeView Roles="Empleado, Admin">
                            @if (context.User.IsInRole("Admin"))
                            {
                                <MudMenuItem OnClick="@(() => Nav.NavigateTo("/admin"))">Panel de Control</MudMenuItem>
                            }
                            <MudMenuItem OnClick="AbrirAgregarBebida">Agregar Bebida</MudMenuItem>
                            <MudMenuItem>Servicios</MudMenuItem>
                            <MudMenuItem>Carrito</MudMenuItem>
                            <MudDivider Dense="true" Style="background: rgba(255,255,255,0.1);" />
                            <MudMenuItem OnClick="Logout" Style="color: #FF5252;">Logout</MudMenuItem>
                        </AuthorizeView>
                    </ChildContent>
                </MudMenu>
            </MudHidden>


            <MudHidden Breakpoint="Breakpoint.SmAndDown">

                <AuthorizeView>
                    <NotAuthorized>
                        <MudButton Variant="Variant.Text" Class="btn-licol-text">Servicios</MudButton>
                        <MudButton Variant="Variant.Text" Class="btn-licol-text" OnClick="@(() => Nav.NavigateTo("/login"))">Login</MudButton>
                        <MudButton Variant="Variant.Filled" Class="btn-licol-highlight" OnClick="@(() => Nav.NavigateTo("/register"))">Registrarse</MudButton>
                    </NotAuthorized>
                </AuthorizeView>

                <AuthorizeView Roles="Cliente">
                    <MudButton Variant="Variant.Text" Class="btn-licol-text">Servicios</MudButton>
                    <MudButton Variant="Variant.Text" Class="btn-licol-text" StartIcon="@Icons.Material.Filled.ShoppingCart">Carrito</MudButton>
                    <MudButton Variant="Variant.Text" Class="btn-licol-logout-text" OnClick="Logout">Cierre de Sesión</MudButton>
                </AuthorizeView>

                <AuthorizeView Roles="Empleado">
                    <MudButton Variant="Variant.Filled" Class="btn-licol-highlight" StartIcon="@Icons.Material.Filled.Add" OnClick="AbrirAgregarBebida">Agregar Bebida</MudButton>
                    <MudButton Variant="Variant.Text" Class="btn-licol-text">Servicios</MudButton>
                    <MudButton Variant="Variant.Text" Class="btn-licol-text" StartIcon="@Icons.Material.Filled.ShoppingCart">Carrito</MudButton>
                    <MudButton Variant="Variant.Text" Class="btn-licol-logout-text" OnClick="Logout">Cierre de Sesión</MudButton>
                </AuthorizeView>

                <AuthorizeView Roles="Admin">
                    <MudButton Variant="Variant.Filled" Class="btn-licol-highlight" StartIcon="@Icons.Material.Filled.Add" OnClick="AbrirAgregarBebida">Agregar Bebida</MudButton>

                    <MudButton Variant="Variant.Text" Class="btn-licol-text" StartIcon="@Icons.Material.Filled.Settings" OnClick="@(() => Nav.NavigateTo("/admin"))">Panel</MudButton>

                    <MudButton Variant="Variant.Text" Class="btn-licol-text">Servicios</MudButton>

                    <MudButton Variant="Variant.Text" Class="btn-licol-text" StartIcon="@Icons.Material.Filled.ShoppingCart">Carrito</MudButton>

                    <MudButton Variant="Variant.Text" Class="btn-licol-logout-text" OnClick="Logout">Cierre de Sesión</MudButton>
                </AuthorizeView>

            </MudHidden>

        </div>
    </div>
</MudAppBar>

@code {
    void AbrirAgregarBebida()
    {
        DialogService.Show<ProductDialog>("Agregar Bebida");
    }

    private async Task Logout()
    {
        if (AuthStateProvider is CustomAuthStateProvider custom)
        {
            await custom.Logout();
        }
        Nav.NavigateTo("/", forceLoad: true);
    }
}