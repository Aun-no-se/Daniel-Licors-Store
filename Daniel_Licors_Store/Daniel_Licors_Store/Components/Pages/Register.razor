@page "/register"
@using Daniel_Licors_Store.Models.Users.Auth
@using Daniel_Licors_Store.Services.Auth
@using MudBlazor

<div class="rg-page">
    <div class="rg-card">

        <!-- ── Banner ── -->
        <div class="rg-banner">
            <div class="rg-banner-grid"></div>

            <div class="rg-logo-ring">
                <span class="rg-logo-icon">🍷</span>
            </div>

            <div class="rg-banner-title">Daniel Liquor Store</div>
            <div class="rg-banner-sub">Crea tu cuenta para empezar</div>
        </div>

        <!-- ── Form ── -->
        <div class="rg-form">

            <!-- SECCIÓN: Datos personales -->
            <div class="rg-section">👤 Datos personales</div>

            <div class="rg-row rg-col2">
                <MudTextField @bind-Value="model.Name"
                              Label="Nombre *"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              Disabled="@isLoading"
                              FullWidth />

                <MudTextField @bind-Value="model.LastName"
                              Label="Apellido *"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              Disabled="@isLoading"
                              FullWidth />
            </div>

            <div class="rg-row rg-col2">
                <MudTextField @bind-Value="model.Email"
                              Label="Correo electrónico *"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              Immediate="true"
                              Disabled="@isLoading"
                              FullWidth />

                <MudTextField T="int"
                              @bind-Value="model.Age"
                              Label="Edad *"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              Disabled="@isLoading"
                              Adornment="Adornment.End"
                              AdornmentText="años"
                              HelperText="Mín. 18"
                              FullWidth />
            </div>

            <!-- SECCIÓN: Contraseña -->
            <div class="rg-section" style="margin-top:6px">🔒 Contraseña</div>

            <div class="rg-row rg-col1">
                <div>
                    <MudTextField T="string"
                                  Value="@model.Password"
                                  ValueChanged="@OnPasswordChanged"
                                  Label="Contraseña *"
                                  Variant="Variant.Outlined"
                                  InputType="@(_showPass ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPass ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                  OnAdornmentClick="@ToggleShowPass"
                                  Immediate="true"
                                  Disabled="@isLoading"
                                  FullWidth />

                    <!-- Segmentos de fortaleza -->
                    @if (!string.IsNullOrEmpty(model.Password))
                    {
                        <div class="rg-strength-wrap">
                            <div class="rg-strength-segments">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    int seg = i;
                                    <div class="rg-seg"
                                         style="background: @(seg <= StrengthScore ? StrengthColor : "rgba(255,255,255,0.08)")"></div>
                                }
                            </div>
                            <div class="rg-strength-label" style="color:@StrengthColor">
                                @StrengthLabel
                            </div>
                        </div>
                    }
                </div>

                <MudTextField T="string"
                              Value="@model.ConfirmPassword"
                              ValueChanged="@OnConfirmChanged"
                              Label="Confirmar contraseña *"
                              Variant="Variant.Outlined"
                              InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="@ToggleShowConfirm"
                              Immediate="true"
                              Disabled="@isLoading"
                              FullWidth />
            </div>

            <div class="rg-divider"></div>

            <!-- Botón -->
            <MudButton Class="rg-btn"
                       OnClick="HandleRegister"
                       Disabled="@isLoading">
                @if (isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Creando cuenta...</span>
                }
                else
                {
                    <span>Crear cuenta →</span>
                }
            </MudButton>

            <!-- Feedback -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="rg-error">
                    <span style="flex-shrink:0">⚠️</span>
                    <span>@errorMessage</span>
                </div>
            }

            @if (success)
            {
                <div class="rg-success">
                    <span>✅</span>
                    <span>¡Cuenta creada! Redirigiendo al login...</span>
                </div>
            }

            <div class="rg-footer">
                ¿Ya tienes cuenta?
                <a href="/login">Inicia sesión aquí</a>
            </div>

        </div>
    </div>
</div>
