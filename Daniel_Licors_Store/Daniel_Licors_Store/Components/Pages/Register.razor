@page "/register"
@inject IAuthService AuthService
@inject NavigationManager Nav
@using Daniel_Licors_Store.Models.Users.Auth
@using Daniel_Licors_Store.Services.Auth
@using MudBlazor

<div class="d-flex align-center justify-center signup-login-wrapper" style="min-height: 100vh; width: 100%;">
    <MudContainer MaxWidth="MaxWidth.Small" Class="my-auto">

        <MudPaper Elevation="4" Class="overflow-hidden rounded-xl backend-card-custom">

            <!-- Banner -->
            <div class="login-banner-premium d-flex flex-column align-center justify-center py-6 text-center">
                <MudIcon Icon="@Icons.Material.Filled.LocalBar" Size="Size.Large" Color="Color.Surface" Class="mb-2 logo-animate" />
                <MudText Typo="Typo.h5" Class="font-weight-black text-white uppercase tracking-wider">
                    Daniel Liquor Store
                </MudText>
                <MudText Typo="Typo.caption" Class="text-white-50 px-4">
                    Únete a nuestra plataforma de gestión
                </MudText>
            </div>

            <!-- Formulario -->
            <div class="pa-8">

                <MudText Typo="Typo.h5" Class="font-weight-bold mb-6 text-center dark-text-highlight">
                    Crear Cuenta
                </MudText>

                <MudTextField @bind-Value="model.Name"
                              Label="Nombre"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Person"
                              AdornmentColor="Color.Primary"
                              FullWidth
                              Disabled="@isLoading"
                              Class="mb-4" />

                <MudTextField @bind-Value="model.LastName"
                              Label="Apellido"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.PersonOutline"
                              AdornmentColor="Color.Primary"
                              FullWidth
                              Disabled="@isLoading"
                              Class="mb-4" />

                <MudTextField @bind-Value="model.Age"
                              Label="Edad (mínimo 18)"
                              Variant="Variant.Outlined"
                              InputType="InputType.Number"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Cake"
                              AdornmentColor="Color.Primary"
                              FullWidth
                              Disabled="@isLoading"
                              Class="mb-4" />

                <MudTextField @bind-Value="model.Email"
                              Label="Correo Electrónico"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              AdornmentColor="Color.Primary"
                              FullWidth
                              Disabled="@isLoading"
                              Class="mb-4" />

                <MudTextField @bind-Value="model.Password"
                              Label="Contraseña"
                              HelperText="Mín. 8 caracteres, una mayúscula y un número"
                              Variant="Variant.Outlined"
                              InputType="@_passwordInput"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordInputIcon"
                              AdornmentColor="Color.Primary"
                              OnAdornmentClick="TogglePasswordVisibility"
                              FullWidth
                              Disabled="@isLoading"
                              Class="mb-4" />

                <MudTextField @bind-Value="model.ConfirmPassword"
                              Label="Confirmar Contraseña"
                              Variant="Variant.Outlined"
                              InputType="@_confirmPasswordInput"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_confirmPasswordInputIcon"
                              AdornmentColor="Color.Primary"
                              OnAdornmentClick="ToggleConfirmPasswordVisibility"
                              FullWidth
                              Disabled="@isLoading"
                              Class="mb-6" />

                <MudButton OnClick="HandleRegister"
                           Color="Color.Error"
                           Variant="Variant.Filled"
                           Size="Size.Large"
                           FullWidth
                           Disabled="@isLoading"
                           Class="py-3 btn-login-submit font-weight-bold text-transform-none">
                    @if (isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Registrando...</span>
                    }
                    else
                    {
                        <span>Registrarse</span>
                    }
                </MudButton>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <MudAlert Severity="Severity.Error"
                              Variant="Variant.Outlined"
                              Dense="true"
                              Class="mt-4 rounded-lg">
                        @errorMessage
                    </MudAlert>
                }

                @if (success)
                {
                    <MudAlert Severity="Severity.Success"
                              Variant="Variant.Outlined"
                              Dense="true"
                              Class="mt-4 rounded-lg">
                        ¡Cuenta creada exitosamente! Redirigiendo al login...
                    </MudAlert>
                }

                <div class="text-center mt-4">
                    <MudLink Href="/login" Color="Color.Primary" Underline="Underline.Hover" Class="text-sm">
                        ¿Ya tienes cuenta? Inicia sesión aquí
                    </MudLink>
                </div>

            </div>
        </MudPaper>
    </MudContainer>
</div>

@code {
    private RegisterModel model = new();
    private string? errorMessage;
    private bool isLoading;
    private bool success;

    private bool _passwordVisibility;
    private InputType _passwordInput = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    private bool _confirmPasswordVisibility;
    private InputType _confirmPasswordInput = InputType.Password;
    private string _confirmPasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    private void TogglePasswordVisibility()
    {
        _passwordVisibility = !_passwordVisibility;
        _passwordInput = _passwordVisibility ? InputType.Text : InputType.Password;
        _passwordInputIcon = _passwordVisibility
            ? Icons.Material.Filled.Visibility
            : Icons.Material.Filled.VisibilityOff;
    }

    private void ToggleConfirmPasswordVisibility()
    {
        _confirmPasswordVisibility = !_confirmPasswordVisibility;
        _confirmPasswordInput = _confirmPasswordVisibility ? InputType.Text : InputType.Password;
        _confirmPasswordInputIcon = _confirmPasswordVisibility
            ? Icons.Material.Filled.Visibility
            : Icons.Material.Filled.VisibilityOff;
    }

    private async Task HandleRegister()
    {
        // Validaciones rápidas del lado cliente antes de ir al servicio
        if (string.IsNullOrWhiteSpace(model.Name) || string.IsNullOrWhiteSpace(model.LastName))
        {
            errorMessage = "Nombre y apellido son requeridos.";
            return;
        }

        if (model.Age < 18)
        {
            errorMessage = "Debes tener al menos 18 años para registrarte.";
            return;
        }

        if (string.IsNullOrWhiteSpace(model.Email))
        {
            errorMessage = "El correo electrónico es requerido.";
            return;
        }

        if (string.IsNullOrWhiteSpace(model.Password))
        {
            errorMessage = "La contraseña es requerida.";
            return;
        }

        if (model.Password != model.ConfirmPassword)
        {
            errorMessage = "Las contraseñas no coinciden.";
            return;
        }

        errorMessage = null;
        isLoading = true;

        try
        {
            await AuthService.RegisterAsync(model);
            success = true;
            StateHasChanged();

            // Pequeña pausa para que el usuario vea el mensaje de éxito
            await Task.Delay(1500);
            Nav.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
