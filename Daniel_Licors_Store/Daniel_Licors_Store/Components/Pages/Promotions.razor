@page "/admin/promociones"
@inherits AdminPageBase
@using Microsoft.AspNetCore.Components.Forms
@using Daniel_Licors_Store.Models.Promotion
@using Daniel_Licors_Store.Models.Product
@using MudBlazor

<div class="promo-page-bg">
    <div class="promo-glow promo-glow-crimson"></div>
    <div class="promo-glow promo-glow-gold"></div>

    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pr-page">

        <!-- ── HEADER ─────────────────────────────────────────────────── -->
        <div class="pr-header">
            <div class="pr-header-left">
                <div class="pr-header-icon">
                    <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Class="pr-header-icon-svg" />
                </div>
                <div>
                    <p class="pr-page-title">Promociones</p>
                    <p class="pr-page-sub">Ofertas especiales de descuento y precios especiales</p>
                </div>
            </div>
            <MudButton Class="pr-btn-new"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="ShowCreateSection">
                Nueva Promoción
            </MudButton>
        </div>

        <!-- ── LOADING ────────────────────────────────────────────────── -->
        @if (_loading)
        {
            <div class="pr-loading">
                <MudProgressCircular Indeterminate Size="Size.Large" Color="Color.Error" />
                <span>Cargando promociones...</span>
            </div>
        }
        else if (!_promos.Any())
        {
            <div class="pr-empty">
                <div class="pr-empty-icon-ring">
                    <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Class="pr-empty-icon" />
                </div>
                <p class="pr-empty-title">Sin promociones aún</p>
                <p class="pr-empty-sub">Crea tu primera promoción para empezar a ofrecer ofertas especiales.</p>
                <MudButton Class="pr-btn-new mt-3" OnClick="ShowCreateSection">Crear promoción</MudButton>
            </div>
        }
        else
        {
            <!-- ── TABLA ──────────────────────────────────────────────── -->
            <div class="pr-table-wrap">
                <div class="pr-table-scroll">
                    <table class="pr-table">
                        <thead>
                            <tr>
                                <th>Imagen</th>
                                <th>Título</th>
                                <th>Tipo</th>
                                <th>Productos</th>
                                <th>Inicio</th>
                                <th>Fin</th>
                                <th>Estado</th>
                                <th>Vigente</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var promo in _promos)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(promo.ImageUrl))
                                        {
                                            <img src="@promo.ImageUrl" class="pr-thumb" alt="@promo.Title" />
                                        }
                                        else
                                        {
                                            <div class="pr-thumb-placeholder">
                                                <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" />
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="pr-title-cell">@promo.Title</div>
                                        @if (!string.IsNullOrEmpty(promo.Description))
                                        {
                                            <div class="muted-text desc-clamp">@promo.Description</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="pr-type-chip @GetTypeChipClass(promo.PromotionType)">
                                            @GetTypeLabel(promo.PromotionType)
                                        </span>
                                    </td>
                                    <td class="pr-products-cell">
                                        @promo.ProductCount producto(s)<br />
                                        <span class="muted-text">@promo.ProductsSummary</span>
                                    </td>
                                    <td class="pr-date-cell">@FormatDate(promo.StartDate)</td>
                                    <td class="pr-date-cell">@FormatDate(promo.EndDate)</td>
                                    <td>
                                        <span class="pr-type-chip @(promo.IsActive ? "pr-chip-active" : "pr-chip-inactive")">
                                            @(promo.IsActive ? "Activa" : "Inactiva")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="pr-vigente-dot @(promo.IsVigente ? "" : "off")">
                                            @(promo.IsVigente ? "Vigente" : "No vigente")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="pr-actions">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Color="Color.Warning" Size="Size.Small"
                                                           Class="pr-action-btn"
                                                           Title="Editar"
                                                           OnClick="@(() => EditPromo(promo.PromotionId))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                           Color="Color.Error" Size="Size.Small"
                                                           Class="pr-action-btn"
                                                           Title="Eliminar"
                                                           OnClick="@(() => DeletePromo(promo.PromotionId))" />
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- ══ ANCLA DE SCROLL ═══════════════════════════════════════ -->
        <div id="promo-form-anchor" style="height:0"></div>

        <!-- ══ FORMULARIO GLASSMORPHISM ══════════════════════════════ -->
        @if (_showForm)
        {
            <div class="pr-form-wrap">

                <!-- Header -->
                <div class="pr-form-header">
                    <div class="pr-form-header-row">
                        <div class="d-flex align-center gap-2">
                            <div class="pr-form-accent"></div>
                            <div>
                                <p class="pr-form-title">@(_isEditMode ? "Editar Promoción" : "Nueva Promoción")</p>
                                <p class="pr-form-subtitle">
                                    @(_isEditMode ? $"Modificando ID #{_editingPromoId}" : "Completa los datos de la nueva promoción")
                                </p>
                            </div>
                        </div>
                        <span class="pr-form-badge @(_isEditMode ? "pr-badge-edit" : "pr-badge-new")">
                            @(_isEditMode ? "EDITAR" : "NUEVA")
                        </span>
                    </div>
                </div>

                <!-- Body -->
                <div class="pr-form-body">

                    <!-- Imagen -->
                    <p class="pr-section-label">
                        <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" Class="pr-section-icon" /> Imagen de la promoción
                    </p>

                    <InputFile id="promo-img-input" OnChange="HandleImageUpload" accept="image/*" style="display:none" />
                    <label for="promo-img-input" class="pr-img-label">
                        <div class="pr-img-zone @(HasPromoImage ? "has-image" : "")">
                            @if (HasPromoImage)
                            {
                                <img src="@(_previewBase64 ?? _form.ImageUrl)" alt="Preview" />
                                <div class="pr-img-overlay">
                                    <span class="pr-overlay-btn">
                                        <MudIcon Icon="@Icons.Material.Filled.Autorenew" Size="Size.Small" Class="mr-1" /> Cambiar
                                    </span>
                                    <span class="pr-overlay-btn" @onclick:stopPropagation @onclick="RemoveImage">
                                        <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Class="mr-1" /> Quitar
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="pr-img-placeholder">
                                    <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Class="pr-img-icon" />
                                    <div class="pr-img-text">Toca aquí para subir imagen</div>
                                    <div class="pr-img-sub">PNG, JPG, WEBP · máx 5 MB</div>
                                </div>
                            }
                        </div>
                    </label>
                    @if (_uploadingImage)
                    {
                        <div class="pr-uploading-row">
                            <MudProgressCircular Size="Size.Small" Indeterminate Color="Color.Error" /> Subiendo...
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_uploadError))
                    {
                        <div class="pr-upload-error">@_uploadError</div>
                    }

                    <!-- Info básica -->
                    <p class="pr-section-label">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="pr-section-icon" /> Información básica
                    </p>
                    <div class="pr-field-grid cols-1">
                        <MudTextField @bind-Value="_form.Title"
                                      Label="Título de la promoción"
                                      Variant="Variant.Outlined"
                                      Placeholder="Ej: Día de las Madres — 5% en Rones" />
                    </div>
                    <div class="pr-field-grid cols-2">
                        <div class="pr-select-field">
                            <label class="pr-select-label">Tipo de promoción</label>
                            <select class="pr-native-select"
                                    value="@_form.PromotionType"
                                    @onchange="@(e => _form.PromotionType = e.Value?.ToString() ?? "Discount")">
                                <option value="Discount">% Descuento</option>
                                <option value="SpecialPrice">Precio Especial</option>
                                <option value="PayXGetY">Lleva X Paga Y</option>
                            </select>
                        </div>

                        <div class="pr-active-toggle @(_form.IsActive ? "on" : "off")"
                             @onclick="() => _form.IsActive = !_form.IsActive">
                            <div class="pr-toggle-dot @(_form.IsActive ? "on" : "off")"></div>
                            <div>
                                <div class="pr-toggle-title">Estado</div>
                                <div class="pr-toggle-sub">@(_form.IsActive ? "Activa" : "Inactiva")</div>
                            </div>
                        </div>
                    </div>
                    <div class="pr-field-grid cols-1">
                        <MudTextField @bind-Value="_form.Description"
                                      Label="Descripción (opcional)"
                                      Lines="2"
                                      Variant="Variant.Outlined"
                                      Placeholder="Breve descripción visible al cliente" />
                    </div>

                    <!-- Fechas — inputs nativos (evita bug removeChild en móvil) -->
                    <p class="pr-section-label">
                        <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Small" Class="pr-section-icon" /> Vigencia
                    </p>
                    <div class="pr-field-grid cols-2">
                        <div class="pr-date-field">
                            <label class="pr-date-label">Fecha inicio</label>
                            <input type="date" class="pr-date-input"
                                   value="@_startDateStr"
                                   @onchange="@(e => _startDateStr = e.Value?.ToString() ?? _startDateStr)" />
                        </div>
                        <div class="pr-date-field">
                            <label class="pr-date-label">Fecha fin</label>
                            <input type="date" class="pr-date-input"
                                   value="@_endDateStr"
                                   @onchange="@(e => _endDateStr = e.Value?.ToString() ?? _endDateStr)" />
                        </div>
                    </div>

                    <!-- Selector de productos -->
                    <p class="pr-section-label">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small" Class="pr-section-icon" /> Productos en esta promoción
                    </p>

                    <div class="pr-picker-wrap mb-3">
                        <MudTable Items="_products" Dense Hover Bordered Class="products-picker-table">
                            <HeaderContent>
                                <MudTh>Producto</MudTh>
                                <MudTh>Precio</MudTh>
                                <MudTh Align="Align.Center">Agregar</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold pr-picker-name">@context.Name</MudText>
                                </MudTd>
                                <MudTd>
                                    <MudText Class="font-weight-bold pr-picker-price">$@context.Price.ToString("N2")</MudText>
                                </MudTd>
                                <MudTd Align="Align.Center">
                                    <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                                   Color="Color.Error"
                                                   OnClick="@(() => OpenPromoLineDialog(context))" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>

                    @if (_promoBuilder.Any())
                    {
                        <div class="pr-included-label">Incluidos en la promoción:</div>
                        <div class="pr-chips-wrap">
                            @foreach (var line in _promoBuilder)
                            {
                                <MudChip T="PromotionProductLine"
                                         Value="@line"
                                         Closeable="true"
                                         Color="Color.Error"
                                         Class="pr-included-chip"
                                         OnClose="@(() => _promoBuilder.Remove(line))">
                                    @GetLineLabel(line)
                                </MudChip>
                            }
                        </div>
                    }

                </div><!-- /pr-form-body -->
                <!-- Footer -->
                <div class="pr-form-footer">
                    <MudButton Class="pr-cancel-btn" OnClick="ResetForm">Cancelar</MudButton>
                    <MudButton Class="pr-save-btn"
                               Disabled="@(!_promoBuilder.Any())"
                               StartIcon="@Icons.Material.Filled.Check"
                               OnClick="SavePromo">
                        @(_isEditMode ? "Actualizar Promoción" : "Guardar Promoción")
                    </MudButton>
                </div>

            </div>
        }

        <!-- ── Mini-dialog línea de producto ──────────────────────────── -->
        @if (_showLineDialog && _lineDialogProduct != null)
        {
            <div class="pr-linedialog-backdrop" @onclick="CloseLineDialog">
                <div class="pr-linedialog-card" @onclick:stopPropagation>

                    <div class="pr-linedialog-title">@_lineDialogProduct.Name</div>
                    <div class="muted-text pr-linedialog-sub">
                        Precio normal: $@_lineDialogProduct.Price.ToString("N2")
                    </div>
                    <div class="pr-linedialog-hr"></div>

                    @if (_form.PromotionType == "Discount")
                    {
                        <MudNumericField @bind-Value="_lineDiscountPct" T="decimal"
                                         Label="Descuento (%)" Min="0.01m" Max="99.99m"
                                         Variant="Variant.Outlined"
                                         Adornment="Adornment.End" AdornmentText="%" />
                        @if (_lineDiscountPct > 0)
                        {
                            var res = _lineDialogProduct.Price * (1 - _lineDiscountPct / 100);
                            <div class="text-success-custom pr-linedialog-result">
                                Precio resultante: $@res.ToString("N2")
                            </div>
                        }
                    }
                    else if (_form.PromotionType == "SpecialPrice")
                    {
                        <MudNumericField @bind-Value="_lineSpecialPrice" T="decimal"
                                         Label="Precio especial ($)" Min="0.01m"
                                         Variant="Variant.Outlined"
                                         Adornment="Adornment.Start" AdornmentText="$" />
                    }
                    else if (_form.PromotionType == "PayXGetY")
                    {
                        <div class="pr-field-grid cols-2 pr-linedialog-pxgy">
                            <MudNumericField @bind-Value="_lineReqQty" T="int"
                                             Label="Lleva (qty)" Min="2"
                                             Variant="Variant.Outlined" />
                            <MudNumericField @bind-Value="_linePayQty" T="int"
                                             Label="Paga (qty)" Min="1"
                                             Variant="Variant.Outlined" />
                        </div>
                        <div class="text-success-custom">
                            Ejemplo: Lleva @_lineReqQty, paga @_linePayQty
                        </div>
                    }

                    <div class="pr-linedialog-actions">
                        <MudButton Color="Color.Default" Variant="Variant.Outlined" OnClick="CloseLineDialog">Cancelar</MudButton>
                        <MudButton Class="pr-save-btn" OnClick="ConfirmLineDialog">Agregar</MudButton>
                    </div>

                </div>
            </div>
        }

    </MudContainer>
</div>
