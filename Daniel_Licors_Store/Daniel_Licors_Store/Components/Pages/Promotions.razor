@page "/admin/promociones"
@attribute [Authorize(Roles = "Admin,Empleado")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Daniel_Licors_Store.Models.Promotion
@using Daniel_Licors_Store.Models.Product
@using MudBlazor

<style>
    /* ── Variables ─────────────────────────────────────────────── */
    :root {
        --pr-red: #FF1744;
        --pr-red-dim: rgba(255,23,68,0.14);
        --pr-red-border: rgba(255,23,68,0.28);
        --pr-bg: rgba(10,10,10,0.97);
        --pr-surface: rgba(255,255,255,0.035);
        --pr-border: rgba(255,255,255,0.08);
    }

    /* ── Page ───────────────────────────────────────────────────── */
    .pr-page {
        padding: 1.25rem 1rem 4rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* ── Header ─────────────────────────────────────────────────── */
    .pr-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .85rem;
        margin-bottom: 1.75rem;
    }

    .pr-header-left {
        display: flex;
        align-items: center;
        gap: .75rem;
    }

    .pr-header-accent {
        width: 4px;
        height: 34px;
        border-radius: 4px;
        background: linear-gradient(180deg, var(--pr-red), #7a0010);
        box-shadow: 0 0 12px rgba(255,23,68,.45);
    }

    .pr-page-title {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: #fff;
    }

    .pr-page-sub {
        margin: 0;
        font-size: .78rem;
        color: rgba(255,255,255,.4);
    }

    .pr-btn-new {
        background: linear-gradient(135deg, var(--pr-red), #b71c1c) !important;
        color: #fff !important;
        border-radius: 10px !important;
        text-transform: none !important;
        font-weight: 700 !important;
        padding: 0 22px !important;
        height: 40px !important;
        box-shadow: 0 4px 16px rgba(255,23,68,.3) !important;
    }

        .pr-btn-new:hover {
            filter: brightness(1.1) !important;
            transform: translateY(-1px) !important;
        }

    /* ── Tabla de promociones ───────────────────────────────────── */
    .pr-table-wrap {
        background: rgba(255,255,255,0.025);
        border: 1px solid var(--pr-border);
        border-radius: 14px;
        overflow: hidden;
    }

    .pr-table {
        width: 100%;
        border-collapse: collapse;
    }

        .pr-table thead tr {
            background: rgba(255,23,68,0.07);
            border-bottom: 1px solid var(--pr-red-border);
        }

        .pr-table th {
            padding: .65rem 1rem;
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: 1.1px;
            text-transform: uppercase;
            color: rgba(255,23,68,.85);
            text-align: left;
        }

        .pr-table td {
            padding: .7rem 1rem;
            font-size: .82rem;
            color: rgba(255,255,255,.82);
            border-bottom: 1px solid rgba(255,255,255,.05);
            vertical-align: middle;
        }

        .pr-table tbody tr:last-child td {
            border-bottom: none;
        }

        .pr-table tbody tr:hover td {
            background: rgba(255,255,255,.03);
        }

    .pr-thumb {
        width: 44px;
        height: 44px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid var(--pr-border);
    }

    .pr-thumb-placeholder {
        width: 44px;
        height: 44px;
        border-radius: 8px;
        background: rgba(255,23,68,.08);
        border: 1px dashed var(--pr-red-border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .pr-type-chip {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 20px;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .5px;
    }

    .pr-chip-discount {
        background: rgba(255,23,68,.15);
        color: #ff6b6b;
    }

    .pr-chip-specialprice {
        background: rgba(255,193,7,.12);
        color: #ffc107;
    }

    .pr-chip-payxgety {
        background: rgba(76,175,80,.12);
        color: #66bb6a;
    }

    .pr-chip-other {
        background: rgba(33,150,243,.12);
        color: #64b5f6;
    }

    .pr-vigente-dot {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: .75rem;
    }

        .pr-vigente-dot::before {
            content: '';
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #4caf50;
            box-shadow: 0 0 6px rgba(76,175,80,.6);
        }

        .pr-vigente-dot.off::before {
            background: #555;
            box-shadow: none;
        }

    .pr-actions {
        display: flex;
        gap: .25rem;
    }

    /* ── Empty state ─────────────────────────────────────────────── */
    .pr-empty {
        text-align: center;
        padding: 4rem 1rem;
        color: rgba(255,255,255,.3);
    }

    .pr-empty-icon {
        font-size: 3rem !important;
        margin-bottom: .75rem;
    }

    /* ═══════════════════════════════════════════════════════════════
       FORMULARIO — mismo estilo dark glassmorphism que ProductDialog
       ══════════════════════════════════════════════════════════════ */
    .pr-form-wrap {
        margin-top: 2rem;
        background: rgba(10,10,10,.96);
        border: 1px solid var(--pr-red-border);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 32px 80px rgba(0,0,0,.8), 0 0 0 1px rgba(255,255,255,.04);
        animation: pr-slide-up .35s cubic-bezier(.22,1,.36,1);
    }

    @@keyframes pr-slide-up {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Header del form */
    .pr-form-header {
        padding: 20px 24px 16px;
        background: linear-gradient(135deg,#1a0000 0%,#0d0d0d 60%);
        border-bottom: 1px solid var(--pr-red-border);
        position: relative;
        overflow: hidden;
    }

        .pr-form-header::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 0% 50%, rgba(255,23,68,.12) 0%, transparent 70%);
            pointer-events: none;
        }

    .pr-form-header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .pr-form-accent {
        width: 4px;
        height: 26px;
        border-radius: 4px;
        flex-shrink: 0;
        background: linear-gradient(180deg,#FF1744,#B71C1C);
        box-shadow: 0 0 12px rgba(255,23,68,.5);
    }

    .pr-form-title {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 700;
        color: #fff;
    }

    .pr-form-subtitle {
        margin: 0;
        font-size: .72rem;
        color: rgba(255,255,255,.4);
        margin-top: 2px;
    }

    .pr-form-badge {
        font-size: .62rem;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        padding: 3px 10px;
        border-radius: 20px;
        border: 1px solid;
    }

    .pr-badge-new {
        color: #4caf50;
        border-color: rgba(76,175,80,.4);
        background: rgba(76,175,80,.08);
    }

    .pr-badge-edit {
        color: #FF8A80;
        border-color: rgba(255,138,128,.4);
        background: rgba(255,138,128,.08);
    }

    /* Body del form */
    .pr-form-body {
        padding: 22px 22px 10px;
    }

    /* Section labels */
    .pr-section-label {
        font-size: .67rem;
        font-weight: 700;
        letter-spacing: 1.4px;
        text-transform: uppercase;
        color: rgba(255,23,68,.85);
        margin: 18px 0 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .pr-section-label::after {
            content: '';
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg,rgba(255,23,68,.2),transparent);
        }

    /* Grid de campos */
    .pr-field-grid {
        display: grid;
        gap: 14px;
        margin-bottom: 14px;
    }

        .pr-field-grid.cols-2 {
            grid-template-columns: 1fr 1fr;
        }

        .pr-field-grid.cols-3 {
            grid-template-columns: 1fr 1fr 1fr;
        }

        .pr-field-grid.cols-1 {
            grid-template-columns: 1fr;
        }

    @@media (max-width: 600px) {
        .pr-field-grid.cols-2,
        .pr-field-grid.cols-3 {
            grid-template-columns: 1fr;
        }
    }

    /* Input overrides */
    .pr-form-wrap .mud-input-root {
        background: rgba(255,255,255,.035) !important;
        border-radius: 10px !important;
    }

        .pr-form-wrap .mud-input-root:hover {
            background: rgba(255,255,255,.055) !important;
        }

        .pr-form-wrap .mud-input-root.mud-input-root-focused {
            background: rgba(255,23,68,.06) !important;
            box-shadow: 0 0 0 2px rgba(255,23,68,.25) !important;
        }

    /* Date inputs nativos */
    .pr-date-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .pr-date-label {
        font-size: .72rem;
        color: rgba(255,255,255,.55);
        padding-left: 2px;
    }

    .pr-date-input {
        background: rgba(255,255,255,.035);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 10px;
        color: #fff;
        padding: 12px 14px;
        font-size: .88rem;
        width: 100%;
        box-sizing: border-box;
        -webkit-appearance: none;
        color-scheme: dark;
        transition: border-color .2s, box-shadow .2s;
    }

        .pr-date-input:focus {
            outline: none;
            border-color: rgba(255,23,68,.5);
            box-shadow: 0 0 0 2px rgba(255,23,68,.2);
            background: rgba(255,23,68,.05);
        }

    /* Toggle activo */
    .pr-active-toggle {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255,255,255,.03);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 10px;
        padding: 10px 14px;
        cursor: pointer;
        user-select: none;
        transition: all .2s;
    }

        .pr-active-toggle.on {
            background: rgba(76,175,80,.08);
            border-color: rgba(76,175,80,.3);
        }

        .pr-active-toggle.off {
            opacity: .7;
        }

    .pr-toggle-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
        transition: all .2s;
    }

        .pr-toggle-dot.on {
            background: #4caf50;
            box-shadow: 0 0 8px rgba(76,175,80,.5);
        }

        .pr-toggle-dot.off {
            background: rgba(255,255,255,.2);
        }

    /* Zona imagen */
    .pr-img-zone {
        border: 2px dashed rgba(255,23,68,.28);
        border-radius: 14px;
        overflow: hidden;
        min-height: 190px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        background: rgba(255,255,255,.02);
        transition: all .22s;
        position: relative;
    }

        .pr-img-zone:hover, .pr-img-zone.has-image {
            border-style: solid;
            border-color: rgba(255,23,68,.5);
        }

        .pr-img-zone img {
            width: 100%;
            max-height: 220px;
            object-fit: contain;
            display: block;
        }

    .pr-img-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,.55);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        opacity: 0;
        transition: opacity .22s;
        border-radius: 12px;
    }

    .pr-img-zone:hover .pr-img-overlay {
        opacity: 1;
    }

    .pr-overlay-btn {
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 8px;
        color: white;
        font-size: .76rem;
        padding: 7px 13px;
        cursor: pointer;
        backdrop-filter: blur(8px);
        font-weight: 600;
        transition: background .2s;
    }

        .pr-overlay-btn:hover {
            background: rgba(255,23,68,.3);
            border-color: rgba(255,23,68,.5);
        }

    .pr-img-placeholder {
        padding: 24px 14px;
        text-align: center;
    }

    .pr-img-icon {
        font-size: 2.4rem;
        opacity: .3;
        margin-bottom: 6px;
    }

    .pr-img-text {
        font-size: .82rem;
        color: rgba(255,255,255,.5);
    }

    .pr-img-sub {
        font-size: .7rem;
        color: rgba(255,255,255,.28);
        margin-top: 3px;
    }

    /* Tabla de picker de productos */
    .pr-form-wrap .products-picker-table {
        background: rgba(255,255,255,.02) !important;
        border-radius: 10px;
    }

    /* Chips builder */
    .pr-chips-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 16px;
    }

    /* Footer del form */
    .pr-form-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        background: rgba(5,5,5,.9);
        border-top: 1px solid rgba(255,255,255,.06);
        padding: 14px 22px;
    }

    .pr-cancel-btn {
        color: rgba(255,255,255,.4) !important;
        border-radius: 10px !important;
        height: 40px !important;
        padding: 0 16px !important;
        text-transform: none !important;
    }

        .pr-cancel-btn:hover {
            color: rgba(255,255,255,.8) !important;
            background: rgba(255,255,255,.05) !important;
        }

    .pr-save-btn {
        background: linear-gradient(135deg,#FF1744,#B71C1C) !important;
        color: #fff !important;
        font-weight: 700 !important;
        border-radius: 10px !important;
        padding: 0 26px !important;
        height: 40px !important;
        text-transform: none !important;
        box-shadow: 0 4px 16px rgba(255,23,68,.3) !important;
    }

        .pr-save-btn:hover:not(:disabled) {
            filter: brightness(1.1) !important;
            transform: translateY(-1px) !important;
        }

        .pr-save-btn:disabled {
            opacity: .5 !important;
        }

    /* Mini-dialog */
    .pr-linedialog-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.72);
        z-index: 9998;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }

    .pr-linedialog-card {
        background: rgba(18,5,5,.97);
        border: 1px solid var(--pr-red-border);
        border-radius: 16px;
        padding: 24px;
        width: 100%;
        max-width: 380px;
        box-shadow: 0 24px 60px rgba(0,0,0,.8);
        animation: pr-slide-up .28s ease;
    }

    .muted-text {
        color: rgba(255,255,255,.4) !important;
    }

    .text-success-custom {
        color: #66bb6a;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pr-page">

    <!-- ── HEADER ─────────────────────────────────────────────────── -->
    <div class="pr-header">
        <div class="pr-header-left">
            <div class="pr-header-accent"></div>
            <div>
                <p class="pr-page-title">Promociones</p>
                <p class="pr-page-sub">Ofertas especiales de descuento y precios especiales</p>
            </div>
        </div>
        <MudButton Class="pr-btn-new"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="ShowCreateSection">
            Nueva Promoción
        </MudButton>
    </div>

    <!-- ── LOADING ────────────────────────────────────────────────── -->
    @if (_loading)
    {
        <div style="display:flex;flex-direction:column;align-items:center;padding:4rem 0;gap:1rem;color:rgba(255,255,255,.4)">
            <MudProgressCircular Indeterminate Size="Size.Large" Color="Color.Error" />
            <span>Cargando promociones...</span>
        </div>
    }
    else if (!_promos.Any())
    {
        <div class="pr-empty">
            <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Class="pr-empty-icon" />
            <p style="font-size:.95rem;font-weight:600;margin:.5rem 0 .25rem">Sin promociones aún</p>
            <p style="font-size:.8rem;">Crea tu primera promoción para empezar a ofrecer ofertas especiales.</p>
            <MudButton Class="pr-btn-new" Style="margin-top:1rem" OnClick="ShowCreateSection">Crear promoción</MudButton>
        </div>
    }
    else
    {
        <!-- ── TABLA ──────────────────────────────────────────────── -->
        <div class="pr-table-wrap">
            <table class="pr-table">
                <thead>
                    <tr>
                        <th>Imagen</th>
                        <th>Título</th>
                        <th>Tipo</th>
                        <th>Productos</th>
                        <th>Inicio</th>
                        <th>Fin</th>
                        <th>Estado</th>
                        <th>Vigente</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var promo in _promos)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(promo.ImageUrl))
                                {
                                    <img src="@promo.ImageUrl" class="pr-thumb" alt="@promo.Title" />
                                }
                                else
                                {
                                    <div class="pr-thumb-placeholder">🏷️</div>
                                }
                            </td>
                            <td>
                                <div style="font-weight:600;color:#fff">@promo.Title</div>
                                @if (!string.IsNullOrEmpty(promo.Description))
                                {
                                    <div style="font-size:.72rem;color:rgba(255,255,255,.38);margin-top:2px">@promo.Description</div>
                                }
                            </td>
                            <td>
                                <span class="pr-type-chip @GetTypeChipClass(promo.PromotionType)">
                                    @GetTypeLabel(promo.PromotionType)
                                </span>
                            </td>
                            <td style="font-size:.78rem;color:rgba(255,255,255,.6)">
                                @promo.ProductCount producto(s)<br />
                                <span style="font-size:.7rem;color:rgba(255,255,255,.35)">@promo.ProductsSummary</span>
                            </td>
                            <td>@FormatDate(promo.StartDate)</td>
                            <td>@FormatDate(promo.EndDate)</td>
                            <td>
                                <span class="pr-type-chip @(promo.IsActive ? "pr-chip-payxgety" : "pr-chip-other")">
                                    @(promo.IsActive ? "Activa" : "Inactiva")
                                </span>
                            </td>
                            <td>
                                <span class="pr-vigente-dot @(promo.IsVigente ? "" : "off")">
                                    @(promo.IsVigente ? "Vigente" : "No vigente")
                                </span>
                            </td>
                            <td>
                                <div class="pr-actions">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Warning" Size="Size.Small"
                                                   Title="Editar"
                                                   OnClick="@(() => EditPromo(promo.PromotionId))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error" Size="Size.Small"
                                                   Title="Eliminar"
                                                   OnClick="@(() => DeletePromo(promo.PromotionId))" />
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- ══ ANCLA DE SCROLL ═══════════════════════════════════════ -->
    <div id="promo-form-anchor" style="height:0"></div>

    <!-- ══ FORMULARIO GLASSMORPHISM ══════════════════════════════ -->
    @if (_showForm)
    {
        <div class="pr-form-wrap">

            <!-- Header -->
            <div class="pr-form-header">
                <div class="pr-form-header-row">
                    <div style="display:flex;align-items:center;gap:12px">
                        <div class="pr-form-accent"></div>
                        <div>
                            <p class="pr-form-title">@(_isEditMode ? "Editar Promoción" : "Nueva Promoción")</p>
                            <p class="pr-form-subtitle">
                                @(_isEditMode ? $"Modificando ID #{_editingPromoId}" : "Completa los datos de la nueva promoción")
                            </p>
                        </div>
                    </div>
                    <span class="pr-form-badge @(_isEditMode ? "pr-badge-edit" : "pr-badge-new")">
                        @(_isEditMode ? "EDITAR" : "NUEVA")
                    </span>
                </div>
            </div>

            <!-- Body -->
            <div class="pr-form-body">

                <!-- Imagen -->
                <p class="pr-section-label">📷 Imagen de la promoción</p>

                <InputFile id="promo-img-input" OnChange="HandleImageUpload" accept="image/*" style="display:none" />
                <label for="promo-img-input" style="display:block;cursor:pointer">
                    <div class="pr-img-zone @(HasPromoImage ? "has-image" : "")">
                        @if (HasPromoImage)
                        {
                            <img src="@(_previewBase64 ?? _form.ImageUrl)" alt="Preview" />
                            <div class="pr-img-overlay">
                                <span class="pr-overlay-btn">🔄 Cambiar</span>
                                <span class="pr-overlay-btn" @onclick:stopPropagation @onclick="RemoveImage">🗑 Quitar</span>
                            </div>
                        }
                        else
                        {
                            <div class="pr-img-placeholder">
                                <div class="pr-img-icon">🏷️</div>
                                <div class="pr-img-text">Toca aquí para subir imagen</div>
                                <div class="pr-img-sub">PNG, JPG, WEBP · máx 5 MB</div>
                            </div>
                        }
                    </div>
                </label>
                @if (_uploadingImage)
                {
                    <div style="display:flex;align-items:center;gap:8px;margin-top:8px;font-size:.75rem;color:rgba(255,255,255,.45)">
                        <MudProgressCircular Size="Size.Small" Indeterminate Color="Color.Error" /> Subiendo...
                    </div>
                }
                @if (!string.IsNullOrEmpty(_uploadError))
                {
                    <div style="color:#ff6b6b;font-size:.75rem;margin-top:6px">@_uploadError</div>
                }

                <!-- Info básica -->
                <p class="pr-section-label">📋 Información básica</p>
                <div class="pr-field-grid cols-1">
                    <MudTextField @bind-Value="_form.Title"
                                  Label="Título de la promoción"
                                  Variant="Variant.Outlined"
                                  Placeholder="Ej: Día de las Madres — 5% en Rones" />
                </div>
                <div class="pr-field-grid cols-2">
                    <MudSelect @bind-Value="_form.PromotionType"
                               Label="Tipo de promoción"
                               Variant="Variant.Outlined"
                               AnchorOrigin="Origin.BottomCenter"
                               TransformOrigin="Origin.TopCenter">
                        <MudSelectItem @key="@("Discount")" Value="@("Discount")">% Descuento</MudSelectItem>
                        <MudSelectItem @key="@("SpecialPrice")" Value="@("SpecialPrice")">Precio Especial</MudSelectItem>
                        <MudSelectItem @key="@("PayXGetY")" Value="@("PayXGetY")">Lleva X Paga Y</MudSelectItem>
                    </MudSelect>

                    <div class="pr-active-toggle @(_form.IsActive ? "on" : "off")"
                         @onclick="() => _form.IsActive = !_form.IsActive">
                        <div class="pr-toggle-dot @(_form.IsActive ? "on" : "off")"></div>
                        <div>
                            <div style="font-size:.8rem;font-weight:600;color:rgba(255,255,255,.8)">Estado</div>
                            <div style="font-size:.68rem;color:rgba(255,255,255,.38)">@(_form.IsActive ? "Activa" : "Inactiva")</div>
                        </div>
                    </div>
                </div>
                <div class="pr-field-grid cols-1">
                    <MudTextField @bind-Value="_form.Description"
                                  Label="Descripción (opcional)"
                                  Lines="2"
                                  Variant="Variant.Outlined"
                                  Placeholder="Breve descripción visible al cliente" />
                </div>

                <!-- Fechas — inputs nativos (evita bug removeChild en móvil) -->
                <p class="pr-section-label">📅 Vigencia</p>
                <div class="pr-field-grid cols-2">
                    <div class="pr-date-field">
                        <label class="pr-date-label">Fecha inicio</label>
                        <input type="date" class="pr-date-input"
                               value="@_startDateStr"
                               @onchange="@(e => _startDateStr = e.Value?.ToString() ?? _startDateStr)" />
                    </div>
                    <div class="pr-date-field">
                        <label class="pr-date-label">Fecha fin</label>
                        <input type="date" class="pr-date-input"
                               value="@_endDateStr"
                               @onchange="@(e => _endDateStr = e.Value?.ToString() ?? _endDateStr)" />
                    </div>
                </div>

                <!-- Selector de productos -->
                <p class="pr-section-label">🛒 Productos en esta promoción</p>

                <MudTable Items="_products" Dense Hover Bordered Class="mb-3 products-picker-table">
                    <HeaderContent>
                        <MudTh>Producto</MudTh>
                        <MudTh>Precio</MudTh>
                        <MudTh Align="Align.Center">Agregar</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudText Typo="Typo.body2" Class="font-weight-bold">@context.Name</MudText>
                        </MudTd>
                        <MudTd>
                            <MudText Color="Color.Success" Class="font-weight-bold">$@context.Price.ToString("N2")</MudText>
                        </MudTd>
                        <MudTd Align="Align.Center">
                            <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                           Color="Color.Error"
                                           OnClick="@(() => OpenPromoLineDialog(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                @if (_promoBuilder.Any())
                {
                    <div style="font-size:.72rem;color:rgba(255,255,255,.4);margin-bottom:8px">Incluidos en la promoción:</div>
                    <div class="pr-chips-wrap">
                        @foreach (var line in _promoBuilder)
                        {
                            <MudChip T="PromotionProductLine"
                                     Value="@line"
                                     Closeable="true"
                                     Color="Color.Error"
                                     OnClose="@(() => _promoBuilder.Remove(line))">
                                @GetLineLabel(line)
                            </MudChip>
                        }
                    </div>
                }

            </div><!-- /pr-form-body -->
            <!-- Footer -->
            <div class="pr-form-footer">
                <MudButton Class="pr-cancel-btn" OnClick="ResetForm">Cancelar</MudButton>
                <MudButton Class="pr-save-btn"
                           Disabled="@(!_promoBuilder.Any())"
                           OnClick="SavePromo">
                    @(_isEditMode ? "✦ Actualizar Promoción" : "✦ Guardar Promoción")
                </MudButton>
            </div>

        </div>
    }

    <!-- ── Mini-dialog línea de producto ──────────────────────────── -->
    @if (_showLineDialog && _lineDialogProduct != null)
    {
        <div class="pr-linedialog-backdrop" @onclick="CloseLineDialog">
            <div class="pr-linedialog-card" @onclick:stopPropagation>

                <div style="font-weight:700;font-size:1rem;color:#fff;margin-bottom:3px">@_lineDialogProduct.Name</div>
                <div class="muted-text" style="font-size:.75rem;margin-bottom:16px">
                    Precio normal: $@_lineDialogProduct.Price.ToString("N2")
                </div>
                <hr style="border-color:rgba(255,255,255,.08);margin-bottom:16px" />

                @if (_form.PromotionType == "Discount")
                {
                    <MudNumericField @bind-Value="_lineDiscountPct" T="decimal"
                                     Label="Descuento (%)" Min="0.01m" Max="99.99m"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.End" AdornmentText="%" />
                    @if (_lineDiscountPct > 0)
                    {
                        var res = _lineDialogProduct.Price * (1 - _lineDiscountPct / 100);
                        <div class="text-success-custom" style="font-size:.82rem;font-weight:600;margin-top:8px">
                            Precio resultante: $@res.ToString("N2")
                        </div>
                    }
                }
                else if (_form.PromotionType == "SpecialPrice")
                {
                    <MudNumericField @bind-Value="_lineSpecialPrice" T="decimal"
                                     Label="Precio especial ($)" Min="0.01m"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.Start" AdornmentText="$" />
                }
                else if (_form.PromotionType == "PayXGetY")
                {
                    <div class="pr-field-grid cols-2" style="margin-bottom:10px">
                        <MudNumericField @bind-Value="_lineReqQty" T="int"
                                         Label="Lleva (qty)" Min="2"
                                         Variant="Variant.Outlined" />
                        <MudNumericField @bind-Value="_linePayQty" T="int"
                                         Label="Paga (qty)" Min="1"
                                         Variant="Variant.Outlined" />
                    </div>
                    <div class="text-success-custom" style="font-size:.82rem;font-weight:600">
                        Ejemplo: Lleva @_lineReqQty, paga @_linePayQty
                    </div>
                }

                <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:20px">
                    <MudButton Color="Color.Default" Variant="Variant.Outlined" OnClick="CloseLineDialog">Cancelar</MudButton>
                    <MudButton Class="pr-save-btn" OnClick="ConfirmLineDialog">Agregar</MudButton>
                </div>

            </div>
        </div>
    }

</MudContainer>

@code {
    // Helper para la imagen (base64 preview o URL guardada)
    private bool HasPromoImage => !string.IsNullOrEmpty(_previewBase64 ?? _form.ImageUrl);

    private string GetTypeChipClass(string? type) => type switch
    {
        "Discount" => "pr-chip-discount",
        "SpecialPrice" => "pr-chip-specialprice",
        "PayXGetY" => "pr-chip-payxgety",
        _ => "pr-chip-other"
    };
}
