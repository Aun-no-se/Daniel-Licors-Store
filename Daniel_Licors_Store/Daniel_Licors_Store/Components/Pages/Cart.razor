@page "/carrito"
@using Daniel_Licors_Store.Components.Shared
@using Daniel_Licors_Store.Data.Services
@using Daniel_Licors_Store.Models.Cart
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<div class="cart-page-bg">
    <div class="glow-blob glow-blob-crimson"></div>
    <div class="glow-blob glow-blob-gold"></div>

    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-12 cart-page-content">

        <!-- Encabezado -->
        <div class="d-flex align-center mb-6 gap-x-3 cart-header">
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Nav.NavigateTo("/"))"
                       Class="text-transform-none btn-back">
                Volver al catálogo
            </MudButton>
            <div class="cart-title-wrap">
                <MudIcon Icon="@Icons.Material.Filled.ShoppingCartCheckout" Class="cart-title-icon" />
                <MudText Typo="Typo.h4" Class="font-weight-bold cart-title">Mi Carrito</MudText>
            </div>
        </div>

        @if (_loading)
        {
            <div class="d-flex justify-center align-center flex-column my-12 py-12">
                <MudProgressCircular Color="Color.Error" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.body1" Class="mt-4 loading-text">Cargando carrito...</MudText>
            </div>
        }
        else if (_cartView == null || (_cartView.Products.Count == 0 && _cartView.Combos.Count == 0))
        {
            <div class="empty-cart-panel">
                <div class="empty-icon-ring">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="empty-icon" />
                </div>
                <MudText Typo="Typo.h5" Class="font-weight-bold mb-2 empty-title">Carrito vacío</MudText>
                <MudText Typo="Typo.body2" Class="mb-4 empty-sub">No tienes artículos en tu carrito todavía</MudText>
                <MudButton Variant="Variant.Filled"
                           Class="btn-continue-shopping"
                           OnClick="@(() => Nav.NavigateTo("/"))">
                    Continuar comprando
                </MudButton>
            </div>
        }
        else
        {
            <MudGrid Spacing="3">

                <!-- COLUMNA IZQUIERDA -->
                <MudItem xs="12" md="8">

                    <!-- Filtro y búsqueda -->
                    <MudPaper Elevation="0" Class="p-4 mb-4 filter-paper">
                        <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_searchTerm"
                                              @bind-Value:event="oninput"
                                              Placeholder="Buscar por nombre..."
                                              Variant="Variant.Outlined"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                              Size="Size.Small"
                                              Immediate="true"
                                              ValueChanged="@((string v) => { _searchTerm = v; FilterItems(); })"
                                              Class="search-field" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="string"
                                           Value="_filterCategory"
                                           ValueChanged="@((string v) => { _filterCategory = v; FilterItems(); })"
                                           Label="Filtrar por tipo"
                                           Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           AnchorOrigin="Origin.BottomLeft">
                                    <MudSelectItem T="string" Value="@("")">Todos</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("producto")">Productos</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("combo")">Combos</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("promo")">Promociones</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    <!-- Sin resultados -->
                    @if (_filteredProducts.Count == 0 && _filteredCombos.Count == 0 && _filteredPromotions.Count == 0 &&
                                    (!string.IsNullOrEmpty(_searchTerm) || !string.IsNullOrEmpty(_filterCategory)))
                    {
                        <div class="no-results-panel mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Class="no-results-icon mb-3" />
                            <MudText Typo="Typo.h6" Class="font-weight-bold mb-1 no-results-title">Sin resultados</MudText>
                            <MudText Typo="Typo.body2" Class="no-results-sub">
                                @if (_filterCategory == "promo")
                                {
                                    <span>No hay promociones disponibles en tu carrito ahora mismo.</span>
                                }
                                else
                                {
                                    <span>No encontramos artículos con esa búsqueda.</span>
                                }
                            </MudText>
                            <MudButton Variant="Variant.Text" Class="mt-3 btn-clear-filters" OnClick="ClearFilters">
                                Limpiar filtros
                            </MudButton>
                        </div>
                    }

                    <!-- Sección PRODUCTOS -->
                    @if (_filteredProducts.Count > 0)
                    {
                        <div class="section-block mb-6">
                            <div class="section-label mb-3">
                                <span class="label-dot dot-product"></span>
                                <MudIcon Icon="@Icons.Material.Filled.LocalBar" Class="section-icon" />
                                <MudText Typo="Typo.body2" Class="font-weight-bold section-title-text">
                                    PRODUCTOS (@_filteredProducts.Count)
                                </MudText>
                            </div>
                            <div class="item-grid">
                                @foreach (var product in _filteredProducts)
                                {
                                    <div class="pcard @(product.IsSelected ? "pcard-selected" : "")"
                                         @onclick="@(() => UpdateSelection(product.CartItemId, !product.IsSelected, "product"))">

                                        <div class="pcard-img-wrap">
                                            <img src="@product.ProductImage"
                                                 alt="@product.ProductName"
                                                 onerror="this.style.display='none'" />
                                            <div class="pcard-img-placeholder">
                                                <MudIcon Icon="@Icons.Material.Filled.LocalBar" Class="placeholder-icon" />
                                            </div>
                                            <span class="item-badge badge-product">Producto</span>
                                            <div class="pcard-check @(product.IsSelected ? "pcard-check-active" : "")">
                                                @if (product.IsSelected)
                                                {
                                                    @CheckIcon
                                                }
                                            </div>
                                        </div>

                                        <div class="pcard-body">
                                            <div class="pcard-name" title="@product.ProductName">@product.ProductName</div>
                                            <div class="pcard-cat">@product.Category</div>
                                            <div class="pcard-price">$@product.UnitPrice.ToString("N2")</div>
                                            <div class="pcard-subtotal">Sub: $@product.SubTotal.ToString("N2")</div>
                                            <div class="pcard-footer" @onclick:stopPropagation="true">
                                                <div class="qty-mini">
                                                    <button @onclick='() => UpdateQuantity(product.CartItemId, product.Quantity - 1, "product")'>−</button>
                                                    <span>@product.Quantity</span>
                                                    <button @onclick='() => UpdateQuantity(product.CartItemId, product.Quantity + 1, "product")'>+</button>
                                                </div>
                                                <button class="del-mini"
                                                        @onclick="@(() => RemoveItem(product.CartItemId, "product"))"
                                                        @onclick:stopPropagation="true"
                                                        title="Eliminar del carrito">
                                                    @TrashIcon
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Sección PROMOCIONES -->
                    @if (_filteredPromotions.Count > 0)
                    {
                        <div class="section-block mb-6">
                            <div class="section-label mb-3">
                                <span class="label-dot dot-promo"></span>
                                <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Class="section-icon" />
                                <MudText Typo="Typo.body2" Class="font-weight-bold section-title-text">
                                    PROMOCIONES (@_filteredPromotions.Count)
                                </MudText>
                            </div>
                            <div class="item-grid">
                                @foreach (var promo in _filteredPromotions)
                                {
                                    <div class="pcard @(promo.IsSelected ? "pcard-selected" : "")"
                                         @onclick="@(() => UpdateSelection(promo.CartPromotionId, !promo.IsSelected, "promotion"))">

                                        <div class="pcard-img-wrap">
                                            <img src="@promo.PromotionImage" alt="@promo.PromotionName" onerror="this.style.display='none'" />
                                            <div class="pcard-img-placeholder">
                                                <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Class="placeholder-icon" />
                                            </div>
                                            <span class="item-badge badge-promo">Promo</span>
                                            <div class="pcard-check @(promo.IsSelected ? "pcard-check-active" : "")">
                                                @if (promo.IsSelected)
                                                {
                                                    @CheckIcon
                                                }
                                            </div>
                                        </div>

                                        <div class="pcard-body">
                                            <div class="pcard-name" title="@promo.PromotionName">@promo.PromotionName</div>
                                            <div class="pcard-cat">@promo.Category</div>
                                            <div class="pcard-price">$@promo.UnitPrice.ToString("N2")</div>
                                            <div class="pcard-subtotal">Sub: $@promo.SubTotal.ToString("N2")</div>
                                            <div class="pcard-footer" @onclick:stopPropagation="true">
                                                <div class="qty-mini">
                                                    <button @onclick="@(() => UpdateQuantity(promo.CartPromotionId, promo.Quantity - 1, "promotion"))">−</button>
                                                    <span>@promo.Quantity</span>
                                                    <button @onclick="@(() => UpdateQuantity(promo.CartPromotionId, promo.Quantity + 1, "promotion"))">+</button>
                                                </div>
                                                <button class="del-mini"
                                                        @onclick="@(() => RemoveItem(promo.CartPromotionId, "promotion"))"
                                                        @onclick:stopPropagation="true"
                                                        title="Eliminar del carrito">
                                                    @TrashIcon
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Sección COMBOS -->
                    @if (_filteredCombos.Count > 0 && _filterCategory != "promo")
                    {
                        <div class="section-block mb-6">
                            <div class="section-label mb-3">
                                <span class="label-dot dot-combo"></span>
                                <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Class="section-icon" />
                                <MudText Typo="Typo.body2" Class="font-weight-bold section-title-text">
                                    COMBOS (@_filteredCombos.Count)
                                </MudText>
                            </div>
                            <div class="item-grid">
                                @foreach (var combo in _filteredCombos)
                                {
                                    <div class="pcard @(combo.IsSelected ? "pcard-selected" : "")"
                                         @onclick="@(() => UpdateSelection(combo.CartComboId, !combo.IsSelected, "combo"))">
                                        @RenderComboCard(combo)
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Botones de control -->
                    <MudPaper Elevation="0" Class="p-3 control-bar">
                        <div class="d-flex flex-wrap gap-2">
                            <MudButton Variant="Variant.Filled"
                                       Class="btn-select-all"
                                       StartIcon="@Icons.Material.Filled.CheckBox"
                                       Size="Size.Small"
                                       OnClick="SelectAll">
                                Seleccionar todo
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Class="btn-deselect-all"
                                       StartIcon="@Icons.Material.Filled.CheckBoxOutlineBlank"
                                       Size="Size.Small"
                                       OnClick="DeselectAll">
                                Deseleccionar
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Class="btn-clear-cart"
                                       StartIcon="@Icons.Material.Filled.DeleteSweep"
                                       Size="Size.Small"
                                       OnClick="ClearCart">
                                Vaciar carrito
                            </MudButton>
                        </div>
                    </MudPaper>

                </MudItem>

                <!-- COLUMNA DERECHA: Resumen -->
                <MudItem xs="12" md="4">
                    <MudPaper Elevation="0" Class="sticky-summary p-4 rounded-xl">

                        <div class="summary-header mb-4">
                            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Class="summary-header-icon" />
                            <MudText Typo="Typo.h6" Class="font-weight-bold summary-header-text">
                                Resumen de Compra
                            </MudText>
                        </div>

                        <div class="summary-card mb-3">
                            <MudText Typo="Typo.caption" Class="summary-label">
                                Total en carrito
                            </MudText>
                            <div class="d-flex justify-space-between align-center mt-1">
                                <MudText Typo="Typo.h4" Class="font-weight-black summary-value">
                                    @_cartView.TotalProductsCount
                                    <MudText Typo="Typo.caption" Class="summary-value-sub">artículos</MudText>
                                </MudText>
                                <MudText Typo="Typo.h6" Class="font-weight-bold summary-price-gold">
                                    @_cartView.TotalPrice.ToString("C2")
                                </MudText>
                            </div>
                        </div>

                        <div class="summary-card summary-card-selected mb-4">
                            <MudText Typo="Typo.caption" Class="summary-label">
                                Seleccionados
                            </MudText>
                            <div class="d-flex justify-space-between align-center mt-1">
                                <MudText Typo="Typo.h4" Class="font-weight-black summary-value-selected">
                                    @_selectedCount
                                    <MudText Typo="Typo.caption" Class="summary-value-sub">artículos</MudText>
                                </MudText>
                                <MudText Typo="Typo.h6" Class="font-weight-bold summary-value-selected">
                                    @_selectedPrice.ToString("C2")
                                </MudText>
                            </div>
                        </div>

                        <div class="summary-divider"></div>

                        <div class="d-flex flex-column gap-2">

                            <MudButton Variant="Variant.Filled"
                                       FullWidth="true"
                                       Size="Size.Large"
                                       Class="btn-checkout-all py-3"
                                       StartIcon="@Icons.Material.Filled.ShoppingCart"
                                       Disabled="@(_cartView.TotalProductsCount == 0)"
                                       OnClick="CheckoutAll">
                                Comprar Todo (@(_cartView.TotalProductsCount))
                            </MudButton>

                            <MudButton Variant="Variant.Filled"
                                       FullWidth="true"
                                       Size="Size.Large"
                                       Class="btn-checkout-selected py-3"
                                       StartIcon="@Icons.Material.Filled.CheckCircle"
                                       Disabled="@(_selectedCount == 0)"
                                       OnClick="CheckoutSelected">
                                Comprar Seleccionados (@_selectedCount)
                            </MudButton>

                        </div>

                        @if (_selectedCount == 0)
                        {
                            <MudText Typo="Typo.caption" Class="mt-2 text-center d-block summary-hint">
                                Selecciona artículos para comprar solo los elegidos
                            </MudText>
                        }

                    </MudPaper>
                </MudItem>

            </MudGrid>
        }

    </MudContainer>
</div>

@* ══════════════════════════════════════════════════════════════════
   Estos 3 RenderFragment usan sintaxis de plantilla Razor (@<tag>...)
   que SOLO el compilador de Razor entiende. No pueden vivir en un
   .razor.cs (ese lo compila directo el compilador de C#, no Razor),
   así que se quedan aquí — es el único código C# que se queda en
   este archivo, por límite técnico, no por elección.
   ══════════════════════════════════════════════════════════════════ *@
@code {
    private RenderFragment CheckIcon =>
        @<svg viewBox="0 0 24 24" class="icon-check" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 12.5L9.5 18L20 6" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    </svg>;

    private RenderFragment TrashIcon =>
        @<svg viewBox="0 0 24 24" class="icon-trash" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 7H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        <path d="M9 7V4.5C9 3.67 9.67 3 10.5 3H13.5C14.33 3 15 3.67 15 4.5V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M6.5 7L7.3 19.2C7.36 20.2 8.2 21 9.2 21H14.8C15.8 21 16.64 20.2 16.7 19.2L17.5 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M10.2 11V17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        <path d="M13.8 11V17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>;

    private RenderFragment RenderComboCard(CartComboDisplayDto combo) =>
        @<div>
    <div class="pcard-img-wrap">
        <img src="@combo.ComboImage" alt="@combo.ComboName" onerror="this.style.display='none'" />
        <div class="pcard-img-placeholder">
            <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Class="placeholder-icon" />
        </div>
        <span class="item-badge @(combo.ComboName.Contains("Promo", StringComparison.OrdinalIgnoreCase) ? "badge-promo" : "badge-combo")">
            @(combo.ComboName.Contains("Promo", StringComparison.OrdinalIgnoreCase) ? "Promo" : "Combo")
        </span>
        <div class="pcard-check @(combo.IsSelected ? "pcard-check-active" : "")">
            @if (combo.IsSelected) {
            @CheckIcon
                        }
        </div>
    </div>
    <div class="pcard-body">
        <div class="pcard-name" title="@combo.ComboName">@combo.ComboName</div>
        <div class="pcard-cat">@combo.Category</div>
        <div class="pcard-price">$@combo.UnitPrice.ToString("N2")</div>
        <div class="pcard-subtotal">Sub: $@combo.SubTotal.ToString("N2")</div>
        <div class="pcard-footer" @onclick:stopPropagation="true">
            <div class="qty-mini">
                <button @onclick="@(() => UpdateQuantity(combo.CartComboId, combo.Quantity - 1, "combo"))">−</button>
                <span>@combo.Quantity</span>
                <button @onclick="@(() => UpdateQuantity(combo.CartComboId, combo.Quantity + 1, "combo"))">+</button>
            </div>
            <button class="del-mini"
                    @onclick="@(() => RemoveItem(combo.CartComboId, "combo"))"
                    @onclick:stopPropagation="true"
                    title="Eliminar del carrito">
                @TrashIcon
            </button>
        </div>
    </div>
</div>;
}
