@page "/carrito"
@using Daniel_Licors_Store.Components.Shared
@using Daniel_Licors_Store.Data.Services
@using Daniel_Licors_Store.Models.Cart
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject ICartService CartService
@inject IWhatsAppService WhatsAppService
@inject AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject ILogger<Cart> Logger

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-12">

    <!-- Encabezado -->
    <div class="d-flex align-center mb-6 gap-x-3">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Nav.NavigateTo("/"))"
                   Class="text-transform-none btn-back">
            Volver al catálogo
        </MudButton>
        <MudText Typo="Typo.h4" Class="font-weight-bold cart-title">🛒 Mi Carrito</MudText>
    </div>

    @if (_loading)
    {
        <div class="d-flex justify-center align-center flex-column my-12 py-12">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.body1" Class="mt-4" Style="color:#764ba2">Cargando carrito...</MudText>
        </div>
    }
    else if (_cartView == null || (_cartView.Products.Count == 0 && _cartView.Combos.Count == 0))
    {
        <MudPaper Variant="Variant.Outlined" Class="d-flex flex-column align-center p-8 rounded-lg">
            <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Large" Style="opacity:0.3; color:#667eea;" Class="mb-4" />
            <MudText Typo="Typo.h5" Class="font-weight-bold mb-2">Carrito Vacío</MudText>
            <MudText Typo="Typo.body2" Class="mb-4" Style="color:#888">No tienes artículos en tu carrito</MudText>
            <MudButton Variant="Variant.Filled"
                       Style="background:linear-gradient(135deg,#667eea,#764ba2);color:white;"
                       OnClick="@(() => Nav.NavigateTo("/"))">
                Continuar comprando
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudGrid Spacing="3">

            <!-- COLUMNA IZQUIERDA -->
            <MudItem xs="12" md="8">

                <!-- Filtro y búsqueda -->
                <MudPaper Elevation="2" Class="p-4 mb-4 filter-paper">
                    <MudGrid Spacing="2" AlignItems="AlignItems.Center">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_searchTerm"
                                          @bind-Value:event="oninput"
                                          Placeholder="Buscar por nombre..."
                                          Variant="Variant.Outlined"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          Size="Size.Small"
                                          Immediate="true"
                                          ValueChanged="@((string v) => { _searchTerm = v; FilterItems(); })"
                                          Class="search-field" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string"
                                       Value="_filterCategory"
                                       ValueChanged="@((string v) => { _filterCategory = v; FilterItems(); })"
                                       Label="Filtrar por tipo"
                                       Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       AnchorOrigin="Origin.BottomLeft">
                                <MudSelectItem T="string" Value="@("")">Todos</MudSelectItem>
                                <MudSelectItem T="string" Value="@("producto")">🍾 Productos</MudSelectItem>
                                <MudSelectItem T="string" Value="@("combo")">🎁 Combos</MudSelectItem>
                                <MudSelectItem T="string" Value="@("promo")">🏷️ Promociones</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- Sin resultados -->
                @if (_filteredProducts.Count == 0 && _filteredCombos.Count == 0 &&
                            (!string.IsNullOrEmpty(_searchTerm) || !string.IsNullOrEmpty(_filterCategory)))
                {
                    <MudPaper Elevation="0" Class="d-flex flex-column align-center py-8 mb-4 rounded-lg"
                              Style="border:2px dashed #c4b5f4;">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Style="font-size:48px; color:#c4b5f4;" Class="mb-3" />
                        <MudText Typo="Typo.h6" Style="color:#764ba2;" Class="font-weight-bold mb-1">Sin resultados</MudText>
                        <MudText Typo="Typo.body2" Style="color:#999;">
                            @if (_filterCategory == "promo")
                            {
                                <span>No hay promociones disponibles en tu carrito ahora mismo.</span>
                            }
                            else
                            {
                                <span>No encontramos artículos con esa búsqueda.</span>
                            }
                        </MudText>
                        <MudButton Variant="Variant.Text" Style="color:#667eea;" Class="mt-3" OnClick="ClearFilters">
                            Limpiar filtros
                        </MudButton>
                    </MudPaper>
                }

                <!-- Sección PROMOCIONES (primero, solo cuando filtro = promo) -->
                @if (_filterCategory == "promo" && _filteredCombos.Any(c => c.ComboName.Contains("Promo", StringComparison.OrdinalIgnoreCase)))
                {
                    <div class="section-block mb-6">
                        <div class="section-label mb-3">
                            <span class="label-dot dot-promo"></span>
                            <MudText Typo="Typo.body2" Class="font-weight-bold section-title-text">
                                🏷️ PROMOCIONES (@_filteredCombos.Count(c => c.ComboName.Contains("Promo", StringComparison.OrdinalIgnoreCase)))
                            </MudText>
                        </div>
                        <div class="item-grid">
                            @foreach (var combo in _filteredCombos.Where(c => c.ComboName.Contains("Promo", StringComparison.OrdinalIgnoreCase)))
                            {
                                <div class="pcard @(combo.IsSelected ? "pcard-selected" : "")"
                                     @onclick="@(() => UpdateSelection(combo.CartComboId, !combo.IsSelected, "combo"))">
                                    @RenderComboCard(combo)
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Sección PRODUCTOS -->
                @if (_filteredProducts.Count > 0)
                {
                    <div class="section-block mb-6">
                        <div class="section-label mb-3">
                            <span class="label-dot dot-product"></span>
                            <MudText Typo="Typo.body2" Class="font-weight-bold section-title-text">
                                🍾 PRODUCTOS (@_filteredProducts.Count)
                            </MudText>
                        </div>
                        <div class="item-grid">
                            @foreach (var product in _filteredProducts)
                            {
                                <div class="pcard @(product.IsSelected ? "pcard-selected" : "")"
                                     @onclick="@(() => UpdateSelection(product.CartItemId, !product.IsSelected, "product"))">

                                    <div class="pcard-img-wrap">
                                        <img src="@product.ProductImage"
                                             alt="@product.ProductName"
                                             onerror="this.style.display='none'" />
                                        <div class="pcard-img-placeholder">
                                            <span class="placeholder-icon">🍾</span>
                                        </div>
                                        <span class="item-badge badge-product">Producto</span>
                                        <div class="pcard-check @(product.IsSelected ? "pcard-check-active" : "")">
                                            @if (product.IsSelected)
                                            {
                                                <span>✓</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="pcard-body">
                                        <div class="pcard-name" title="@product.ProductName">@product.ProductName</div>
                                        <div class="pcard-cat">@product.Category</div>
                                        <div class="pcard-price">$@product.UnitPrice.ToString("N2")</div>
                                        <div class="pcard-subtotal">Sub: $@product.SubTotal.ToString("N2")</div>
                                        <div class="pcard-footer" @onclick:stopPropagation="true">
                                            <div class="qty-mini">
                                                <button @onclick='() => UpdateQuantity(product.CartItemId, product.Quantity - 1, "product")'>−</button>
                                                <span>@product.Quantity</span>
                                                <button @onclick='() => UpdateQuantity(product.CartItemId, product.Quantity + 1, "product")'>+</button>
                                            </div>
                                            <button class="del-mini"
                                                    @onclick="@(() => RemoveItem(product.CartItemId, "product"))"
                                                    @onclick:stopPropagation="true"
                                                    title="Eliminar del carrito">
                                                🗑️
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Sección COMBOS -->
                @if (_filteredCombos.Count > 0 && _filterCategory != "promo")
                {
                    <div class="section-block mb-6">
                        <div class="section-label mb-3">
                            <span class="label-dot dot-combo"></span>
                            <MudText Typo="Typo.body2" Class="font-weight-bold section-title-text">
                                🎁 COMBOS & PROMOS (@_filteredCombos.Count)
                            </MudText>
                        </div>
                        <div class="item-grid">
                            @foreach (var combo in _filteredCombos)
                            {
                                <div class="pcard @(combo.IsSelected ? "pcard-selected" : "")"
                                     @onclick="@(() => UpdateSelection(combo.CartComboId, !combo.IsSelected, "combo"))">
                                    @RenderComboCard(combo)
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Botones de control -->
                <MudPaper Elevation="1" Class="p-3 control-bar">
                    <div class="d-flex flex-wrap gap-2">
                        <MudButton Variant="Variant.Filled"
                                   Style="background:#667eea;color:white;"
                                   StartIcon="@Icons.Material.Filled.CheckBox"
                                   Size="Size.Small"
                                   OnClick="SelectAll">
                            Seleccionar todo
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Style="border-color:#667eea;color:#667eea;"
                                   StartIcon="@Icons.Material.Filled.CheckBoxOutlineBlank"
                                   Size="Size.Small"
                                   OnClick="DeselectAll">
                            Deseleccionar
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.DeleteSweep"
                                   Size="Size.Small"
                                   OnClick="ClearCart">
                            Vaciar carrito
                        </MudButton>
                    </div>
                </MudPaper>

            </MudItem>

            <!-- COLUMNA DERECHA: Resumen -->
            <MudItem xs="12" md="4">
                <MudPaper Elevation="3" Class="sticky-summary p-4 rounded-xl">

                    <div class="summary-header mb-4">
                        <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color:white; letter-spacing:0.5px;">
                            📋 Resumen de Compra
                        </MudText>
                    </div>

                    <div class="summary-card mb-3">
                        <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.7); text-transform:uppercase; letter-spacing:0.8px;">
                            Total en carrito
                        </MudText>
                        <div class="d-flex justify-space-between align-center mt-1">
                            <MudText Typo="Typo.h4" Class="font-weight-black" Style="color:white;">
                                @_cartView.TotalProductsCount
                                <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.7);">artículos</MudText>
                            </MudText>
                            <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color:#FFD700;">
                                @_cartView.TotalPrice.ToString("C2")
                            </MudText>
                        </div>
                    </div>

                    <div class="summary-card summary-card-selected mb-4">
                        <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.7); text-transform:uppercase; letter-spacing:0.8px;">
                            Seleccionados
                        </MudText>
                        <div class="d-flex justify-space-between align-center mt-1">
                            <MudText Typo="Typo.h4" Class="font-weight-black" Style="color:#A8F0C6;">
                                @_selectedCount
                                <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.7);">artículos</MudText>
                            </MudText>
                            <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color:#A8F0C6;">
                                @_selectedPrice.ToString("C2")
                            </MudText>
                        </div>
                    </div>

                    <div style="border-top: 1px solid rgba(255,255,255,0.2); margin-bottom:16px;"></div>

                    <div class="d-flex flex-column gap-2">

                        <MudButton Variant="Variant.Filled"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   Style="background:rgba(255,255,255,0.2); color:white; border:1px solid rgba(255,255,255,0.4); backdrop-filter:blur(4px); font-weight:700; border-radius:12px;"
                                   StartIcon="@Icons.Material.Filled.ShoppingCart"
                                   Disabled="@(_cartView.TotalProductsCount == 0)"
                                   OnClick="CheckoutAll"
                                   Class="py-3">
                            Comprar Todo (@(_cartView.TotalProductsCount))
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   Style="background:linear-gradient(135deg,#43e97b,#38f9d7); color:#1a1a1a; font-weight:800; border-radius:12px;"
                                   StartIcon="@Icons.Material.Filled.CheckCircle"
                                   Disabled="@(_selectedCount == 0)"
                                   OnClick="CheckoutSelected"
                                   Class="py-3">
                            Comprar Seleccionados (@_selectedCount)
                        </MudButton>

                    </div>

                    @if (_selectedCount == 0)
                    {
                        <MudText Typo="Typo.caption" Class="mt-2 text-center d-block" Style="color:rgba(255,255,255,0.55);">
                            Selecciona artículos para comprar solo los elegidos
                        </MudText>
                    }

                </MudPaper>
            </MudItem>

        </MudGrid>
    }

</MudContainer>

@code {
    private RenderFragment RenderComboCard(CartComboDisplayDto combo) =>
        @<div>
    <div class="pcard-img-wrap">
        <img src="@combo.ComboImage" alt="@combo.ComboName" onerror="this.style.display='none'" />
        <div class="pcard-img-placeholder">
            <span class="placeholder-icon">🎁</span>
        </div>
        <span class="item-badge @(combo.ComboName.Contains("Promo", StringComparison.OrdinalIgnoreCase) ? "badge-promo" : "badge-combo")">
            @(combo.ComboName.Contains("Promo", StringComparison.OrdinalIgnoreCase) ? "Promo" : "Combo")
        </span>
        <div class="pcard-check @(combo.IsSelected ? "pcard-check-active" : "")">
            @if (combo.IsSelected) {
            <span>✓</span>
                        }
        </div>
    </div>
    <div class="pcard-body">
        <div class="pcard-name" title="@combo.ComboName">@combo.ComboName</div>
        <div class="pcard-cat">@combo.Category</div>
        <div class="pcard-price">$@combo.UnitPrice.ToString("N2")</div>
        <div class="pcard-subtotal">Sub: $@combo.SubTotal.ToString("N2")</div>
        <div class="pcard-footer" @onclick:stopPropagation="true">
            <div class="qty-mini">
                <button @onclick="@(() => UpdateQuantity(combo.CartComboId, combo.Quantity - 1, "combo"))">−</button>
                <span>@combo.Quantity</span>
                <button @onclick="@(() => UpdateQuantity(combo.CartComboId, combo.Quantity + 1, "combo"))">+</button>
            </div>
            <button class="del-mini"
                    @onclick="@(() => RemoveItem(combo.CartComboId, "combo"))"
                    @onclick:stopPropagation="true"
                    title="Eliminar del carrito">
                🗑️
            </button>
        </div>
    </div>
</div>;
}

<style>
    :root {
        --app-primary: #667eea;
        --app-secondary: #764ba2;
        --app-accent: #43e97b;
        --app-gold: #FFD700;
        --app-danger: #e53935;
    }

    .cart-title {
        color: #1a1a1a;
    }

    .btn-back {
        color: var(--app-primary) !important;
    }

    .filter-paper {
        border-left: 4px solid var(--app-primary) !important;
    }

    .item-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
    }

    @@media (max-width: 1100px) {
        .item-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 700px) {
        .item-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
        }
    }

    .pcard {
        background: #ffffff;
        border: 1.5px solid rgba(0,0,0,0.08);
        border-radius: 14px;
        overflow: hidden;
        cursor: pointer;
        transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.12s ease;
        position: relative;
        display: flex;
        flex-direction: column;
    }

        .pcard:hover {
            box-shadow: 0 6px 20px rgba(102,126,234,0.15);
            border-color: rgba(102,126,234,0.4);
            transform: translateY(-2px);
        }

    .pcard-selected {
        border: 2px solid var(--app-primary) !important;
        background: rgba(102,126,234,0.05) !important;
        box-shadow: 0 0 0 3px rgba(102,126,234,0.12) !important;
    }

    .pcard-img-wrap {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        background: linear-gradient(145deg, #f0f2ff, #f8f5ff);
        overflow: hidden;
    }

        .pcard-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            position: relative;
            z-index: 1;
            transition: transform 0.3s ease;
        }

    .pcard:hover .pcard-img-wrap img {
        transform: scale(1.04);
    }

    .pcard-img-placeholder {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 0;
    }

    .placeholder-icon {
        font-size: 36px;
        opacity: 0.18;
    }

    .item-badge {
        position: absolute;
        top: 7px;
        left: 7px;
        font-size: 9px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 5px;
        letter-spacing: 0.4px;
        text-transform: uppercase;
        z-index: 2;
        box-shadow: 0 1px 4px rgba(0,0,0,0.15);
    }

    .badge-product {
        background: #dbeafe;
        color: #1e40af;
    }

    .badge-combo {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-promo {
        background: #fee2e2;
        color: #991b1b;
    }

    .pcard-check {
        position: absolute;
        top: 7px;
        right: 7px;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 2px solid rgba(255,255,255,0.9);
        background: rgba(255,255,255,0.85);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 900;
        z-index: 2;
        transition: background 0.15s, border-color 0.15s;
        box-shadow: 0 1px 4px rgba(0,0,0,0.15);
    }

    .pcard-check-active {
        background: var(--app-primary);
        border-color: var(--app-primary);
        color: white;
    }

    .pcard-body {
        padding: 9px 10px 10px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .pcard-name {
        font-size: 12px;
        font-weight: 600;
        color: #1a1a1a;
        line-height: 1.3;
        margin-bottom: 2px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .pcard-cat {
        font-size: 10px;
        color: #999;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .pcard-price {
        font-size: 14px;
        font-weight: 800;
        color: var(--app-secondary);
        margin-bottom: 1px;
    }

    .pcard-subtotal {
        font-size: 10px;
        color: #bbb;
        margin-bottom: 8px;
    }

    .pcard-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 4px;
        margin-top: auto;
    }

    .qty-mini {
        display: flex;
        align-items: center;
        border: 1.5px solid rgba(102,126,234,0.25);
        border-radius: 8px;
        overflow: hidden;
        height: 26px;
        background: #fafafa;
    }

        .qty-mini button {
            border: none;
            background: transparent;
            width: 22px;
            height: 100%;
            cursor: pointer;
            font-size: 14px;
            color: var(--app-primary);
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.12s;
        }

            .qty-mini button:hover {
                background: rgba(102,126,234,0.1);
            }

        .qty-mini span {
            font-size: 11px;
            font-weight: 700;
            min-width: 22px;
            text-align: center;
            border-left: 1px solid rgba(102,126,234,0.2);
            border-right: 1px solid rgba(102,126,234,0.2);
            color: #333;
            line-height: 26px;
        }

    .del-mini {
        border: none;
        background: rgba(229,57,53,0.07);
        cursor: pointer;
        font-size: 13px;
        padding: 4px 6px;
        border-radius: 7px;
        transition: background 0.12s, transform 0.1s;
        line-height: 1;
    }

        .del-mini:hover {
            background: rgba(229,57,53,0.18);
            transform: scale(1.1);
        }

    .section-label {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .label-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .dot-product {
        background: var(--app-primary);
    }

    .dot-combo {
        background: #f59e0b;
    }

    .dot-promo {
        background: var(--app-danger);
    }

    .section-title-text {
        color: #444;
        letter-spacing: 0.5px;
    }

    .control-bar {
        border-top: 3px solid var(--app-primary) !important;
    }

    .sticky-summary {
        position: sticky;
        top: 80px;
        background: linear-gradient(160deg, #667eea 0%, #764ba2 100%) !important;
        color: white;
    }

    .summary-card {
        background: rgba(255,255,255,0.12);
        padding: 12px 14px;
        border-radius: 10px;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.15);
    }

    .summary-card-selected {
        background: rgba(67,233,123,0.15);
        border: 1px solid rgba(67,233,123,0.3);
    }

    @@media (max-width: 600px) {
        .pcard-name {
            font-size: 11px;
        }

        .pcard-price {
            font-size: 13px;
        }

        .pcard-body {
            padding: 7px 8px 9px;
        }

        .sticky-summary {
            position: relative;
            top: 0;
        }
    }
</style>

@code {
    private CartViewDto? _cartView;
    private List<CartItemDisplayDto> _filteredProducts = new();
    private List<CartComboDisplayDto> _filteredCombos = new();
    private string _searchTerm = "";
    private string _filterCategory = "";
    private bool _loading = true;
    private string _currentUserId = "";
    private int _storeId = 1;

    private int _selectedCount = 0;
    private decimal _selectedPrice = 0;

    private void RecalcSelected()
    {
        if (_cartView == null) { _selectedCount = 0; _selectedPrice = 0; return; }
        _selectedCount = _cartView.Products.Where(p => p.IsSelected).Sum(p => p.Quantity)
                       + _cartView.Combos.Where(c => c.IsSelected).Sum(c => c.Quantity);
        _selectedPrice = _cartView.Products.Where(p => p.IsSelected).Sum(p => p.SubTotal)
                       + _cartView.Combos.Where(c => c.IsSelected).Sum(c => c.SubTotal);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity == null || !user.Identity.IsAuthenticated)
            {
                Nav.NavigateTo("/login");
                return;
            }

            _currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                ?? user.FindFirst("sub")?.Value
                ?? user.FindFirst("userId")?.Value
                ?? string.Empty;

            if (string.IsNullOrEmpty(_currentUserId))
            {
                Logger.LogWarning("Usuario autenticado pero sin ID en los claims");
                Nav.NavigateTo("/login");
                return;
            }

            await LoadCart();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error en OnInitializedAsync");
            Snackbar.Add($"Error al cargar: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadCart()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(_currentUserId))
            {
                Snackbar.Add("No se pudo obtener tu sesión. Inicia sesión de nuevo.", Severity.Error);
                await Task.Delay(800);
                Nav.NavigateTo("/login");
                return;
            }

            _cartView = await CartService.GetCartAsync(_currentUserId, _storeId);
            _cartView ??= new CartViewDto();
            RecalcSelected();
            FilterItems();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar carrito para usuario {UserId}", _currentUserId);
            Snackbar.Add($"Error al cargar carrito: {ex.Message}", Severity.Error);
        }
    }

    private void FilterItems()
    {
        var search = _searchTerm?.Trim() ?? "";
        var cat = _filterCategory?.Trim().ToLower() ?? "";

        _filteredProducts = _cartView?.Products
            .Where(p => string.IsNullOrEmpty(search) || p.ProductName.Contains(search, StringComparison.OrdinalIgnoreCase))
            .Where(p => string.IsNullOrEmpty(cat) || cat == "producto")
            .ToList() ?? new();

        if (cat == "producto")
        {
            _filteredCombos = new();
        }
        else
        {
            _filteredCombos = _cartView?.Combos
                .Where(c => string.IsNullOrEmpty(search) || c.ComboName.Contains(search, StringComparison.OrdinalIgnoreCase))
                .Where(c =>
                    string.IsNullOrEmpty(cat) ||
                    (cat == "combo" && !c.ComboName.Contains("Promo", StringComparison.OrdinalIgnoreCase)) ||
                    (cat == "promo" && c.ComboName.Contains("Promo", StringComparison.OrdinalIgnoreCase))
                )
                .ToList() ?? new();

            if (cat == "promo")
                _filteredProducts = new();
        }

        StateHasChanged();
    }

    private void ClearFilters()
    {
        _searchTerm = "";
        _filterCategory = "";
        FilterItems();
    }

    private async Task RemoveItem(int itemId, string itemType)
    {
        if (string.IsNullOrWhiteSpace(_currentUserId))
        {
            Snackbar.Add("Sesión expirada.", Severity.Warning);
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            _cartView = await CartService.RemoveItemAsync(_currentUserId, itemId, itemType);
            RecalcSelected();
            FilterItems();
            Snackbar.Add("Artículo eliminado", Severity.Info);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al eliminar item {ItemId}", itemId);
            Snackbar.Add($"Error al eliminar: {ex.Message}", Severity.Error);
        }
    }

    private async Task UpdateQuantity(int itemId, int newQuantity, string itemType)
    {
        if (string.IsNullOrWhiteSpace(_currentUserId))
        {
            Snackbar.Add("Sesión expirada.", Severity.Warning);
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            if (newQuantity <= 0)
            {
                Snackbar.Add("La cantidad debe ser mayor a 0", Severity.Warning);
                return;
            }

            _cartView = await CartService.UpdateItemQuantityAsync(_currentUserId, itemId, newQuantity, itemType);
            RecalcSelected();
            FilterItems();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al actualizar cantidad item {ItemId}", itemId);
            Snackbar.Add($"Error al actualizar cantidad: {ex.Message}", Severity.Error);
        }
    }

    private void UpdateSelection(int itemId, bool isSelected, string itemType)
    {
        try
        {
            if (itemType == "product")
            {
                var item = _cartView?.Products.FirstOrDefault(p => p.CartItemId == itemId);
                if (item != null) item.IsSelected = isSelected;
            }
            else if (itemType == "combo")
            {
                var item = _cartView?.Combos.FirstOrDefault(c => c.CartComboId == itemId);
                if (item != null) item.IsSelected = isSelected;
            }

            RecalcSelected();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al actualizar selección de item {ItemId}", itemId);
        }
    }

    private void SelectAll()
    {
        _cartView?.Products.ForEach(p => p.IsSelected = true);
        _cartView?.Combos.ForEach(c => c.IsSelected = true);
        RecalcSelected();
        StateHasChanged();
    }

    private void DeselectAll()
    {
        _cartView?.Products.ForEach(p => p.IsSelected = false);
        _cartView?.Combos.ForEach(c => c.IsSelected = false);
        RecalcSelected();
        StateHasChanged();
    }

    private async Task ClearCart()
    {
        if (string.IsNullOrWhiteSpace(_currentUserId)) { Nav.NavigateTo("/login"); return; }

        try
        {
            bool? confirm = await DialogService.ShowMessageBox(
                "¿Vaciar Carrito?",
                "¿Estás seguro de que deseas eliminar todos los productos del carrito?",
                yesText: "Sí, vaciar", cancelText: "Cancelar");

            if (confirm == true)
            {
                await CartService.ClearCartAsync(_currentUserId);
                _cartView = await CartService.GetCartAsync(_currentUserId, _storeId);
                RecalcSelected();
                FilterItems();
                Snackbar.Add("Carrito vaciado.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al vaciar carrito");
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task CheckoutAll()
    {
        SelectAll();
        await PerformCheckout(false);
    }

    private async Task CheckoutSelected()
    {
        if (_selectedCount == 0)
        {
            Snackbar.Add("Selecciona al menos un artículo primero.", Severity.Warning);
            return;
        }
        await PerformCheckout(true);
    }

    private async Task PerformCheckout(bool selectedOnly)
    {
        if (string.IsNullOrWhiteSpace(_currentUserId))
        {
            Snackbar.Add("Sesión expirada.", Severity.Warning);
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            // El servicio ahora devuelve siempre el recibo completo (todos los items)
            var receipt = await CartService.GenerateReceiptAsync(_currentUserId, false);

            if (receipt == null || !receipt.Items.Any())
            {
                Snackbar.Add("No hay artículos para comprar.", Severity.Warning);
                return;
            }

            // FIX: si es selectedOnly, filtramos aquí en el frontend usando IsSelected del _cartView
            if (selectedOnly && _cartView != null)
            {
                var selectedProductIds = _cartView.Products
                    .Where(p => p.IsSelected)
                    .Select(p => p.CartItemId)
                    .ToHashSet();

                var selectedComboIds = _cartView.Combos
                    .Where(c => c.IsSelected)
                    .Select(c => c.CartComboId)
                    .ToHashSet();

                receipt.Items = receipt.Items
                    .Where(i => (i.ItemType == "product" && selectedProductIds.Contains(i.ItemId)) ||
                                (i.ItemType == "combo" && selectedComboIds.Contains(i.ItemId)))
                    .ToList();

                receipt.TotalAmount = receipt.Items.Sum(i => i.SubTotal);
            }

            if (!receipt.Items.Any())
            {
                Snackbar.Add("No hay artículos seleccionados para comprar.", Severity.Warning);
                return;
            }

            var defaultPhone = "+1234567890";
            var whatsappLink = WhatsAppService.GenerateWhatsAppLink(defaultPhone,
                WhatsAppService.GenerateReceiptMessage(receipt));

            var parameters = new DialogParameters
            {
                { "Receipt", receipt },
                { "WhatsAppLink", whatsappLink }
            };

            var dialogResult = await DialogService.ShowAsync<ReceiptDialog>("Tu Recibo", parameters);
            var result = await dialogResult.Result;

            if (!result.Canceled && result.Data != null)
            {
                await CartService.CheckoutAsync(_currentUserId, new List<int>(), "");
                Snackbar.Add("¡Compra completada! Revisa WhatsApp para el recibo.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Pedido cancelado. Tu carrito sigue igual.", Severity.Info);
            }

            _cartView = await CartService.GetCartAsync(_currentUserId, _storeId);
            RecalcSelected();
            FilterItems();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error en PerformCheckout para usuario {UserId}", _currentUserId);
            Snackbar.Add($"Error en la compra: {ex.Message}", Severity.Error);
        }
    }
}
