@page "/carrito"
@using Daniel_Licors_Store.Components.Shared
@using Daniel_Licors_Store.Data.Services
@using Daniel_Licors_Store.Models.Cart
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject ICartService CartService
@inject IWhatsAppService WhatsAppService
@inject AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject ILogger<Cart> Logger

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-12">

    <!-- Encabezado -->
    <div class="d-flex align-center mb-6 gap-x-3">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Nav.NavigateTo("/"))"
                   Class="text-transform-none">
            Volver al catálogo
        </MudButton>
        <MudText Typo="Typo.h4" Class="font-weight-bold">Mi Carrito</MudText>
    </div>

    @if (_loading)
    {
        <div class="d-flex justify-center align-center flex-column my-12 py-12">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.body1" Class="mt-4 muted-text">Cargando carrito...</MudText>
        </div>
    }
    else if (_cartView == null || (_cartView.Products.Count == 0 && _cartView.Combos.Count == 0))
    {
        <MudPaper Variant="Variant.Outlined" Class="d-flex flex-column align-center p-8 rounded-lg">
            <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Large" Class="mb-4 muted-text" Style="opacity: 0.5;" />
            <MudText Typo="Typo.h5" Class="font-weight-bold mb-2">Carrito Vacío</MudText>
            <MudText Typo="Typo.body2" Class="muted-text mb-4">No tienes artículos en tu carrito</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Nav.NavigateTo("/"))">
                Continuar comprando
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudGrid Spacing="3">

            <!-- COLUMNA IZQUIERDA: Items del carrito -->
            <MudItem xs="12" md="8">

                <!-- Filtro y búsqueda -->
                <MudPaper Elevation="1" Class="p-4 mb-4">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_searchTerm" 
                                         Placeholder="Buscar productos..." 
                                         Variant="Variant.Outlined"
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.Search"
                                         Size="Size.Small"
                                         OnKeyUp="FilterItems" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="_filterCategory" 
                                      Placeholder="Filtrar por categoría..."
                                      Variant="Variant.Outlined"
                                      Size="Size.Small"
                                      @onchange="FilterItems">
                                <MudSelectItem Value="@("")">Todas las categorías</MudSelectItem>
                                <MudSelectItem Value="@("Producto")">Productos</MudSelectItem>
                                <MudSelectItem Value="@("Combo")">Combos</MudSelectItem>
                                <MudSelectItem Value="@("Promoción")">Promociones</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- Sección PRODUCTOS -->
                @if (_filteredProducts.Count > 0)
                {
                    <div class="section-separator mb-6">

                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.LocalBar" Size="Size.Small" Class="mr-2" />
                            PRODUCTOS (@_filteredProducts.Count)
                        </MudText>

                        <div class="amazon-list">

                            @foreach (var product in _filteredProducts)
                            {
                                <div class="amazon-card @(product.IsSelected ? "selected" : "")"
                                     @onclick="@(() => UpdateSelection(product.CartItemId, !product.IsSelected, "product"))">

                                    <!-- CHECK -->
                                    <div class="amazon-check">
                                        <MudCheckBox T="bool"
                                                     Checked="product.IsSelected"
                                                     CheckedChanged="@((bool v) => UpdateSelection(product.CartItemId, v, "product"))"
                                                     @onclick:stopPropagation="true" />
                                    </div>

                                    <!-- IMAGE -->
                                    <div class="amazon-img">
                                        <img src="@product.ProductImage" />
                                    </div>

                                    <!-- INFO -->
                                    <div class="amazon-info">
                                        <div class="title">@product.ProductName</div>
                                        <div class="category">@product.Category</div>

                                        <div class="price-row">
                                            <span class="price">$@product.UnitPrice.ToString("N2")</span>
                                            <span class="subtotal">Subtotal: $@product.SubTotal.ToString("N2")</span>
                                        </div>

                                        <div class="stock">Disponible</div>
                                    </div>

                                    <!-- ACTIONS -->
                                    <div class="amazon-actions" @onclick:stopPropagation="true">
                                        <div class="qty">
                                            <button @onclick='() => UpdateQuantity(product.CartItemId, product.Quantity - 1, "product")'>-</button>
                                            <span>@product.Quantity</span>
                                            <button @onclick='() => UpdateQuantity(product.CartItemId, product.Quantity + 1, "product")'>+</button>
                                        </div>

                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       OnClick='() => RemoveItem(product.CartItemId, "product")' />
                                    </div>

                                </div>
                            }

                        </div>
                    </div>
                }

                <!-- Sección COMBOS -->
                @if (_filteredCombos.Count > 0)
                {
                    <div class="section-separator mb-6">

                        <MudText Typo="Typo.h6" Class="font-weight-bold mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment" Size="Size.Small" Class="mr-2" />
                            COMBOS (@_filteredCombos.Count)
                        </MudText>

                        <div class="amazon-list">

                            @foreach (var combo in _filteredCombos)
                            {
                                <div class="amazon-card @(combo.IsSelected ? "selected" : "")"
                                     @onclick="@(() => UpdateSelection(combo.CartComboId, !combo.IsSelected, "combo"))">

                                    <div class="amazon-check">
                                        <MudCheckBox T="bool"
                                                     Checked="combo.IsSelected"
                                                     CheckedChanged="@((bool v) => UpdateSelection(combo.CartComboId, v, "combo"))"
                                                     @onclick:stopPropagation="true" />
                                    </div>

                                    <div class="amazon-img">
                                        <img src="@combo.ComboImage" />
                                    </div>

                                    <div class="amazon-info">
                                        <div class="title">@combo.ComboName</div>
                                        <div class="category">@combo.Category</div>

                                        <div class="price-row">
                                            <span class="price">$@combo.UnitPrice.ToString("N2")</span>
                                            <span class="subtotal">Subtotal: $@combo.SubTotal.ToString("N2")</span>
                                        </div>
                                    </div>

                                    <div class="amazon-actions" @onclick:stopPropagation="true">
                                        <div class="qty">
                                            <button @onclick='() => UpdateQuantity(combo.CartComboId, combo.Quantity - 1, "combo")'>-</button>
                                            <span>@combo.Quantity</span>
                                            <button @onclick='() => UpdateQuantity(combo.CartComboId, combo.Quantity + 1, "combo")'>+</button>
                                        </div>

                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       OnClick='() => RemoveItem(combo.CartComboId, "combo")' />
                                    </div>

                                </div>
                            }

                        </div>
                    </div>
                }

                <!-- Botones de control -->
                <MudPaper Elevation="1" Class="p-4 d-flex gap-2">
                    <MudButton Variant="Variant.Outlined" 
                              Color="Color.Primary"
                              StartIcon="@Icons.Material.Filled.CheckBox"
                              Size="Size.Small"
                              OnClick="SelectAll">
                        Seleccionar todo
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" 
                              Color="Color.Default"
                              StartIcon="@Icons.Material.Filled.CheckBoxOutlineBlank"
                              Size="Size.Small"
                              OnClick="DeselectAll">
                        Deseleccionar
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" 
                              Color="Color.Error"
                              StartIcon="@Icons.Material.Filled.DeleteSweep"
                              Size="Size.Small"
                              OnClick="ClearCart">
                        Vaciar carrito
                    </MudButton>
                </MudPaper>

            </MudItem>

            <!-- COLUMNA DERECHA: Resumen y compra -->
            <MudItem xs="12" md="4">

                <MudPaper Elevation="2" Class="sticky-summary p-4 rounded-lg">

                    <!-- Contador Total -->
                    <div class="summary-section mb-4">
                        <MudText Typo="Typo.body2" Class="muted-text">TOTAL DE PRODUCTOS</MudText>
                        <MudText Typo="Typo.h4" Class="font-weight-bold text-primary">
                            @_cartView.TotalProductsCount
                        </MudText>
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold">
                            @_cartView.TotalPrice.ToString("C2")
                        </MudText>
                    </div>

                    <!-- Contador Seleccionados -->
                    <div class="summary-section mb-4">
                        <MudText Typo="Typo.body2" Class="muted-text">PRODUCTOS SELECCIONADOS</MudText>
                        <MudText Typo="Typo.h4" Class="font-weight-bold" Color="Color.Success">
                            @_cartView.SelectedProductsCount
                        </MudText>
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.h6" Class="font-weight-bold">
                            @_cartView.SelectedPrice.ToString("C2")
                        </MudText>
                    </div>

                    <MudDivider Class="my-4" />

                    <!-- Botones de Compra -->
                    <div class="d-flex flex-column gap-2">

                        <!-- Comprar TODO -->
                        <MudButton Variant="Variant.Filled" 
                                  Color="Color.Primary"
                                  Size="Size.Large"
                                  FullWidth="true"
                                  StartIcon="@Icons.Material.Filled.ShoppingCart"
                                  Disabled="@(_cartView.TotalProductsCount == 0)"
                                  OnClick="CheckoutAll"
                                  Class="py-3">
                            Comprar Todo (@(_cartView.TotalProductsCount) artículos)
                        </MudButton>

                        <!-- Comprar SELECCIONADOS -->
                        <MudButton Variant="Variant.Filled" 
                                  Color="Color.Success"
                                  Size="Size.Large"
                                  FullWidth="true"
                                  StartIcon="@Icons.Material.Filled.CheckCircle"
                                  Disabled="@(_cartView.SelectedProductsCount == 0)"
                                  OnClick="CheckoutSelected"
                                  Class="py-3">
                            Comprar Seleccionados (@(_cartView.SelectedProductsCount))
                        </MudButton>

                    </div>

                </MudPaper>

            </MudItem>

        </MudGrid>
    }

</MudContainer>

<style>
    .sticky-summary {
        position: sticky;
        top: 120px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .summary-section {
        background: rgba(255, 255, 255, 0.1);
        padding: 12px;
        border-radius: 8px;
        backdrop-filter: blur(10px);
    }

    .section-separator {
        border-left: 4px solid #667eea;
        padding-left: 16px;
    }

    .text-primary {
        color: #667eea !important;
    }
</style>

@code {
    private CartViewDto? _cartView;
    private List<CartItemDisplayDto> _filteredProducts = new();
    private List<CartComboDisplayDto> _filteredCombos = new();
    private string _searchTerm = "";
    private string _filterCategory = "";
    private bool _loading = true;
    private string _currentUserId = "";
    private int _storeId = 1; // Default store

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity == null || !user.Identity.IsAuthenticated)
            {
                Nav.NavigateTo("/login");
                return;
            }

            // Buscamos el ID en los claims estándar de JWT o Identity
            _currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                ?? user.FindFirst("sub")?.Value
                ?? user.FindFirst("userId")?.Value
                ?? string.Empty;

            if (string.IsNullOrEmpty(_currentUserId))
            {
                // Si el usuario está autenticado pero no tiene ID, es un error de token
                Logger.LogWarning("Usuario autenticado pero sin ID en los claims");
                Nav.NavigateTo("/login");
                return;
            }

            await LoadCart();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error en OnInitializedAsync");
            Snackbar.Add($"Error al cargar: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadCart()
    {
        try
        {
            // Validación preventiva
            if (string.IsNullOrWhiteSpace(_currentUserId))
            {
                Snackbar.Add("Error: No se pudo obtener tu ID de usuario. Por favor, inicia sesión de nuevo.", Severity.Error);
                await Task.Delay(1000);
                Nav.NavigateTo("/login");
                return;
            }

            _cartView = await CartService.GetCartAsync(_currentUserId, _storeId);
            
            if (_cartView == null)
            {
                _cartView = new CartViewDto();
            }
            
            FilterItems();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error crítico al cargar carrito para usuario {UserId}", _currentUserId);
            Snackbar.Add($"Error al cargar carrito: {ex.Message}", Severity.Error);
        }
    }

    private void FilterItems()
    {
        _filteredProducts = _cartView?.Products
            .Where(p => string.IsNullOrEmpty(_searchTerm) || p.ProductName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
            .Where(p => string.IsNullOrEmpty(_filterCategory) || p.Category == _filterCategory)
            .ToList() ?? new();

        _filteredCombos = _cartView?.Combos
            .Where(c => string.IsNullOrEmpty(_searchTerm) || c.ComboName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
            .Where(c => string.IsNullOrEmpty(_filterCategory) || c.Category == _filterCategory)
            .ToList() ?? new();
    }

    private async Task RemoveItem(int itemId, string itemType)
    {
        if (string.IsNullOrWhiteSpace(_currentUserId))
        {
            Snackbar.Add("Sesión expirada. Por favor, inicia sesión de nuevo.", Severity.Warning);
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            _cartView = await CartService.RemoveItemAsync(_currentUserId, itemId, itemType);
            FilterItems();
            Snackbar.Add("Artículo eliminado del carrito", Severity.Info);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al eliminar item {ItemId} tipo {ItemType}", itemId, itemType);
            Snackbar.Add($"Error al eliminar: {ex.Message}", Severity.Error);
        }
    }

    private async Task UpdateQuantity(int itemId, int newQuantity, string itemType)
    {
        if (string.IsNullOrWhiteSpace(_currentUserId))
        {
            Snackbar.Add("Sesión expirada. Por favor, inicia sesión de nuevo.", Severity.Warning);
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            if (newQuantity <= 0)
            {
                Snackbar.Add("La cantidad debe ser mayor a 0", Severity.Warning);
                return;
            }

            _cartView = await CartService.UpdateItemQuantityAsync(_currentUserId, itemId, newQuantity, itemType);
            FilterItems();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al actualizar cantidad item {ItemId}", itemId);
            Snackbar.Add($"Error al actualizar cantidad: {ex.Message}", Severity.Error);
        }
    }

    private void UpdateSelection(int itemId, bool isSelected, string itemType)
    {
        try
        {
            if (itemType == "product")
            {
                var item = _cartView?.Products.FirstOrDefault(p => p.CartItemId == itemId);
                if (item != null) item.IsSelected = isSelected;
            }
            else if (itemType == "combo")
            {
                var item = _cartView?.Combos.FirstOrDefault(c => c.CartComboId == itemId);
                if (item != null) item.IsSelected = isSelected;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al actualizar selección de item {ItemId}", itemId);
        }
    }

    private void SelectAll()
    {
        try
        {
            _cartView?.Products.ForEach(p => p.IsSelected = true);
            _cartView?.Combos.ForEach(c => c.IsSelected = true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al seleccionar todo");
            Snackbar.Add("Error al seleccionar", Severity.Error);
        }
    }

    private void DeselectAll()
    {
        try
        {
            _cartView?.Products.ForEach(p => p.IsSelected = false);
            _cartView?.Combos.ForEach(c => c.IsSelected = false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al deseleccionar todo");
            Snackbar.Add("Error al deseleccionar", Severity.Error);
        }
    }

    private async Task ClearCart()
    {
        if (string.IsNullOrWhiteSpace(_currentUserId))
        {
            Snackbar.Add("Sesión expirada. Por favor, inicia sesión de nuevo.", Severity.Warning);
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            // Preguntar antes de borrar todo por accidente
            bool? confirm = await DialogService.ShowMessageBox(
                "¿Vaciar Carrito?",
                "¿Estás seguro de que deseas eliminar todos los productos del carrito?",
                yesText: "Sí, vaciar", cancelText: "Cancelar");

            if (confirm == true)
            {
                // 💡 Llama aquí al método de tu servicio que borra los datos en la base de datos.
                // Ejemplo: await CartService.ClearCartAsync(_currentUserId);

                // Refrescamos la vista
                _cartView = await CartService.GetCartAsync(_currentUserId, _storeId);
                FilterItems();

                Snackbar.Add("Carrito vaciado correctamente.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al vaciar carrito");
            Snackbar.Add($"Error al vaciar carrito: {ex.Message}", Severity.Error);
        }
    }

    private async Task CheckoutAll()
    {
        await PerformCheckout(false);
    }

    private async Task CheckoutSelected()
    {
        await PerformCheckout(true);
    }

    private async Task PerformCheckout(bool selectedOnly)
    {
        if (string.IsNullOrWhiteSpace(_currentUserId))
        {
            Snackbar.Add("Sesión expirada. Por favor, inicia sesión de nuevo.", Severity.Warning);
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            // 1. Generar el recibo en memoria
            var receipt = await CartService.GenerateReceiptAsync(_currentUserId, selectedOnly);

            if (receipt == null)
            {
                Snackbar.Add("No hay artículos para comprar", Severity.Warning);
                return;
            }

            var defaultPhone = "+1234567890";
            var whatsappLink = WhatsAppService.GenerateWhatsAppLink(defaultPhone,
                WhatsAppService.GenerateReceiptMessage(receipt));

            var parameters = new DialogParameters
        {
            { "Receipt", receipt },
            { "WhatsAppLink", whatsappLink }
        };

            // 2. Abrir el diálogo
            var dialogResult = await DialogService.ShowAsync<ReceiptDialog>("Tu Recibo", parameters);
            var result = await dialogResult.Result;

            // 🚀 AQUÍ ESTÁ EL TRUCO:
            // Si el usuario le dio a "Cancelar" o a la "X" de cerrar, result.Canceled será 'true'.
            // Solo procesamos la compra si el usuario confirmó explícitamente (por ejemplo, dándole a un botón "Confirmar" o "Enviar").
            if (!result.Canceled && result.Data != null)
            {
                // Marcar carrito como enviado (esto es lo que lo vacía en base de datos)
                await CartService.CheckoutAsync(_currentUserId, new List<int>(), "");
                Snackbar.Add("¡Compra completada! Revisa WhatsApp para el recibo", Severity.Success);
            }
            else
            {
                // Si solo cerró el diálogo, avisamos que no se realizó ninguna acción
                Snackbar.Add("Acción cancelada. Tu carrito sigue igual.", Severity.Info);
            }

            // En ambos casos, refrescamos el carrito para asegurarnos de mostrar el estado real
            _cartView = await CartService.GetCartAsync(_currentUserId, _storeId);
            FilterItems();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error en PerformCheckout para usuario {UserId}", _currentUserId);
            Snackbar.Add($"Error en la compra: {ex.Message}", Severity.Error);
        }
    }
}
