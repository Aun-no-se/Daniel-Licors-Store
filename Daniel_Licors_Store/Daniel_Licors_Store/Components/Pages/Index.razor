@page "/"
@using MudBlazor
@using Daniel_Licors_Store.Models.Product
@using Daniel_Licors_Store.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization

<div class="index-page">

    <AuthorizeView>
        <NotAuthorized>
            <MudPaper Class="pa-4 ma-4" Elevation="1">
                <MudText Typo="Typo.h6">Estado: No logueado</MudText>
                <MudText Typo="Typo.subtitle1">Rol: sin rol</MudText>
            </MudPaper>
        </NotAuthorized>

        <Authorized Context="auth">
            <MudPaper Class="pa-4 ma-4" Elevation="1">
                <MudText Typo="Typo.h6">Estado: Logueado</MudText>

                <MudText Typo="Typo.subtitle1">
                    Rol:
                    @(
                                        auth.User.IsInRole("Admin") ? "Admin" :
                                        auth.User.IsInRole("Empleado") ? "Empleado" :
                                        auth.User.IsInRole("Cliente") ? "Cliente" :
                                        "sin rol"
                                        )
                </MudText>
            </MudPaper>
        </Authorized>
    </AuthorizeView>

    @if (!_loading)
    {
        <MudCarousel Class="mud-width-full promo-carousel"
                     Style="height:75vh;"
                     ShowArrows="@arrows"
                     ShowBullets="@bullets"
                     EnableSwipeGesture="@enableSwipeGesture"
                     AutoCycle="@autocycle"
                     AutoCycleInterval="16000"
                     TData="object"
                     Transition="@transition">

            <!-- SLIDE VIDEO DESKTOP / IMAGEN MOBILE -->
            <MudCarouselItem>

                <div class="hero-container">

                    <!-- VIDEO SOLO DESKTOP -->
                    <video class="hero-video"
                           autoplay
                           muted
                           loop
                           playsinline
                           preload="auto">
                        <source src="/videos/video1.mp4" type="video/mp4" />
                    </video>

                    <!-- IMAGEN SOLO MOBILE -->
                    <img src="/images/Carrusel/NOTICIA-5-portada-cerveza-1210x642-1.jpg"
                         class="hero-image"
                         alt="Promoción Daniel Licors" />

                </div>

            </MudCarouselItem>

            <!-- SLIDE NORMAL -->
            <MudCarouselItem Color="@Color.Secondary">
                <div class="carousel-content">

                    <MudIcon Icon="@Icons.Custom.Brands.MudBlazor"
                             Size="@Size.Large"
                             Class="icon-animate" />

                    <div class="actions">
                        <MudButton Class="btn-pedir"
                                   Color="Color.Error"
                                   Variant="Variant.Filled"
                                   OnClick="PedirDemo">
                            Pedir
                        </MudButton>

                        <MudButton Class="btn-ver"
                                   Variant="Variant.Outlined"
                                   OnClick="VerMasDemo">
                            Ver más
                        </MudButton>
                    </div>

                </div>
            </MudCarouselItem>

        </MudCarousel>
    }

    <!-- CATEGORÍAS -->
    <CategoryProductCarousel Title="Cervezas"
                             Products="@cervezas" />

    <CategoryProductCarousel Title="Rones"
                             Products="@rones" />

</div>