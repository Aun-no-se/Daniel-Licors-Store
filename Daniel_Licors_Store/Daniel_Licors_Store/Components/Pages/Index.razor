@page "/"
@using MudBlazor
@using Daniel_Licors_Store.Models.Product
@using Daniel_Licors_Store.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization

@if (mostrarCargando)
{
    <LoadingScreen Message="Autorizando tu acceso" Subtitle="Verificando usuario y contraseña" />
}

<button @onclick="() => mostrarCargando = true" style="margin:16px;">Ver el loading</button>

<div class="index-page">
    <!--
        AutoCycle="false" siempre — el avance automático lo maneja
        un Timer en C# que solo arranca después de que los datos
        ya cargaron. Esto elimina la race condition con el render
        inicial que causaba insertBefore on null.
    -->
    <MudCarousel @ref="_heroCarousel"
                 Class="mud-width-full promo-carousel"
                 Style="height:75vh;"
                 ShowArrows="@arrows"
                 ShowBullets="@bullets"
                 EnableSwipeGesture="@enableSwipeGesture"
                 AutoCycle="false"
                 TData="object"
                 Transition="@transition">
        <MudCarouselItem>
            <div class="hero-container">
                <dotlottie-player class="hero-lottie"
                                  src="@heroLottieUrl"
                                  background="transparent"
                                  speed="1"
                                  autoplay
                                  loop>
                </dotlottie-player>
                <div class="hero-animated-overlay"></div>
                <div class="hero-vignette"></div>
            </div>
        </MudCarouselItem>
        <MudCarouselItem Color="@Color.Secondary">
            <div class="carousel-content">
                <MudIcon Icon="@Icons.Custom.Brands.MudBlazor"
                         Size="@Size.Large"
                         Class="icon-animate" />
                <div class="actions">
                    <MudButton Class="btn-pedir"
                               Color="Color.Error"
                               Variant="Variant.Filled"
                               OnClick="PedirDemo">
                        Pedir
                    </MudButton>
                    <MudButton Class="btn-ver"
                               Variant="Variant.Outlined"
                               OnClick="VerMasDemo">
                        Ver más
                    </MudButton>
                </div>
            </div>
        </MudCarouselItem>
    </MudCarousel>
    <CategoryProductCarousel Title="Cervezas"
                             Products="@cervezas"
                             IsLoading="@_loading" />
    <CategoryProductCarousel Title="Rones"
                             Products="@rones"
                             IsLoading="@_loading" />
</div>

@code {
    // ⚠️ SOLO PARA PROBAR el LoadingScreen — bórralo cuando ya lo veas.
    private bool mostrarCargando = false;
}
