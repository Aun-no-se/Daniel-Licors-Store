@page "/login"
@using Daniel_Licors_Store.Models.Users.Auth
@using Daniel_Licors_Store.Services.Auth
@using Daniel_Licors_Store.Data.Services
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<div class="lg-page">
    <div class="lg-card">

        <!-- ── Banner ── -->
        <div class="lg-banner">
            <div class="lg-banner-grid"></div>

            <div class="lg-logo-ring">
                <span class="lg-logo-icon">🍷</span>
            </div>

            <div class="lg-banner-title">Daniel Liquor Store</div>
            <div class="lg-banner-sub">Accede al sistema con tus credenciales</div>
        </div>

        <!-- ── Loader ── -->
        <div class="lg-loader">
            @if (isLoading)
            {
                <MudProgressLinear Color="Color.Error" Indeterminate="true" Style="height:2px;" />
            }
        </div>

        <!-- ── Form ── -->
        <div class="lg-form">

            <div class="lg-form-title">Iniciar sesión</div>

            <MudTextField @bind-Value="model.Email"
                          Label="Correo electrónico"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.AlternateEmail"
                          Disabled="@isLoading"
                          FullWidth
                          Class="mb-4" />

            <MudTextField @bind-Value="model.Password"
                          Label="Contraseña"
                          Variant="Variant.Outlined"
                          InputType="@_passwordInput"
                          Adornment="Adornment.End"
                          AdornmentIcon="@_passwordIcon"
                          OnAdornmentClick="TogglePass"
                          Disabled="@isLoading"
                          FullWidth
                          Class="mb-2" />

            <MudButton Class="lg-btn"
                       OnClick="HandleLogin"
                       Disabled="@isLoading">
                @if (isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Validando...</span>
                }
                else
                {
                    <span>Entrar al sistema →</span>
                }
            </MudButton>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="lg-error">
                    <span>⚠️</span>
                    <span>@error</span>
                </div>
            }

            <div class="lg-footer">
                ¿No tienes cuenta?
                <a href="/register">Regístrate aquí</a>
            </div>

        </div>
    </div>
</div>
