@page "/login"
@using Daniel_Licors_Store.Models.Users.Auth
@using Daniel_Licors_Store.Services.Auth
@using Daniel_Licors_Store.Data.Services
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<div class="d-flex align-center justify-center signup-login-wrapper" style="min-height: 100vh; width: 100%;">
    <MudContainer MaxWidth="MaxWidth.Small" Class="my-auto">

        <MudPaper Elevation="4" Class="overflow-hidden rounded-xl backend-card-custom">

            <!-- Banner -->
            <div class="login-banner-premium d-flex flex-column align-center justify-center py-6 text-center">
                <MudIcon Icon="@Icons.Material.Filled.LocalBar" Size="Size.Large" Color="Color.Surface" Class="mb-2 logo-animate" />
                <MudText Typo="Typo.h5" Class="font-weight-black text-white uppercase tracking-wider">
                    Daniel Liquor Store
                </MudText>
                <MudText Typo="Typo.caption" Class="text-white-50 px-4">
                    Introduce tus credenciales para acceder al sistema
                </MudText>
            </div>

            <!-- Barra de carga -->
            <div class="loader-container-fixed">
                @if (isLoading)
                {
                    <MudProgressLinear Color="Color.Error" Indeterminate="true" />
                }
            </div>

            <!-- Formulario -->
            <div class="pa-8 pt-4">

                <MudText Typo="Typo.h5" Class="font-weight-bold mb-6 text-center dark-text-highlight">
                    Iniciar Sesión
                </MudText>

                <MudTextField @bind-Value="model.Email"
                              Label="Correo Electrónico"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              AdornmentColor="Color.Primary"
                              InputType="InputType.Email"
                              FullWidth
                              Disabled="@isLoading"
                              Class="mb-4" />

                <MudTextField @bind-Value="model.Password"
                              Label="Contraseña"
                              Variant="Variant.Outlined"
                              InputType="@_passwordInput"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordInputIcon"
                              AdornmentColor="Color.Primary"
                              OnAdornmentClick="TogglePasswordVisibility"
                              FullWidth
                              Disabled="@isLoading"
                              Class="mb-6" />

                <MudButton OnClick="HandleLogin"
                           Color="Color.Error"
                           Variant="Variant.Filled"
                           Size="Size.Large"
                           FullWidth
                           Disabled="@isLoading"
                           Class="py-3 btn-login-submit font-weight-bold text-transform-none">
                    @if (isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Validando credenciales...</span>
                    }
                    else
                    {
                        <span>Entrar al Sistema</span>
                    }
                </MudButton>

                @if (!string.IsNullOrEmpty(error))
                {
                    <MudAlert Severity="Severity.Error"
                              Variant="Variant.Outlined"
                              Dense="true"
                              Class="mt-4 rounded-lg">
                        @error
                    </MudAlert>
                }

                <div class="text-center mt-4">
                    <MudLink Href="/register" Color="Color.Primary" Underline="Underline.Hover" Class="text-sm">
                        ¿No tienes cuenta? Regístrate aquí
                    </MudLink>
                </div>

            </div>
        </MudPaper>
    </MudContainer>
</div>

@code {
    private LoginModel model = new();
    private string? error;
    private bool isLoading;

    private bool _passwordVisibility;
    private InputType _passwordInput = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    protected override async Task OnInitializedAsync()
    {
        // Si ya está logueado, redirigir directo al index
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
            Nav.NavigateTo("/", replace: true);
    }

    private void TogglePasswordVisibility()
    {
        _passwordVisibility = !_passwordVisibility;
        _passwordInput = _passwordVisibility ? InputType.Text : InputType.Password;
        _passwordInputIcon = _passwordVisibility
            ? Icons.Material.Filled.Visibility
            : Icons.Material.Filled.VisibilityOff;
    }

    private async Task HandleLogin()
    {
        // Validación básica antes de ir al servidor
        if (string.IsNullOrWhiteSpace(model.Email) || string.IsNullOrWhiteSpace(model.Password))
        {
            error = "Por favor ingresa tu correo y contraseña.";
            return;
        }

        error = null;
        isLoading = true;

        try
        {
            // Llamada directa al servicio — sin HttpClient, sin /api/login
            var (user, roles) = await AuthService.ValidateLoginAsync(model);

            if (user == null)
            {
                error = "El correo o la contraseña son incorrectos.";
                return;
            }

            var session = new UserSession
            {
                UserId = user.UserId,
                Email = user.Email ?? string.Empty,
                FullName = user.FullName ?? string.Empty,
                Roles = roles,
                LastActivity = DateTime.Now
            };

            var customAuth = (CustomAuthStateProvider)AuthStateProvider;
            await customAuth.MarkUserAsAuthenticated(session);

            // TODOS los usuarios van al Index — el layout se encarga
            // de mostrar u ocultar menús según el rol
            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            error = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
