@page "/producto/{ProductId:int}"

@using Daniel_Licors_Store.Data.Services
@using Daniel_Licors_Store.Models.Product
@using Daniel_Licors_Store.Models.Combo
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject ICartService CartService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-12">

    <MudButton Variant="Variant.Text"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Color="Color.Secondary"
               OnClick="@(() => Nav.NavigateTo("/"))"
               Class="mb-4 text-transform-none">
        Volver al catálogo
    </MudButton>

    @if (_loading)
    {
        <div class="d-flex justify-center align-center flex-column my-12 py-12">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.body1" Class="mt-4 muted-text">Cargando producto...</MudText>
        </div>
    }
    else if (Product != null)
    {
        <!-- ===== HERO: Imagen + Info ===== -->
        <MudGrid Spacing="6" Class="align-center justify-center">

            <MudItem xs="12" md="6" Class="d-flex justify-center justify-md-end">
                <div class="image-container-premium">
                    @if (Product.IsPremium)
                    {
                        <span class="badge-premium-floating">
                            <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Size="Size.Small" Class="mr-1" /> PREMIUM
                        </span>
                    }
                    <img src="@Product.ImageUrl" alt="@Product.Name" class="product-image-fluid" />
                </div>
            </MudItem>

            <MudItem xs="12" md="6" Class="d-flex justify-center justify-md-start">
                <div class="d-flex flex-column gap-y-4 product-info-container">

                    <div class="d-flex align-center gap-x-2">
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small" Class="font-weight-bold uppercase">@Product.Brand</MudChip>
                        <MudText Typo="Typo.caption" Class="text-uppercase tracking-wider muted-text">@Product.Category</MudText>
                    </div>

                    <MudText Typo="Typo.h3" Class="font-weight-black product-title">@Product.Name</MudText>

                    <div class="d-flex align-center mt-1">
                        @if (Product.Stock <= 0)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined"
                                      ContentAlignment="HorizontalAlignment.Left" Class="rounded-lg py-1 px-3">
                                <strong>Agotado temporalmente</strong>
                            </MudAlert>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" Variant="Variant.Outlined"
                                      ContentAlignment="HorizontalAlignment.Left" Class="rounded-lg py-1 px-3">
                                <span>Disponibles: <strong>@Product.Stock uds.</strong></span>
                            </MudAlert>
                        }
                    </div>

                    <MudDivider Class="my-2" />

                    <div class="price-container py-1">
                        <MudText Typo="Typo.h2" Color="Color.Primary" Class="font-weight-bold mb-0">
                            $@Product.Price.ToString("N2")
                        </MudText>
                        <MudText Typo="Typo.caption" Class="muted-text d-block mt-n1">Precio en tienda (Impuestos incl.)</MudText>
                    </div>

                    <div class="mt-1">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Descripción</MudText>
                        <MudText Typo="Typo.body1" Class="mt-1 product-description">@Product.Description</MudText>
                    </div>

                    <div class="actions-box mt-2">
                        <MudButton Color="Color.Error"
                                   Variant="Variant.Filled"
                                   Size="Size.Large"
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.ShoppingCart"
                                   Disabled="@(Product.Stock <= 0)"
                                   OnClick="@(() => AddToCart(Product.ProductId))"
                                   Class="py-3 btn-add-cart">
                            @(Product.Stock <= 0 ? "Sin existencias" : "Agregar al carrito")
                        </MudButton>
                    </div>

                </div>
            </MudItem>
        </MudGrid>

        <!-- ===== SECCIÓN INFERIOR: Combos | Promociones lado a lado ===== -->
        <div class="lower-wrapper mt-14">

            <!-- ══ COLUMNA COMBOS ══ -->
            <div class="lower-col">

                <div class="lower-col-header">
                    <div class="lower-col-icon lower-col-icon--red">
                        <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment"
                                 Style="font-size:20px; color:#ef5350;" />
                    </div>
                    <div>
                        <div class="lower-col-title">Combos disponibles</div>
                        <div class="lower-col-sub">Paquetes que incluyen este producto</div>
                    </div>
                </div>

                @if (Combos.Any())
                {
                    <div class="cards-stack">
                        @foreach (var combo in Combos)
                        {
                            <div class="item-card item-card--red" @onclick="@(() => Nav.NavigateTo($"/combo/{combo.ComboId}"))">

                                <!-- Imagen -->
                                <div class="item-card-img-wrap">
                                    @if (!string.IsNullOrWhiteSpace(combo.ImageUrl))
                                    {
                                        <img src="@combo.ImageUrl" alt="@combo.Name" class="item-card-img" />
                                    }
                                    else
                                    {
                                        <div class="item-card-img-placeholder item-card-img-placeholder--red">
                                            <MudIcon Icon="@Icons.Material.Filled.LocalBar"
                                                     Style="font-size:32px; color:rgba(239,83,80,0.35);" />
                                        </div>
                                    }
                                    <div class="item-card-price-pill item-card-price-pill--green">
                                        $@combo.ComboPrice.ToString("N2")
                                    </div>
                                </div>

                                <!-- Info -->
                                <div class="item-card-body">
                                    <div class="item-card-name">@combo.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(combo.Description))
                                    {
                                        <div class="item-card-desc">@combo.Description</div>
                                    }
                                </div>

                                <!-- Botones -->
                                <div class="item-card-footer" @onclick:stopPropagation="true">
                                    <button class="item-btn item-btn--red"
                                            @onclick="@(() => AddComboToCart(combo.ComboId))">
                                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart"
                                                 Size="Size.Small" Class="mr-1" />
                                        Añadir al carrito
                                    </button>
                                    <button class="item-btn-link"
                                            @onclick="@(() => Nav.NavigateTo($"/combo/{combo.ComboId}"))">
                                        Ver detalle →
                                    </button>
                                </div>

                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="lower-empty">
                        <MudIcon Icon="@Icons.Material.Filled.Inbox" Class="lower-empty-icon" />
                        <span>No hay combos activos para este producto.</span>
                    </div>
                }

            </div>

            <!-- ── Divisor vertical ── -->
            <div class="lower-vertical-divider"></div>

            <!-- ══ COLUMNA PROMOCIONES ══ -->
            <div class="lower-col">

                <div class="lower-col-header">
                    <div class="lower-col-icon lower-col-icon--orange">
                        <MudIcon Icon="@Icons.Material.Filled.LocalOffer"
                                 Style="font-size:20px; color:#ff9800;" />
                    </div>
                    <div>
                        <div class="lower-col-title">Promociones especiales</div>
                        <div class="lower-col-sub">Ofertas exclusivas vigentes ahora mismo</div>
                    </div>
                </div>

                @if (Promotions.Any())
                {
                    <div class="cards-stack">
                        @foreach (var promo in Promotions)
                        {
                            <div class="item-card item-card--orange">

                                <!-- Imagen de la promo -->
                                <div class="item-card-img-wrap">
                                    @if (!string.IsNullOrWhiteSpace(promo.ImageUrl))
                                    {
                                        <img src="@promo.ImageUrl" alt="@promo.Title" class="item-card-img" />
                                    }
                                    else
                                    {
                                        <div class="item-card-img-placeholder item-card-img-placeholder--orange">
                                            <MudIcon Icon="@Icons.Material.Filled.LocalOffer"
                                                     Style="font-size:32px; color:rgba(255,152,0,0.35);" />
                                        </div>
                                    }
                                    <!-- Badge tipo -->
                                    <div class="item-card-type-badge item-card-type-badge--@(promo.IsPayXGetY ? "green" : promo.HasDiscount ? "red" : "orange")">
                                        @promo.BadgeLabel
                                    </div>
                                </div>

                                <!-- Info -->
                                <div class="item-card-body">
                                    <div class="item-card-name">@promo.Title</div>
                                    @if (!string.IsNullOrWhiteSpace(promo.Description))
                                    {
                                        <div class="item-card-desc">@promo.Description</div>
                                    }

                                    <!-- Oferta destacada -->
                                    <div class="promo-offer-box">
                                        @if (promo.HasDiscount && Product != null)
                                        {
                                            var discounted = Product.Price * (1 - promo.DiscountPercentage!.Value / 100);
                                            <span class="promo-price-original">$@Product.Price.ToString("N2")</span>
                                            <span class="promo-price-new">$@discounted.ToString("N2")</span>
                                            <span class="promo-badge-pill promo-badge-pill--red">-@promo.DiscountPercentage.Value.ToString("0.##")%</span>
                                        }
                                        else if (promo.HasSpecialPrice && Product != null)
                                        {
                                            <span class="promo-price-original">$@Product.Price.ToString("N2")</span>
                                            <span class="promo-price-new">$@promo.SpecialPrice!.Value.ToString("N2")</span>
                                            <span class="promo-badge-pill promo-badge-pill--orange">Especial</span>
                                        }
                                        else if (promo.IsPayXGetY)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.CardGiftcard"
                                                     Style="font-size:22px; color:#66bb6a;" Class="mr-1" />
                                            <span class="promo-pxgy-text">
                                                Lleva @promo.RequiredQuantity · Paga @promo.PayQuantity
                                            </span>
                                        }
                                    </div>

                                    <div class="promo-validity">
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />
                                        Válido hasta @promo.EndDate.ToString("dd MMM yyyy")
                                    </div>
                                </div>

                                <!-- Botón carrito -->
                                <div class="item-card-footer">
                                    <button class="item-btn item-btn--orange"
                                            @onclick="@(() => AddPromotionToCart(promo))">
                                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart"
                                                 Size="Size.Small" Class="mr-1" />
                                        Añadir al carrito
                                    </button>
                                </div>

                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="lower-empty">
                        <MudIcon Icon="@Icons.Material.Filled.NotificationsOff" Class="lower-empty-icon" />
                        <span>Sin promociones activas. ¡Vuelve pronto!</span>
                    </div>
                }

            </div>

        </div>
    }
    else
    {
        <div class="d-flex justify-center align-center flex-column my-12 py-12">
            <MudIcon Icon="@Icons.Material.Filled.HeartBroken" Size="Size.Large" Color="Color.Error" />
            <MudText Typo="Typo.h5" Class="mt-4 font-weight-bold">El producto no existe</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3"
                       OnClick="@(() => Nav.NavigateTo("/"))">
                Regresar al Inicio
            </MudButton>
        </div>
    }

</MudContainer>

<style>
    /* ══════════════════════════════════
           HERO
        ══════════════════════════════════ */
    .image-container-premium {
        position: relative;
        width: 400px;
        height: 400px;
        background: #ffffff;
        border-radius: 24px;
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 0 15px 35px rgba(0,0,0,0.4);
        border: 1px solid rgba(255,255,255,0.08);
        overflow: hidden;
    }

    .product-info-container {
        width: 100%;
        max-width: 450px;
    }

    .product-image-fluid {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        transition: transform 0.4s cubic-bezier(0.25,1,0.5,1);
    }

    .image-container-premium:hover .product-image-fluid {
        transform: scale(1.06);
    }

    .badge-premium-floating {
        position: absolute;
        top: 16px;
        left: 16px;
        background: linear-gradient(135deg,#b38728,#fbf5b7,#daa520,#aa771c);
        color: #1a1a1a;
        font-weight: 800;
        font-size: 0.75rem;
        padding: 6px 12px;
        border-radius: 30px;
        display: inline-flex;
        align-items: center;
        box-shadow: 0 4px 10px rgba(179,135,40,0.3);
        letter-spacing: 1px;
        z-index: 2;
    }

    .product-title {
        color: #ffffff;
        line-height: 1.2;
    }

    .muted-text {
        color: #a1a1aa !important;
    }

    .product-description {
        color: #d4d4d8;
        line-height: 1.6;
        font-size: 1.05rem;
    }

    .btn-add-cart {
        font-weight: 700 !important;
        font-size: 1.1rem !important;
        letter-spacing: 0.5px;
        border-radius: 12px !important;
        text-transform: none !important;
        box-shadow: 0 6px 20px rgba(244,67,54,0.25) !important;
        transition: all 0.2s ease !important;
    }

        .btn-add-cart:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(244,67,54,0.4) !important;
        }

    .text-transform-none {
        text-transform: none !important;
    }

    .uppercase {
        text-transform: uppercase;
    }

    .tracking-wider {
        letter-spacing: 1px;
    }

    /* ══════════════════════════════════
           LOWER SECTION — LAYOUT 2 COLUMNAS
        ══════════════════════════════════ */
    .lower-wrapper {
        display: flex;
        gap: 0;
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 20px;
        overflow: hidden;
        background: rgba(255,255,255,0.02);
        align-items: flex-start;
    }

    .lower-col {
        flex: 1;
        min-width: 0;
        padding: 28px;
    }

    .lower-vertical-divider {
        width: 1px;
        background: linear-gradient(180deg, transparent, rgba(255,255,255,0.08), transparent);
        align-self: stretch;
        flex-shrink: 0;
    }

    /* ── Header de columna ── */
    .lower-col-header {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 20px;
    }

    .lower-col-icon {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .lower-col-icon--red {
        background: rgba(239,83,80,0.12);
    }

    .lower-col-icon--orange {
        background: rgba(255,152,0,0.12);
    }

    .lower-col-title {
        font-size: 17px;
        font-weight: 700;
        color: #fff;
        line-height: 1.2;
    }

    .lower-col-sub {
        font-size: 11px;
        color: #71717a;
        margin-top: 3px;
    }

    /* ── Empty state ── */
    .lower-empty {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 18px 20px;
        border: 1.5px dashed rgba(255,255,255,0.08);
        border-radius: 12px;
        color: #52525b;
        font-size: 13px;
    }

    .lower-empty-icon {
        font-size: 22px !important;
        color: #3f3f46 !important;
    }

    /* ── Stack de cards ── */
    .cards-stack {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    /* ══════════════════════════════════
           ITEM CARD (combo y promo comparten base)
        ══════════════════════════════════ */
    .item-card {
        background: rgba(255,255,255,0.03);
        border-radius: 14px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        border: 1.5px solid rgba(255,255,255,0.07);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
        cursor: pointer;
    }

    .item-card--red:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 28px rgba(239,83,80,0.15);
        border-color: rgba(239,83,80,0.35);
    }

    .item-card--orange:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 28px rgba(255,152,0,0.15);
        border-color: rgba(255,152,0,0.35);
    }

    /* ── Imagen de la card ── */
    .item-card-img-wrap {
        position: relative;
        width: 100%;
        aspect-ratio: 16/7;
        overflow: hidden;
        flex-shrink: 0;
    }

    .item-card-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .item-card:hover .item-card-img {
        transform: scale(1.05);
    }

    .item-card-img-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .item-card-img-placeholder--red {
        background: rgba(239,83,80,0.06);
    }

    .item-card-img-placeholder--orange {
        background: rgba(255,152,0,0.06);
    }

    /* Precio pill (combos) */
    .item-card-price-pill {
        position: absolute;
        bottom: 8px;
        right: 8px;
        font-size: 13px;
        font-weight: 800;
        padding: 4px 10px;
        border-radius: 20px;
        backdrop-filter: blur(6px);
    }

    .item-card-price-pill--green {
        background: rgba(76,175,80,0.88);
        color: #fff;
    }

    /* Badge tipo (promociones) */
    .item-card-type-badge {
        position: absolute;
        top: 8px;
        left: 8px;
        font-size: 10px;
        font-weight: 800;
        padding: 3px 9px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        backdrop-filter: blur(6px);
    }

    .item-card-type-badge--red {
        background: rgba(229,57,53,0.85);
        color: #fff;
    }

    .item-card-type-badge--orange {
        background: rgba(255,152,0,0.85);
        color: #1a1a1a;
    }

    .item-card-type-badge--green {
        background: rgba(76,175,80,0.85);
        color: #fff;
    }

    /* ── Cuerpo ── */
    .item-card-body {
        padding: 12px 14px 8px;
        flex-grow: 1;
    }

    .item-card-name {
        font-size: 14px;
        font-weight: 700;
        color: #fff;
        line-height: 1.3;
        margin-bottom: 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .item-card-desc {
        font-size: 11px;
        color: #71717a;
        margin-bottom: 8px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* ── Oferta promo ── */
    .promo-offer-box {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        background: rgba(0,0,0,0.2);
        border-radius: 8px;
        padding: 8px 12px;
        margin-bottom: 8px;
    }

    .promo-price-original {
        font-size: 12px;
        color: #71717a;
        text-decoration: line-through;
    }

    .promo-price-new {
        font-size: 18px;
        font-weight: 800;
        color: #66bb6a;
    }

    .promo-badge-pill {
        font-size: 10px;
        font-weight: 800;
        padding: 2px 7px;
        border-radius: 20px;
    }

    .promo-badge-pill--red {
        background: rgba(229,57,53,0.2);
        color: #ef9a9a;
    }

    .promo-badge-pill--orange {
        background: rgba(255,152,0,0.2);
        color: #ffcc80;
    }

    .promo-pxgy-text {
        font-size: 14px;
        font-weight: 800;
        color: #66bb6a;
    }

    .promo-validity {
        display: flex;
        align-items: center;
        font-size: 10px;
        color: #52525b;
        margin-top: 4px;
    }

    /* ── Footer con botones ── */
    .item-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 14px 12px;
        gap: 8px;
        border-top: 1px solid rgba(255,255,255,0.05);
    }

    .item-btn {
        display: inline-flex;
        align-items: center;
        font-size: 11px;
        font-weight: 700;
        padding: 5px 10px;
        border-radius: 7px;
        cursor: pointer;
        transition: background 0.15s, transform 0.12s;
        white-space: nowrap;
        border: 1px solid;
    }

    .item-btn--red {
        background: rgba(239,83,80,0.15);
        border-color: rgba(239,83,80,0.3);
        color: #ef5350;
    }

        .item-btn--red:hover {
            background: rgba(239,83,80,0.28);
            transform: scale(1.03);
        }

    .item-btn--orange {
        background: rgba(255,152,0,0.15);
        border-color: rgba(255,152,0,0.3);
        color: #ff9800;
    }

        .item-btn--orange:hover {
            background: rgba(255,152,0,0.28);
            transform: scale(1.03);
        }

    .item-btn-link {
        background: transparent;
        border: none;
        color: #71717a;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        padding: 5px 4px;
        transition: color 0.15s;
        white-space: nowrap;
    }

        .item-btn-link:hover {
            color: #d4d4d8;
        }

    /* ══════════════════════════════════
           RESPONSIVE
        ══════════════════════════════════ */
    @@media (max-width: 768px) {
        .lower-wrapper {
            flex-direction: column;
        }

        .lower-vertical-divider {
            width: auto;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
        }

        .lower-col {
            padding: 20px 16px;
        }

        .image-container-premium {
            width: 100%;
            height: 260px;
        }
    }
</style>
