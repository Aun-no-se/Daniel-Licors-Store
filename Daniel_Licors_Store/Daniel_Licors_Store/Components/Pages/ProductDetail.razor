@page "/producto/{ProductId:int}"

@using Daniel_Licors_Store.Data.Services
@using Daniel_Licors_Store.Models.Product
@using Daniel_Licors_Store.Models.Combo
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject ICartService CartService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<div class="pd-page-bg">
    <div class="pd-glow pd-glow-crimson"></div>
    <div class="pd-glow pd-glow-gold"></div>

    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 mb-8 pd-page-content">

        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Nav.NavigateTo("/"))"
                   Class="mb-4 text-transform-none pd-btn-back">
            Volver al catálogo
        </MudButton>

        @if (_loading)
        {
            <div class="d-flex justify-center align-center flex-column my-12 py-12">
                <MudProgressCircular Color="Color.Error" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.body1" Class="mt-4 pd-muted-text">Cargando producto...</MudText>
            </div>
        }
        else if (Product != null)
        {
            <!-- ===== HERO: Imagen + Info ===== -->
            <MudGrid Spacing="4" Class="align-center justify-center">

                <MudItem xs="12" md="6" Class="d-flex justify-center justify-md-end">
                    <div class="pd-image-frame">
                        @if (Product.IsPremium)
                        {
                            <span class="pd-badge-premium">
                                <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Size="Size.Small" Class="mr-1" /> PREMIUM
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Product.ImageUrl))
                        {
                            <img src="@Product.ImageUrl" alt="@Product.Name" class="pd-image" />
                        }
                        else
                        {
                            <div class="pd-image-placeholder">
                                <MudIcon Icon="@Icons.Material.Filled.LocalBar" Class="pd-image-placeholder-icon" />
                            </div>
                        }
                    </div>
                </MudItem>

                <MudItem xs="12" md="6" Class="d-flex justify-center justify-md-start">
                    <div class="d-flex flex-column gap-y-3 pd-info-container">

                        <div class="d-flex align-center gap-x-2 flex-wrap">
                            @if (!string.IsNullOrWhiteSpace(Product.Brand))
                            {
                                <span class="pd-brand-chip">@Product.Brand</span>
                            }
                            <span class="pd-category-text">@Product.Category</span>
                        </div>

                        <MudText Typo="Typo.h3" Class="font-weight-black pd-title">@Product.Name</MudText>

                        <div class="d-flex align-center mt-1">
                            @if (Product.Stock <= 0)
                            {
                                <span class="pd-stock-pill pd-stock-pill--out">
                                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Class="mr-1" />
                                    Agotado temporalmente
                                </span>
                            }
                            else
                            {
                                <span class="pd-stock-pill pd-stock-pill--in">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                                    Disponibles: <strong class="ml-1">@Product.Stock uds.</strong>
                                </span>
                            }
                        </div>

                        <div class="pd-divider my-2"></div>

                        <div class="pd-price-container py-1">
                            <MudText Typo="Typo.h2" Class="font-weight-bold mb-0 pd-price">
                                $@Product.Price.ToString("N2")
                            </MudText>
                            <MudText Typo="Typo.caption" Class="pd-muted-text d-block mt-n1">Precio en tienda (impuestos incl.)</MudText>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Product.Description))
                        {
                            <div class="mt-1">
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold pd-desc-label">Descripción</MudText>
                                <MudText Typo="Typo.body1" Class="mt-1 pd-description">@Product.Description</MudText>
                            </div>
                        }

                        <div class="pd-actions-box mt-2">
                            <MudButton Variant="Variant.Filled"
                                       Size="Size.Large"
                                       FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.ShoppingCart"
                                       Disabled="@(Product.Stock <= 0)"
                                       OnClick="@(() => AddToCart(Product.ProductId))"
                                       Class="py-3 pd-btn-add-cart">
                                @(Product.Stock <= 0 ? "Sin existencias" : "Agregar al carrito")
                            </MudButton>
                        </div>

                    </div>
                </MudItem>
            </MudGrid>

            <!-- ===== SECCIÓN INFERIOR: Combos | Promociones lado a lado ===== -->
            <div class="pd-lower-wrapper mt-8">

                <!-- ══ COLUMNA COMBOS ══ -->
                <div class="pd-lower-col">

                    <div class="pd-lower-col-header">
                        <div class="pd-lower-col-icon pd-lower-col-icon--gold">
                            <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Class="pd-lower-col-icon-svg pd-lower-col-icon-svg--gold" />
                        </div>
                        <div>
                            <div class="pd-lower-col-title">Combos disponibles</div>
                            <div class="pd-lower-col-sub">Paquetes que incluyen este producto</div>
                        </div>
                    </div>

                    @if (Combos.Any())
                    {
                        <div class="pd-cards-stack">
                            @foreach (var combo in Combos)
                            {
                                <div class="pd-item-card pd-item-card--gold" @onclick="@(() => Nav.NavigateTo($"/combo/{combo.ComboId}"))">

                                    <div class="pd-item-img-wrap">
                                        @if (!string.IsNullOrWhiteSpace(combo.ImageUrl))
                                        {
                                            <img src="@combo.ImageUrl" alt="@combo.Name" class="pd-item-img" />
                                        }
                                        else
                                        {
                                            <div class="pd-item-img-placeholder pd-item-img-placeholder--gold">
                                                <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Class="pd-item-placeholder-svg" />
                                            </div>
                                        }
                                        <div class="pd-item-price-pill">
                                            $@combo.ComboPrice.ToString("N2")
                                        </div>
                                    </div>

                                    <div class="pd-item-body">
                                        <div class="pd-item-name">@combo.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(combo.Description))
                                        {
                                            <div class="pd-item-desc">@combo.Description</div>
                                        }
                                    </div>

                                    <div class="pd-item-footer" @onclick:stopPropagation="true">
                                        <button class="pd-item-btn pd-item-btn--gold"
                                                @onclick="@(() => AddComboToCart(combo.ComboId))">
                                            <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small" Class="mr-1" />
                                            Añadir
                                        </button>
                                        <button class="pd-item-link"
                                                @onclick="@(() => Nav.NavigateTo($"/combo/{combo.ComboId}"))">
                                            Ver detalle →
                                        </button>
                                    </div>

                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="pd-empty-state">
                            <MudIcon Icon="@Icons.Material.Filled.Inbox" Class="pd-empty-icon" />
                            <span>No hay combos activos para este producto.</span>
                        </div>
                    }

                </div>

                <!-- ── Divisor vertical ── -->
                <div class="pd-vertical-divider"></div>

                <!-- ══ COLUMNA PROMOCIONES ══ -->
                <div class="pd-lower-col">

                    <div class="pd-lower-col-header">
                        <div class="pd-lower-col-icon pd-lower-col-icon--crimson">
                            <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Class="pd-lower-col-icon-svg pd-lower-col-icon-svg--crimson" />
                        </div>
                        <div>
                            <div class="pd-lower-col-title">Promociones especiales</div>
                            <div class="pd-lower-col-sub">Ofertas exclusivas vigentes ahora mismo</div>
                        </div>
                    </div>

                    @if (Promotions.Any())
                    {
                        <div class="pd-cards-stack">
                            @foreach (var promo in Promotions)
                            {
                                var expanded = IsPromoExpanded(promo.PromotionId);
                                <div class="pd-item-card pd-item-card--crimson">

                                    <div class="pd-item-img-wrap">
                                        @if (!string.IsNullOrWhiteSpace(promo.ImageUrl))
                                        {
                                            <img src="@promo.ImageUrl" alt="@promo.Title" class="pd-item-img" />
                                        }
                                        else
                                        {
                                            <div class="pd-item-img-placeholder pd-item-img-placeholder--crimson">
                                                <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Class="pd-item-placeholder-svg" />
                                            </div>
                                        }
                                        <div class="pd-item-type-badge">
                                            @promo.BadgeLabel
                                        </div>
                                    </div>

                                    <div class="pd-item-body">
                                        <div class="pd-item-name">@promo.Title</div>
                                        @if (!string.IsNullOrWhiteSpace(promo.Description))
                                        {
                                            <div class="pd-item-desc">@promo.Description</div>
                                        }

                                        <div class="pd-promo-offer-box">
                                            @if (promo.HasDiscount && Product != null)
                                            {
                                                var discounted = Product.Price * (1 - promo.DiscountPercentage!.Value / 100);
                                                <span class="pd-promo-price-original">$@Product.Price.ToString("N2")</span>
                                                <span class="pd-promo-price-new">$@discounted.ToString("N2")</span>
                                                <span class="pd-promo-pill">-@promo.DiscountPercentage.Value.ToString("0.##")%</span>
                                            }
                                            else if (promo.HasSpecialPrice && Product != null)
                                            {
                                                <span class="pd-promo-price-original">$@Product.Price.ToString("N2")</span>
                                                <span class="pd-promo-price-new">$@promo.SpecialPrice!.Value.ToString("N2")</span>
                                                <span class="pd-promo-pill">Especial</span>
                                            }
                                            else if (promo.IsPayXGetY)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Class="pd-pxgy-icon" />
                                                <span class="pd-pxgy-text">
                                                    Lleva @promo.RequiredQuantity · Paga @promo.PayQuantity
                                                </span>
                                            }
                                        </div>

                                        <div class="pd-promo-validity">
                                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />
                                            Válido hasta @promo.EndDate.ToString("dd MMM yyyy")
                                        </div>

                                        <!-- Panel expandible de detalle -->
                                        <div class="pd-promo-detail-panel @(expanded ? "pd-promo-detail-panel--open" : "")">
                                            <div class="pd-promo-detail-inner">
                                                <div class="pd-promo-detail-row">
                                                    <MudIcon Icon="@Icons.Material.Filled.Sell" Size="Size.Small" Class="mr-2" />
                                                    <span>Tipo: <strong>@(promo.PromotionType ?? "Promoción general")</strong></span>
                                                </div>
                                                <div class="pd-promo-detail-row">
                                                    <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Small" Class="mr-2" />
                                                    <span>Vigente desde @promo.StartDate.ToString("dd MMM yyyy") hasta @promo.EndDate.ToString("dd MMM yyyy")</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="pd-item-footer">
                                        <button class="pd-item-btn pd-item-btn--crimson"
                                                @onclick="@(() => AddPromotionToCart(promo))">
                                            <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Small" Class="mr-1" />
                                            Añadir
                                        </button>
                                        <button class="pd-item-link pd-item-link--toggle @(expanded ? "pd-item-link--toggle-open" : "")"
                                                @onclick="@(() => TogglePromoDetail(promo.PromotionId))">
                                            Ver detalle
                                            <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Class="pd-chevron" />
                                        </button>
                                    </div>

                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="pd-empty-state">
                            <MudIcon Icon="@Icons.Material.Filled.NotificationsOff" Class="pd-empty-icon" />
                            <span>Sin promociones activas. ¡Vuelve pronto!</span>
                        </div>
                    }

                </div>

            </div>
        }
        else
        {
            <div class="d-flex justify-center align-center flex-column my-12 py-12">
                <MudIcon Icon="@Icons.Material.Filled.HeartBroken" Class="pd-notfound-icon" />
                <MudText Typo="Typo.h5" Class="mt-4 font-weight-bold pd-notfound-title">El producto no existe</MudText>
                <MudButton Variant="Variant.Filled" Class="mt-3 pd-btn-add-cart"
                           OnClick="@(() => Nav.NavigateTo("/"))">
                    Regresar al inicio
                </MudButton>
            </div>
        }

    </MudContainer>
</div>

<style>
    :root {
        --pd-crimson: #FF1744;
        --pd-crimson-dark: #B71C1C;
        --pd-crimson-glow: rgba(255,23,68,0.35);
        --pd-gold-1: #b38728;
        --pd-gold-2: #fbf5b7;
        --pd-gold-3: #daa520;
        --pd-gold-4: #aa771c;
        --pd-gold-solid: #E8C468;
        --pd-surface: rgba(255,255,255,0.045);
        --pd-surface-2: rgba(255,255,255,0.03);
        --pd-border: rgba(255,255,255,0.09);
        --pd-text-muted: #a1a1aa;
        --pd-text-dim: #71717a;
    }

    /* ══════════ FONDO ══════════ */
    .pd-page-bg {
        position: relative;
        min-height: 100vh;
        background: radial-gradient(ellipse at top, #140707 0%, #0a0505 55%, #050303 100%);
        overflow: hidden;
    }

    .pd-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        pointer-events: none;
        opacity: 0.26;
        z-index: 0;
        animation: pdFloat 14s ease-in-out infinite;
    }

    .pd-glow-crimson {
        width: 460px;
        height: 460px;
        top: -140px;
        right: -120px;
        background: radial-gradient(circle, var(--pd-crimson) 0%, transparent 70%);
    }

    .pd-glow-gold {
        width: 400px;
        height: 400px;
        bottom: 10%;
        left: -120px;
        background: radial-gradient(circle, var(--pd-gold-3) 0%, transparent 70%);
        animation-delay: -7s;
    }

    @@keyframes pdFloat {
        0%, 100% {
            transform: translate(0,0) scale(1);
        }

        50% {
            transform: translate(-25px, 25px) scale(1.08);
        }
    }

    .pd-page-content {
        position: relative;
        z-index: 1;
    }

    .pd-btn-back {
        color: rgba(255,255,255,0.65) !important;
        transition: color 0.2s ease;
    }

        .pd-btn-back:hover {
            color: var(--pd-crimson) !important;
        }

    .pd-muted-text {
        color: var(--pd-text-muted) !important;
    }

    /* ══════════ IMAGEN HERO ══════════ */
    .pd-image-frame {
        position: relative;
        width: 280px;
        height: 280px;
        max-width: 100%;
        background: linear-gradient(150deg, #1a0a0a, #100808);
        border-radius: 24px;
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 0 16px 40px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.08);
        overflow: hidden;
        animation: pdFadeUp 0.55s ease both;
    }

    .pd-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
        padding: 18px;
        transition: transform 0.45s cubic-bezier(0.25,1,0.5,1);
        image-rendering: -webkit-optimize-contrast;
    }

    .pd-image-frame:hover .pd-image {
        transform: scale(1.06);
    }

    .pd-image-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .pd-image-placeholder-icon {
        font-size: 4rem !important;
        opacity: 0.15;
        color: #fff;
    }

    .pd-badge-premium {
        position: absolute;
        top: 16px;
        left: 16px;
        background: linear-gradient(135deg, var(--pd-gold-1), var(--pd-gold-2), var(--pd-gold-3), var(--pd-gold-4));
        color: #1a1005;
        font-weight: 800;
        font-size: 0.75rem;
        padding: 6px 14px;
        border-radius: 30px;
        display: inline-flex;
        align-items: center;
        box-shadow: 0 4px 14px rgba(179,135,40,0.4);
        letter-spacing: 1px;
        z-index: 2;
    }

    /* ══════════ INFO DEL PRODUCTO ══════════ */
    .pd-info-container {
        width: 100%;
        max-width: 460px;
        animation: pdFadeUp 0.55s ease both;
        animation-delay: 0.06s;
    }

    .pd-brand-chip {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        padding: 4px 12px;
        border-radius: 20px;
        color: var(--pd-crimson);
        background: rgba(255,23,68,0.12);
        border: 1px solid rgba(255,23,68,0.28);
    }

    .pd-category-text {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--pd-text-muted);
    }

    .pd-title {
        color: #fff;
        line-height: 1.15;
    }

    .pd-stock-pill {
        display: inline-flex;
        align-items: center;
        font-size: 13px;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 30px;
        border: 1px solid;
    }

    .pd-stock-pill--in {
        color: #7be3a0;
        background: rgba(76,175,80,0.1);
        border-color: rgba(76,175,80,0.3);
    }

    .pd-stock-pill--out {
        color: #ff8fa3;
        background: rgba(255,23,68,0.1);
        border-color: rgba(255,23,68,0.3);
    }

    .pd-divider {
        border-top: 1px solid rgba(255,255,255,0.1);
    }

    .pd-price-container {
        display: flex;
        flex-direction: column;
    }

    .pd-price {
        background: linear-gradient(135deg, var(--pd-gold-2) 10%, var(--pd-gold-solid) 60%, var(--pd-gold-4) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .pd-desc-label {
        color: #fff;
    }

    .pd-description {
        color: #d4d4d8;
        line-height: 1.6;
        font-size: 1.02rem;
    }

    .pd-btn-add-cart {
        background: linear-gradient(135deg, var(--pd-crimson), var(--pd-crimson-dark)) !important;
        color: #fff !important;
        font-weight: 700 !important;
        font-size: 1.05rem !important;
        letter-spacing: 0.4px;
        border-radius: 14px !important;
        text-transform: none !important;
        box-shadow: 0 8px 24px rgba(255,23,68,0.3) !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease !important;
    }

        .pd-btn-add-cart:hover:not(.mud-disabled) {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(255,23,68,0.45) !important;
        }

    /* ══════════ SECCIÓN INFERIOR ══════════ */
    .pd-lower-wrapper {
        display: flex;
        gap: 0;
        border: 1px solid var(--pd-border);
        border-radius: 22px;
        overflow: hidden;
        background: var(--pd-surface);
        backdrop-filter: blur(14px);
        align-items: flex-start;
        animation: pdFadeUp 0.55s ease both;
        animation-delay: 0.12s;
    }

    .pd-lower-col {
        flex: 1;
        min-width: 0;
        padding: 20px;
    }

    .pd-vertical-divider {
        width: 1px;
        background: linear-gradient(180deg, transparent, rgba(255,255,255,0.1), transparent);
        align-self: stretch;
        flex-shrink: 0;
    }

    .pd-lower-col-header {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 14px;
    }

    .pd-lower-col-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .pd-lower-col-icon--gold {
        background: rgba(218,165,32,0.12);
    }

    .pd-lower-col-icon--crimson {
        background: rgba(255,23,68,0.12);
    }

    .pd-lower-col-icon-svg--gold {
        color: var(--pd-gold-solid) !important;
    }

    .pd-lower-col-icon-svg--crimson {
        color: var(--pd-crimson) !important;
    }

    .pd-lower-col-title {
        font-size: 17px;
        font-weight: 700;
        color: #fff;
        line-height: 1.2;
    }

    .pd-lower-col-sub {
        font-size: 11px;
        color: var(--pd-text-dim);
        margin-top: 3px;
    }

    /* ── Estado vacío ── */
    .pd-empty-state {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 18px 20px;
        border: 1.5px dashed rgba(255,255,255,0.1);
        border-radius: 14px;
        color: var(--pd-text-dim);
        font-size: 13px;
    }

    .pd-empty-icon {
        font-size: 22px !important;
        color: #3f3f46 !important;
    }

    /* ── Stack de cards ── */
    .pd-cards-stack {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    /* ══════════ ITEM CARD ══════════ */
    .pd-item-card {
        background: var(--pd-surface-2);
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        border: 1px solid var(--pd-border);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, background 0.2s ease;
        cursor: pointer;
        animation: pdCardIn 0.4s cubic-bezier(0.16,1,0.3,1) both;
    }

    .pd-item-card--gold:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(218,165,32,0.16);
        border-color: rgba(218,165,32,0.4);
        background: rgba(218,165,32,0.04);
    }

    .pd-item-card--crimson {
        cursor: default;
    }

        .pd-item-card--crimson:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(255,23,68,0.16);
            border-color: rgba(255,23,68,0.4);
            background: rgba(255,23,68,0.04);
        }

    @@keyframes pdCardIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .pd-item-img-wrap {
        position: relative;
        width: 100%;
        height: 150px;
        overflow: hidden;
        flex-shrink: 0;
    }

    .pd-item-img {
        width: 100%;
        height: 100%;
