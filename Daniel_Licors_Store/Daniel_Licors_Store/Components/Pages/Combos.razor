@page "/admin/combos"
@attribute [Authorize(Roles = "Admin,Empleado")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Daniel_Licors_Store.Models.Combo
@using Daniel_Licors_Store.Models.Product
@using MudBlazor

<style>
    /* ── Variables ─────────────────────────────────────────────── */
    :root {
        --cb-orange: #FF9800;
        --cb-orange-dim: rgba(255,152,0,0.14);
        --cb-orange-border: rgba(255,152,0,0.28);
        --cb-bg: rgba(10,10,10,0.97);
        --cb-surface: rgba(255,255,255,0.035);
        --cb-border: rgba(255,255,255,0.08);
    }

    /* ── Page ───────────────────────────────────────────────────── */
    .cb-page {
        padding: 1.25rem 1rem 4rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* ── Header ─────────────────────────────────────────────────── */
    .cb-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .85rem;
        margin-bottom: 1.75rem;
    }

    .cb-header-left {
        display: flex;
        align-items: center;
        gap: .75rem;
    }

    .cb-header-accent {
        width: 4px;
        height: 34px;
        border-radius: 4px;
        background: linear-gradient(180deg, var(--cb-orange), #e65100);
        box-shadow: 0 0 12px rgba(255,152,0,.45);
    }

    .cb-page-title {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: #fff;
    }

    .cb-page-sub {
        margin: 0;
        font-size: .78rem;
        color: rgba(255,255,255,.4);
    }

    .cb-btn-new {
        background: linear-gradient(135deg, var(--cb-orange), #e65100) !important;
        color: #fff !important;
        border-radius: 10px !important;
        text-transform: none !important;
        font-weight: 700 !important;
        padding: 0 22px !important;
        height: 40px !important;
        box-shadow: 0 4px 16px rgba(255,152,0,.3) !important;
    }

        .cb-btn-new:hover {
            filter: brightness(1.1) !important;
            transform: translateY(-1px) !important;
        }

    /* ── Tabla ──────────────────────────────────────────────────── */
    .cb-table-wrap {
        background: rgba(255,255,255,.025);
        border: 1px solid var(--cb-border);
        border-radius: 14px;
        overflow: hidden;
    }

    .cb-table {
        width: 100%;
        border-collapse: collapse;
    }

        .cb-table thead tr {
            background: rgba(255,152,0,.07);
            border-bottom: 1px solid var(--cb-orange-border);
        }

        .cb-table th {
            padding: .65rem 1rem;
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: 1.1px;
            text-transform: uppercase;
            color: rgba(255,152,0,.85);
            text-align: left;
        }

        .cb-table td {
            padding: .7rem 1rem;
            font-size: .82rem;
            color: rgba(255,255,255,.82);
            border-bottom: 1px solid rgba(255,255,255,.05);
            vertical-align: middle;
        }

        .cb-table tbody tr:last-child td {
            border-bottom: none;
        }

        .cb-table tbody tr:hover td {
            background: rgba(255,255,255,.03);
        }

    .cb-thumb {
        width: 44px;
        height: 44px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid var(--cb-border);
    }

    .cb-thumb-placeholder {
        width: 44px;
        height: 44px;
        border-radius: 8px;
        background: var(--cb-orange-dim);
        border: 1px dashed var(--cb-orange-border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
    }

    .cb-price-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 700;
        background: rgba(255,152,0,.12);
        color: #ffb74d;
    }

    .cb-actions {
        display: flex;
        gap: .25rem;
    }

    /* ── Empty ──────────────────────────────────────────────────── */
    .cb-empty {
        text-align: center;
        padding: 4rem 1rem;
        color: rgba(255,255,255,.3);
    }

    .cb-empty-icon {
        font-size: 3rem !important;
        margin-bottom: .75rem;
    }

    /* ═══════════════════════════════════════════════════════════════
       FORMULARIO — dark glassmorphism (mismo estilo ProductDialog)
       ══════════════════════════════════════════════════════════════ */
    .cb-form-wrap {
        margin-top: 2rem;
        background: rgba(10,10,10,.96);
        border: 1px solid var(--cb-orange-border);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 32px 80px rgba(0,0,0,.8), 0 0 0 1px rgba(255,255,255,.04);
        animation: cb-slide-up .35s cubic-bezier(.22,1,.36,1);
    }

    @@keyframes cb-slide-up {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Header del form */
    .cb-form-header {
        padding: 20px 24px 16px;
        background: linear-gradient(135deg, #1a0a00 0%, #0d0d0d 60%);
        border-bottom: 1px solid var(--cb-orange-border);
        position: relative;
        overflow: hidden;
    }

        .cb-form-header::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 0% 50%, rgba(255,152,0,.1) 0%, transparent 70%);
            pointer-events: none;
        }

    .cb-form-header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .cb-form-accent {
        width: 4px;
        height: 26px;
        border-radius: 4px;
        flex-shrink: 0;
        background: linear-gradient(180deg, var(--cb-orange), #e65100);
        box-shadow: 0 0 12px rgba(255,152,0,.5);
    }

    .cb-form-title {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 700;
        color: #fff;
    }

    .cb-form-subtitle {
        margin: 0;
        font-size: .72rem;
        color: rgba(255,255,255,.4);
        margin-top: 2px;
    }

    .cb-form-badge {
        font-size: .62rem;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        padding: 3px 10px;
        border-radius: 20px;
        border: 1px solid;
    }

    .cb-badge-new {
        color: #4caf50;
        border-color: rgba(76,175,80,.4);
        background: rgba(76,175,80,.08);
    }

    .cb-badge-edit {
        color: #ffb74d;
        border-color: rgba(255,152,0,.4);
        background: rgba(255,152,0,.08);
    }

    /* Body */
    .cb-form-body {
        padding: 22px 22px 10px;
    }

    /* Section labels */
    .cb-section-label {
        font-size: .67rem;
        font-weight: 700;
        letter-spacing: 1.4px;
        text-transform: uppercase;
        color: rgba(255,152,0,.85);
        margin: 18px 0 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .cb-section-label::after {
            content: '';
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, rgba(255,152,0,.2), transparent);
        }

    /* Field grid */
    .cb-field-grid {
        display: grid;
        gap: 14px;
        margin-bottom: 14px;
    }

        .cb-field-grid.cols-2 {
            grid-template-columns: 1fr 1fr;
        }

        .cb-field-grid.cols-1 {
            grid-template-columns: 1fr;
        }

    @@media (max-width: 600px) {
        .cb-field-grid.cols-2 {
            grid-template-columns: 1fr;
        }
    }

    /* MudBlazor overrides */
    .cb-form-wrap .mud-input-root {
        background: rgba(255,255,255,.035) !important;
        border-radius: 10px !important;
    }

        .cb-form-wrap .mud-input-root:hover {
            background: rgba(255,255,255,.055) !important;
        }

        .cb-form-wrap .mud-input-root.mud-input-root-focused {
            background: rgba(255,152,0,.06) !important;
            box-shadow: 0 0 0 2px rgba(255,152,0,.25) !important;
        }

    /* Zona imagen */
    .cb-img-zone {
        border: 2px dashed var(--cb-orange-border);
        border-radius: 14px;
        overflow: hidden;
        min-height: 190px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        background: rgba(255,255,255,.02);
        transition: all .22s;
        position: relative;
    }

        .cb-img-zone:hover, .cb-img-zone.has-image {
            border-style: solid;
            border-color: rgba(255,152,0,.55);
        }

        .cb-img-zone img {
            width: 100%;
            max-height: 220px;
            object-fit: contain;
            display: block;
        }

    .cb-img-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,.55);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        opacity: 0;
        transition: opacity .22s;
        border-radius: 12px;
    }

    .cb-img-zone:hover .cb-img-overlay {
        opacity: 1;
    }

    .cb-overlay-btn {
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 8px;
        color: white;
        font-size: .76rem;
        padding: 7px 13px;
        cursor: pointer;
        backdrop-filter: blur(8px);
        font-weight: 600;
        transition: background .2s;
    }

        .cb-overlay-btn:hover {
            background: rgba(255,152,0,.35);
            border-color: rgba(255,152,0,.6);
        }

    .cb-img-placeholder {
        padding: 24px 14px;
        text-align: center;
    }

    .cb-img-icon {
        font-size: 2.4rem;
        opacity: .3;
        margin-bottom: 6px;
    }

    .cb-img-text {
        font-size: .82rem;
        color: rgba(255,255,255,.5);
    }

    .cb-img-sub {
        font-size: .7rem;
        color: rgba(255,255,255,.28);
        margin-top: 3px;
    }

    /* Tabla picker */
    .cb-form-wrap .products-picker-table {
        background: rgba(255,255,255,.02) !important;
        border-radius: 10px;
    }

    /* Chips */
    .cb-chips-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 16px;
    }

    /* Footer */
    .cb-form-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        background: rgba(5,5,5,.9);
        border-top: 1px solid rgba(255,255,255,.06);
        padding: 14px 22px;
    }

    .cb-cancel-btn {
        color: rgba(255,255,255,.4) !important;
        border-radius: 10px !important;
        height: 40px !important;
        padding: 0 16px !important;
        text-transform: none !important;
    }

        .cb-cancel-btn:hover {
            color: rgba(255,255,255,.8) !important;
            background: rgba(255,255,255,.05) !important;
        }

    .cb-save-btn {
        background: linear-gradient(135deg, var(--cb-orange), #e65100) !important;
        color: #fff !important;
        font-weight: 700 !important;
        border-radius: 10px !important;
        padding: 0 26px !important;
        height: 40px !important;
        text-transform: none !important;
        box-shadow: 0 4px 16px rgba(255,152,0,.3) !important;
    }

        .cb-save-btn:hover:not(:disabled) {
            filter: brightness(1.1) !important;
            transform: translateY(-1px) !important;
        }

        .cb-save-btn:disabled {
            opacity: .5 !important;
        }

    .muted-text {
        color: rgba(255,255,255,.4) !important;
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="cb-page">

    <!-- ── HEADER ─────────────────────────────────────────────────── -->
    <div class="cb-header">
        <div class="cb-header-left">
            <div class="cb-header-accent"></div>
            <div>
                <p class="cb-page-title">Combos</p>
                <p class="cb-page-sub">Paquetes especiales con múltiples productos a precio combinado</p>
            </div>
        </div>
        <MudButton Class="cb-btn-new"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="ShowCreateSection">
            Nuevo Combo
        </MudButton>
    </div>

    <!-- ── LOADING ────────────────────────────────────────────────── -->
    @if (_loading)
    {
        <div style="display:flex;flex-direction:column;align-items:center;padding:4rem 0;gap:1rem;color:rgba(255,255,255,.4)">
            <MudProgressCircular Indeterminate Size="Size.Large" Color="Color.Warning" />
            <span>Cargando combos...</span>
        </div>
    }
    else if (!_adminCombos.Any())
    {
        <div class="cb-empty">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Class="cb-empty-icon" />
            <p style="font-size:.95rem;font-weight:600;margin:.5rem 0 .25rem">Sin combos aún</p>
            <p style="font-size:.8rem">Crea tu primer combo para empezar a ofrecer paquetes especiales.</p>
            <MudButton Class="cb-btn-new" Style="margin-top:1rem" OnClick="ShowCreateSection">Crear combo</MudButton>
        </div>
    }
    else
    {
        <!-- ── TABLA ──────────────────────────────────────────────── -->
        <div class="cb-table-wrap">
            <table class="cb-table">
                <thead>
                    <tr>
                        <th>Imagen</th>
                        <th>Nombre</th>
                        <th>Precio</th>
                        <th>Productos</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var combo in _adminCombos)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(combo.ImageUrl) && combo.ImageUrl != "/images/combo-default.png")
                                {
                                    <img src="@combo.ImageUrl" class="cb-thumb" alt="@combo.Name" />
                                }
                                else
                                {
                                    <div class="cb-thumb-placeholder">📦</div>
                                }
                            </td>
                            <td style="font-weight:600;color:#fff">@combo.Name</td>
                            <td>
                                <span class="cb-price-badge">$@combo.ComboPrice.ToString("N2")</span>
                            </td>
                            <td style="font-size:.78rem;color:rgba(255,255,255,.55)">
                                @combo.ProductsSummary
                            </td>
                            <td>
                                <div class="cb-actions">
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                   Color="Color.Info" Size="Size.Small"
                                                   Title="Ver detalle"
                                                   OnClick="@(() => Nav.NavigateTo($"/combo/{combo.ComboId}", true))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Warning" Size="Size.Small"
                                                   Title="Editar"
                                                   OnClick="@(() => EditCombo(combo.ComboId))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error" Size="Size.Small"
                                                   Title="Eliminar"
                                                   OnClick="@(() => DeleteCombo(combo.ComboId))" />
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- ══ ANCLA DE SCROLL ═══════════════════════════════════════ -->
    <div id="combo-form-anchor" style="height:0"></div>

    <!-- ══ FORMULARIO GLASSMORPHISM ══════════════════════════════ -->
    @if (_showCreateCombo)
    {
        <div class="cb-form-wrap">

            <!-- Header -->
            <div class="cb-form-header">
                <div class="cb-form-header-row">
                    <div style="display:flex;align-items:center;gap:12px">
                        <div class="cb-form-accent"></div>
                        <div>
                            <p class="cb-form-title">@(_isEditMode ? "Editar Combo" : "Nuevo Combo")</p>
                            <p class="cb-form-subtitle">
                                @(_isEditMode ? $"Modificando ID #{_editingComboId}" : "Completa los datos del nuevo combo")
                            </p>
                        </div>
                    </div>
                    <span class="cb-form-badge @(_isEditMode ? "cb-badge-edit" : "cb-badge-new")">
                        @(_isEditMode ? "EDITAR" : "NUEVO")
                    </span>
                </div>
            </div>

            <!-- Body -->
            <div class="cb-form-body">

                <!-- Imagen -->
                <p class="cb-section-label">📷 Imagen del combo</p>

                <InputFile id="combo-img-input"
                           OnChange="HandleFileSelected"
                           accept="image/png,image/jpeg,image/webp"
                           style="display:none" />

                <label for="combo-img-input" style="display:block;cursor:pointer">
                    <div class="cb-img-zone @(HasComboImage ? "has-image" : "")">
                        @if (HasComboImage)
                        {
                            <img src="@(_previewBase64 ?? _newCombo.ImageUrl)" alt="Preview" />
                            <div class="cb-img-overlay">
                                <span class="cb-overlay-btn">🔄 Cambiar</span>
                                <span class="cb-overlay-btn" @onclick:stopPropagation @onclick="RemoveImage">🗑 Quitar</span>
                            </div>
                        }
                        else
                        {
                            <div class="cb-img-placeholder">
                                <div class="cb-img-icon">📦</div>
                                <div class="cb-img-text">Toca aquí para subir imagen</div>
                                <div class="cb-img-sub">PNG, JPG, WEBP · máx 5 MB</div>
                            </div>
                        }
                    </div>
                </label>

                <!-- Info básica -->
                <p class="cb-section-label">📋 Información básica</p>
                <div class="cb-field-grid cols-2">
                    <MudTextField @bind-Value="_newCombo.Name"
                                  Label="Nombre del Combo"
                                  Variant="Variant.Outlined"
                                  Placeholder="Ej: Combo Fin de Semana" />
                    <MudNumericField @bind-Value="_newCombo.ComboPrice"
                                     T="decimal"
                                     Label="Precio del combo ($)"
                                     Variant="Variant.Outlined"
                                     Adornment="Adornment.Start"
                                     AdornmentText="$" />
                </div>
                <div class="cb-field-grid cols-1">
                    <MudTextField @bind-Value="_newCombo.Description"
                                  Label="Descripción (opcional)"
                                  Lines="2"
                                  Variant="Variant.Outlined"
                                  Placeholder="Breve descripción visible al cliente" />
                </div>

                <!-- Productos -->
                <p class="cb-section-label">🛒 Productos en este combo</p>

                <MudTable Items="_products" Dense Hover Bordered Class="mb-3 products-picker-table">
                    <HeaderContent>
                        <MudTh>Producto</MudTh>
                        <MudTh>Precio</MudTh>
                        <MudTh Align="Align.Center">Agregar</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudText Typo="Typo.body2" Class="font-weight-bold">@context.Name</MudText>
                        </MudTd>
                        <MudTd>
                            <MudText Color="Color.Success" Class="font-weight-bold">
                                $@context.Price.ToString("N2")
                            </MudText>
                        </MudTd>
                        <MudTd Align="Align.Center">
                            <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline"
                                           Color="Color.Warning"
                                           OnClick="@(() => OpenQuantityModal(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                @if (_comboBuilder.Any())
                {
                    <div style="font-size:.72rem;color:rgba(255,255,255,.4);margin-bottom:8px">
                        Incluidos en el combo:
                    </div>
                    <div class="cb-chips-wrap">
                        @foreach (var item in _comboBuilder)
                        {
                            <MudChip T="ComboProductTemp"
                                     Value="@item"
                                     Closeable="true"
                                     Color="Color.Warning"
                                     OnClose="@(() => _comboBuilder.Remove(item))">
                                @($"{item.Quantity} x {item.ProductName}")
                            </MudChip>
                        }
                    </div>
                }

            </div><!-- /cb-form-body -->
            <!-- Footer -->
            <div class="cb-form-footer">
                <MudButton Class="cb-cancel-btn" OnClick="ResetForm">Cancelar</MudButton>
                <MudButton Class="cb-save-btn"
                           Disabled="@(!_comboBuilder.Any())"
                           OnClick="SaveCombo">
                    @(_isEditMode ? "✦ Actualizar Combo" : "✦ Guardar Combo")
                </MudButton>
            </div>

        </div>
    }

</MudContainer>

@code {
    private bool HasComboImage =>
        !string.IsNullOrEmpty(_previewBase64) ||
        (!string.IsNullOrEmpty(_newCombo.ImageUrl) && _newCombo.ImageUrl != "/images/combo-default.png");
}
