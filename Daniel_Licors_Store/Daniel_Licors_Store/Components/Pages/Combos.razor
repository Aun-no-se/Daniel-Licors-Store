@page "/admin/combos"
@using Microsoft.AspNetCore.Components.Forms
@using Daniel_Licors_Store.Models.Combo

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">

    <MudText Typo="Typo.h4" Class="font-weight-bold mb-4">
        Administración de Combos
    </MudText>

    @if (_loading)
    {
        <div class="d-flex justify-center my-10">
            <MudProgressCircular Indeterminate Size="Size.Large" />
        </div>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4 rounded-lg">

            <MudTable Items="_adminCombos" Dense Hover Bordered>
                <HeaderContent>
                    <MudTh>Imagen</MudTh>
                    <MudTh>Nombre</MudTh>
                    <MudTh>Precio</MudTh>
                    <MudTh>Productos</MudTh>
                    <MudTh Align="Align.Center">Acciones</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd>
                        <MudAvatar Size="Size.Medium" Square>
                            <MudImage Src="@context.ImageUrl" Width="48" Height="48" />
                        </MudAvatar>
                    </MudTd>

                    <MudTd>
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                            @context.Name
                        </MudText>
                    </MudTd>

                    <MudTd>
                        <MudText Color="Color.Success" Class="font-weight-bold">
                            $@context.ComboPrice.ToString("N2")
                        </MudText>
                    </MudTd>

                    <MudTd>
                        <MudText Typo="Typo.body2">
                            @context.ProductsSummary
                        </MudText>
                    </MudTd>

                    <MudTd Align="Align.Center">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Primary"
                                       OnClick="@(() => ViewCombo(context.ComboId))" />

                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       OnClick="@(() => EditCombo(context.ComboId))" />

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteCombo(context.ComboId))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>

        </MudPaper>

        <div class="d-flex justify-end mt-4">
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="ShowCreateSection">
                Añadir combo
            </MudButton>
        </div>
    }

    @if (_showCreateCombo)
    {
        <MudPaper Elevation="2" Class="pa-4 mt-6">

            <MudText Typo="Typo.h5" Class="mb-2">
                Crear nuevo combo
            </MudText>

            <MudDivider Class="mb-4" />

            <MudGrid Class="mb-4">

                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_newCombo.Name"
                                  Label="Nombre del Combo"
                                  Variant="Variant.Outlined"
                                  Required />
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudNumericField @bind-Value="_newCombo.ComboPrice"
                                     Label="Precio ($)"
                                     Variant="Variant.Outlined"
                                     Required />
                </MudItem>

                <MudItem xs="12" md="7">
                    <MudTextField @bind-Value="_newCombo.Description"
                                  Label="Descripción"
                                  Lines="4"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" md="5"
                         Class="d-flex flex-column align-center justify-center pa-4 border-dashed rounded-lg">

                    @if (!string.IsNullOrEmpty(_imageFileName))
                    {
                        <MudText Typo="Typo.subtitle2" Color="Color.Success">
                            @_imageFileName
                        </MudText>
                    }
                    else
                    {
                        <InputFile OnChange="HandleFileSelected"
                                   accept="image/png,image/jpeg,image/webp"
                                   style="display:block" />
                    }

                </MudItem>

            </MudGrid>

            <MudText Typo="Typo.subtitle2" Class="mb-2 font-weight-bold">
                Seleccionar productos
            </MudText>

            <MudTable Items="_products" Dense Hover Bordered>
                <RowTemplate>
                    <MudTd>@context.Name</MudTd>
                    <MudTd>$@context.Price.ToString("N2")</MudTd>
                    <MudTd Align="Align.Center">
                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                       Color="Color.Success"
                                       OnClick="@(() => OpenQuantityModal(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <MudDivider Class="my-4" />

            @foreach (var item in _comboBuilder)
            {
                <MudChip T="ComboProductTemp"
                         Value="@item"
                         Closeable="true"
                         OnClose="@(() => _comboBuilder.Remove(item))">
                    @($"{item.Quantity} x {item.ProductName}")
                </MudChip>
            }

            <div class="d-flex justify-end mt-4">
                <MudButton Color="Color.Success"
                           Disabled="@(!_comboBuilder.Any())"
                           OnClick="SaveCombo">
                    Guardar combo
                </MudButton>

                <MudButton Color="Color.Secondary"
                           Variant="Variant.Outlined"
                           OnClick="@ResetForm">
                    Cancelar
                </MudButton>
            </div>

        </MudPaper>
    }

</MudContainer>