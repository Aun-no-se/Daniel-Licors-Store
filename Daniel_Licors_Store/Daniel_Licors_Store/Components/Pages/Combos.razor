@page "/admin/combos"


<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">

    <MudText Typo="Typo.h4" Class="font-weight-bold mb-4">
        Administración de Combos
    </MudText>

    @if (_loading)
    {
        <div class="d-flex justify-center my-10">
            <MudProgressCircular Indeterminate Size="Size.Large" />
        </div>
    }
    else
    {
        <MudPaper Elevation="1" Class="pa-4 rounded-lg">

            <MudTable Items="AdminCombos" Dense="true" Hover="true" Bordered="true">
                <HeaderContent>
                    <MudTh>Imagen</MudTh>
                    <MudTh>Nombre</MudTh>
                    <MudTh>Precio</MudTh>
                    <MudTh>Productos</MudTh>
                    <MudTh Align="Align.Center">Acciones</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd>
                        <MudAvatar Size="Size.Medium" Square="true">
                            <MudImage Src="@context.ImageUrl"
                                      Alt="@context.Name"
                                      Width="48"
                                      Height="48" />
                        </MudAvatar>
                    </MudTd>

                    <MudTd>
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                            @context.Name
                        </MudText>
                    </MudTd>

                    <MudTd>
                        <MudText Color="Color.Success" Class="font-weight-bold">
                            $@context.ComboPrice.ToString("N2")
                        </MudText>
                    </MudTd>

                    <MudTd>
                        <MudText Typo="Typo.body2">
                            @context.ProductsSummary
                        </MudText>
                    </MudTd>

                    <MudTd Align="Align.Center">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Color="Color.Primary"
                                       OnClick="@(() => ViewCombo(context.ComboId))" />

                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       OnClick="@(() => EditCombo(context.ComboId))" />

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteCombo(context.ComboId))" />
                    </MudTd>
                </RowTemplate>

            </MudTable>

        </MudPaper>

        <div class="d-flex justify-end mt-4">
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="ShowCreateSection">
                Añadir combo
            </MudButton>
        </div>
    }

    @if (ShowCreateCombo)
{
    <MudPaper Elevation="2" Class="pa-4 mt-6">

        <MudText Typo="Typo.h5" Class="mb-2">
            Crear nuevo combo
        </MudText>

        <MudDivider Class="mb-4" />

        <!-- AQUÍ VA LA TABLA DE PRODUCTOS -->
        <MudTable Items="_products" Dense Hover Bordered>

            <HeaderContent>
                <MudTh>Imagen</MudTh>
                <MudTh>Producto</MudTh>
                <MudTh>Precio</MudTh>
                <MudTh Align="Align.Center">Opciones</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd>
                    <MudAvatar Size="Size.Medium" Square>
                        <MudImage Src="@context.ImageUrl" />
                    </MudAvatar>
                </MudTd>

                <MudTd>@context.Name</MudTd>

                <MudTd>$@context.Price.ToString("N2")</MudTd>

                <MudTd Align="Align.Center">
                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Color="Color.Success"
                                   OnClick="@(() => OpenQuantityModal(context))" />
                </MudTd>
            </RowTemplate>

        </MudTable>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.subtitle1">
            Productos en el combo
        </MudText>

        @foreach (var item in ComboBuilder)
        {
                <MudChip T="string" Color="Color.Primary" Class="mr-2 mb-2">
                    @($"{item.Quantity} x {item.ProductName}")
                </MudChip>
        }

        <div class="d-flex justify-end mt-4">
            <MudButton Color="Color.Success"
                       Variant="Variant.Filled"
                       Disabled="@(ComboBuilder.Count == 0)">
                Guardar combo
            </MudButton>
        </div>

    </MudPaper>
}

</MudContainer>