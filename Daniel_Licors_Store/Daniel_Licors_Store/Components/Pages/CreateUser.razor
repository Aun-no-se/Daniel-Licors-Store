@page "/admin/create-user"
@using Daniel_Licors_Store.Models.Users
@using Daniel_Licors_Store.Models.Users.Auth
@using Daniel_Licors_Store.Services.Auth
@using Daniel_Licors_Store.Data.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@attribute [Authorize(Roles = "Admin")]

@inject IAuthService AuthService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<style>
    /* ── Shell ───────────────────────────────────────────────────── */
    .cu-page {
        min-height: 100vh;
        padding: 28px 16px 48px;
        background: radial-gradient(circle at 50% 0%, rgba(255,23,68,0.06) 0%, transparent 65%);
    }

    .cu-card {
        background: rgba(14, 14, 14, 0.95);
        border: 1px solid rgba(255, 23, 68, 0.15);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 24px 64px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.03);
        max-width: 540px;
        margin: 0 auto;
        animation: cu-fadein 0.35s cubic-bezier(0.22,1,0.36,1);
    }

    @@keyframes cu-fadein {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── Header ──────────────────────────────────────────────────── */
    .cu-header {
        padding: 24px 28px 20px;
        background: linear-gradient(135deg, #1a0000 0%, #0d0d0d 70%);
        border-bottom: 1px solid rgba(255,23,68,0.18);
        position: relative;
        overflow: hidden;
    }

        .cu-header::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 0% 50%, rgba(255,23,68,0.1) 0%, transparent 70%);
            pointer-events: none;
        }

    .cu-header-accent {
        width: 4px;
        height: 32px;
        background: linear-gradient(180deg, #FF1744, #B71C1C);
        border-radius: 4px;
        box-shadow: 0 0 14px rgba(255,23,68,0.5);
        flex-shrink: 0;
    }

    .cu-header-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #fff;
        letter-spacing: 0.2px;
    }

    .cu-header-sub {
        font-size: 0.72rem;
        color: rgba(255,255,255,0.38);
        margin-top: 2px;
        letter-spacing: 0.4px;
    }

    /* ── Body ────────────────────────────────────────────────────── */
    .cu-body {
        padding: 24px 28px 28px;
    }

    /* ── Section labels ──────────────────────────────────────────── */
    .cu-section-label {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: rgba(255,23,68,0.75);
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .cu-section-label::after {
            content: '';
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, rgba(255,23,68,0.2), transparent);
        }

    /* ── Fields ──────────────────────────────────────────────────── */
    .cu-field-row {
        display: grid;
        gap: 14px;
        margin-bottom: 14px;
    }

    .cu-cols-2 {
        grid-template-columns: 1fr 1fr;
    }

    .cu-cols-1 {
        grid-template-columns: 1fr;
    }

    @@media (max-width: 480px) {
        .cu-cols-2 {
            grid-template-columns: 1fr;
        }

        .cu-body {
            padding: 18px 18px 24px;
        }

        .cu-header {
            padding: 20px 18px 16px;
        }
    }

    /* MudBlazor field overrides */
    .cu-card .mud-input-root {
        background: rgba(255,255,255,0.03) !important;
        border-radius: 10px !important;
        transition: background 0.2s, box-shadow 0.2s;
    }

        .cu-card .mud-input-root:hover {
            background: rgba(255,255,255,0.05) !important;
        }

        .cu-card .mud-input-root.mud-input-root-focused {
            background: rgba(255,23,68,0.05) !important;
            box-shadow: 0 0 0 2px rgba(255,23,68,0.22) !important;
        }

    /* ── Password strength bar ───────────────────────────────────── */
    .cu-strength-wrap {
        margin-top: -6px;
        margin-bottom: 6px;
    }

    .cu-strength-bar {
        height: 3px;
        border-radius: 2px;
        background: rgba(255,255,255,0.08);
        overflow: hidden;
    }

    .cu-strength-fill {
        height: 100%;
        border-radius: 2px;
        transition: width 0.35s ease, background 0.35s ease;
    }

    .cu-strength-label {
        font-size: 0.65rem;
        margin-top: 4px;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    /* ── Role Cards ──────────────────────────────────────────────── */
    .cu-roles {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
        margin-bottom: 20px;
    }

    @@media (max-width: 400px) {
        .cu-roles {
            grid-template-columns: 1fr;
        }
    }

    .cu-role-card {
        border-radius: 12px;
        border: 1.5px solid rgba(255,255,255,0.07);
        background: rgba(255,255,255,0.02);
        padding: 14px 10px 12px;
        cursor: pointer;
        transition: all 0.22s ease;
        text-align: center;
        user-select: none;
    }

        .cu-role-card:hover {
            background: rgba(255,255,255,0.05);
            border-color: rgba(255,255,255,0.14);
            transform: translateY(-2px);
        }

        .cu-role-card.selected-admin {
            background: rgba(255,23,68,0.09);
            border-color: rgba(255,23,68,0.45);
            box-shadow: 0 0 18px rgba(255,23,68,0.12);
        }

        .cu-role-card.selected-empleado {
            background: rgba(255,138,128,0.09);
            border-color: rgba(255,138,128,0.45);
            box-shadow: 0 0 18px rgba(255,138,128,0.12);
        }

        .cu-role-card.selected-cliente {
            background: rgba(76,175,80,0.09);
            border-color: rgba(76,175,80,0.45);
            box-shadow: 0 0 18px rgba(76,175,80,0.12);
        }

    .cu-role-icon {
        font-size: 1.6rem;
        margin-bottom: 6px;
    }

    .cu-role-name {
        font-size: 0.78rem;
        font-weight: 700;
        color: rgba(255,255,255,0.8);
        letter-spacing: 0.3px;
    }

    .cu-role-hint {
        font-size: 0.62rem;
        color: rgba(255,255,255,0.32);
        margin-top: 2px;
        line-height: 1.3;
    }

    /* ── Admin role warning ──────────────────────────────────────── */
    .cu-admin-warning {
        border-radius: 10px;
        border: 1px solid rgba(255,193,7,0.3);
        background: rgba(255,193,7,0.06);
        padding: 10px 14px;
        display: flex;
        gap: 10px;
        align-items: flex-start;
        margin-bottom: 18px;
        animation: cu-fadein 0.25s ease;
        font-size: 0.75rem;
        color: rgba(255,193,7,0.85);
        line-height: 1.45;
    }

    .cu-admin-warning-icon {
        font-size: 1rem;
        flex-shrink: 0;
        margin-top: 1px;
    }

    /* ── Validation summary ──────────────────────────────────────── */
    .cu-error-box {
        border-radius: 10px;
        border: 1px solid rgba(255,23,68,0.35);
        background: rgba(255,23,68,0.07);
        padding: 12px 14px;
        margin-bottom: 18px;
        font-size: 0.78rem;
        color: rgba(255,100,100,0.95);
        animation: cu-fadein 0.2s ease;
        line-height: 1.5;
    }

    /* ── Buttons ─────────────────────────────────────────────────── */
    .cu-btn-create {
        background: linear-gradient(135deg, #FF1744 0%, #B71C1C 100%) !important;
        color: white !important;
        font-weight: 700 !important;
        border-radius: 10px !important;
        height: 46px !important;
        font-size: 0.88rem !important;
        letter-spacing: 0.5px !important;
        box-shadow: 0 4px 18px rgba(255,23,68,0.3) !important;
        transition: all 0.25s ease !important;
        width: 100%;
    }

        .cu-btn-create:hover:not(:disabled) {
            transform: translateY(-2px) !important;
            box-shadow: 0 8px 26px rgba(255,23,68,0.45) !important;
            filter: brightness(1.08) !important;
        }

        .cu-btn-create:disabled {
            opacity: 0.5 !important;
        }

    .cu-btn-back {
        color: rgba(255,255,255,0.4) !important;
        font-size: 0.78rem !important;
        margin-bottom: 18px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: color 0.2s;
        background: none;
        border: none;
        padding: 0;
    }

        .cu-btn-back:hover {
            color: rgba(255,255,255,0.75) !important;
        }

    /* ── Success overlay ─────────────────────────────────────────── */
    .cu-success {
        text-align: center;
        padding: 36px 24px;
        animation: cu-fadein 0.3s ease;
    }

    .cu-success-icon {
        font-size: 3rem;
        margin-bottom: 12px;
    }

    .cu-success-name {
        font-size: 1.1rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 6px;
    }

    .cu-success-sub {
        font-size: 0.8rem;
        color: rgba(255,255,255,0.45);
        margin-bottom: 24px;
    }

    .cu-divider {
        height: 20px;
    }
</style>

<div class="cu-page">

    <!-- Botón volver -->
    <div style="max-width:540px; margin:0 auto 14px;">
        <button class="cu-btn-back" @onclick='() => Nav.NavigateTo("/admin/usuarios")'>
            ← Volver al panel
        </button>
    </div>

    <div class="cu-card">

        <!-- ── Header ── -->
        <div class="cu-header">
            <div style="display:flex; align-items:center; gap:12px">
                <div class="cu-header-accent"></div>
                <div>
                    <div class="cu-header-title">Crear nuevo usuario</div>
                    <div class="cu-header-sub">Solo accesible para administradores del sistema</div>
                </div>
            </div>
        </div>

        <!-- ── Body ── -->
        <div class="cu-body">

            @if (success)
            {
                <!-- ── Estado de éxito ── -->
                <div class="cu-success">
                    <div class="cu-success-icon">✅</div>
                    <div class="cu-success-name">@(model.Name) @(model.LastName) creado</div>
                    <div class="cu-success-sub">
                        Rol asignado: <strong>@RoleName</strong> · @(model.Email)
                    </div>
                    <MudButton Class="cu-btn-create" OnClick="ResetForm">
                        + Crear otro usuario
                    </MudButton>
                    <div style="margin-top:10px">
                        <MudButton Variant="Variant.Text"
                                   Style="color:rgba(255,255,255,0.35); font-size:0.78rem;"
                                   OnClick='() => Nav.NavigateTo("/admin/dashboard")'>
                            Ir al panel de administración
                        </MudButton>
                    </div>
                </div>
            }
            else
            {
                <!-- ── Error global ── -->
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="cu-error-box">
                        ⚠️ @errorMessage
                    </div>
                }

                <!-- ── SECCIÓN: Información personal ── -->
                <div class="cu-section-label">👤 Información personal</div>

                <div class="cu-field-row cu-cols-2">
                    <MudTextField @bind-Value="model.Name"
                                  Label="Nombre *"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Error="@(submitted && string.IsNullOrWhiteSpace(model.Name))"
                                  ErrorText="Requerido"
                                  FullWidth />

                    <MudTextField @bind-Value="model.LastName"
                                  Label="Apellido *"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Error="@(submitted && string.IsNullOrWhiteSpace(model.LastName))"
                                  ErrorText="Requerido"
                                  FullWidth />
                </div>

                <div class="cu-field-row cu-cols-2">
                    <MudTextField @bind-Value="model.Email"
                                  Label="Correo electrónico *"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Immediate="true"
                                  Error="@(submitted && !EmailValid)"
                                  ErrorText="Correo inválido"
                                  FullWidth />

                    <MudTextField T="int"
                                  @bind-Value="model.Age"
                                  Label="Edad *"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Error="@(submitted && (model.Age < 18 || model.Age > 100))"
                                  ErrorText="Mínimo 18 años"
                                  Adornment="Adornment.End"
                                  AdornmentText="años"
                                  FullWidth />
                </div>

                <!-- ── SECCIÓN: Contraseña ── -->
                <div class="cu-section-label">🔒 Contraseña</div>

                <div class="cu-field-row cu-cols-1">
                    <div>
                        <MudTextField T="string"
                                      Value="@model.Password"
                                      ValueChanged="@OnPasswordChanged"
                                      Label="Contraseña *"
                                      Variant="Variant.Outlined"
                                      InputType="@(_showPass ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showPass ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                      OnAdornmentClick="@ToggleShowPass"
                                      Immediate="true"
                                      Error="@(submitted && !PasswordValid)"
                                      ErrorText="Mínimo 8 caracteres, una mayúscula y un número"
                                      FullWidth />

                        <!-- Barra de fortaleza -->
                        @if (!string.IsNullOrEmpty(model.Password))
                        {
                            <div class="cu-strength-wrap">
                                <div class="cu-strength-bar">
                                    <div class="cu-strength-fill"
                                         style="width:@(StrengthPercent)%; background:@(StrengthColor)"></div>
                                </div>
                                <div class="cu-strength-label" style="color:@(StrengthColor)">
                                    @StrengthLabel
                                </div>
                            </div>
                        }
                    </div>

                    <MudTextField T="string"
                                  Value="@model.ConfirmPassword"
                                  ValueChanged="@OnConfirmPasswordChanged"
                                  Variant="Variant.Outlined"
                                  InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                  OnAdornmentClick="@ToggleShowConfirm"
                                  Immediate="true"
                                  Error="@(submitted && model.Password != model.ConfirmPassword)"
                                  ErrorText="Las contraseñas no coinciden"
                                  FullWidth />
                </div>

                <!-- ── SECCIÓN: Rol ── -->
                <div class="cu-section-label">🎭 Rol del usuario</div>

                <div class="cu-roles">

                    <!-- Admin -->
                    <div class="cu-role-card @(model.RoleId == 1 ? "selected-admin" : "")"
                         @onclick="() => SelectRole(1)">
                        <div class="cu-role-icon">👑</div>
                        <div class="cu-role-name">Admin</div>
                        <div class="cu-role-hint">Acceso total al sistema</div>
                    </div>

                    <!-- Empleado -->
                    <div class="cu-role-card @(model.RoleId == 2 ? "selected-empleado" : "")"
                         @onclick="() => SelectRole(2)">
                        <div class="cu-role-icon">🧑‍💼</div>
                        <div class="cu-role-name">Empleado</div>
                        <div class="cu-role-hint">Gestión de tienda</div>
                    </div>

                    <!-- Cliente -->
                    <div class="cu-role-card @(model.RoleId == 3 ? "selected-cliente" : "")"
                         @onclick="() => SelectRole(3)">
                        <div class="cu-role-icon">🛒</div>
                        <div class="cu-role-name">Cliente</div>
                        <div class="cu-role-hint">Acceso al catálogo</div>
                    </div>

                </div>

                <!-- Advertencia si seleccionan Admin -->
                @if (model.RoleId == 1)
                {
                    <div class="cu-admin-warning">
                        <span class="cu-admin-warning-icon">⚠️</span>
                        <span>
                            Estás asignando rol <strong>Admin</strong>. Este usuario tendrá
                            acceso completo: crear usuarios, modificar inventario, ver reportes
                            y gestionar toda la tienda.
                        </span>
                    </div>
                }

                <div class="cu-divider"></div>

                <!-- Botón crear -->
                <MudButton Class="cu-btn-create"
                           OnClick="HandleCreate"
                           Disabled="@isLoading">
                    @if (isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Creando usuario...</span>
                    }
                    else
                    {
                        <span>✦ Crear usuario</span>
                    }
                </MudButton>
            }

        </div>
    </div>
</div>

@code {

    private AdminRegisterModel model = new() { RoleId = 2 }; // Empleado por defecto
    private bool isLoading;
    private bool submitted;
    private bool success;
    private string? errorMessage;
    private bool _showPass;
    private bool _showConfirm;

    // ── Validaciones en tiempo real ─────────────────────────────────────────
    private static readonly System.Text.RegularExpressions.Regex EmailRegex =
        new(@"^[^@\s]+@[^@\s]+\.[^@\s]+$",
            System.Text.RegularExpressions.RegexOptions.Compiled |
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    private bool EmailValid =>
        !string.IsNullOrWhiteSpace(model.Email) && EmailRegex.IsMatch(model.Email);

    private bool PasswordValid =>
        !string.IsNullOrEmpty(model.Password) &&
        model.Password.Length >= 8 &&
        model.Password.Any(char.IsUpper) &&
        model.Password.Any(char.IsDigit);

    // ── Fortaleza de contraseña ─────────────────────────────────────────────
    private int StrengthScore
    {
        get
        {
            if (string.IsNullOrEmpty(model.Password)) return 0;
            int s = 0;
            if (model.Password.Length >= 8) s++;
            if (model.Password.Length >= 12) s++;
            if (model.Password.Any(char.IsUpper)) s++;
            if (model.Password.Any(char.IsDigit)) s++;
            if (model.Password.Any(ch => !char.IsLetterOrDigit(ch))) s++;
            return s;
        }
    }

    private int StrengthPercent => StrengthScore * 20;
    private string StrengthColor => StrengthScore switch
    {
        <= 1 => "#F44336",
        2 => "#FF9800",
        3 => "#FFC107",
        4 => "#8BC34A",
        _ => "#4CAF50"
    };
    private string StrengthLabel => StrengthScore switch
    {
        <= 1 => "Muy débil",
        2 => "Débil",
        3 => "Aceptable",
        4 => "Fuerte",
        _ => "Muy fuerte"
    };

    // ── Rol seleccionado ────────────────────────────────────────────────────
    private string RoleName => model.RoleId switch
    {
        1 => "Admin",
        2 => "Empleado",
        _ => "Cliente"
    };

    // ── Guardia de seguridad: verificar rol Admin en el servidor ────────────
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();

        // Doble verificación server-side además del [Authorize]
        if (!state.User.IsInRole("Admin"))
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }
    }

    // ── Acciones ────────────────────────────────────────────────────────────
    private void SelectRole(int roleId) => model.RoleId = roleId;

    // Métodos nombrados para evitar conflicto de ValueChanged con @bind-Value
    private void OnPasswordChanged(string v) { model.Password = v; StateHasChanged(); }
    private void OnConfirmPasswordChanged(string v) { model.ConfirmPassword = v; StateHasChanged(); }
    private void ToggleShowPass() => _showPass = !_showPass;
    private void ToggleShowConfirm() => _showConfirm = !_showConfirm;

    private async Task HandleCreate()
    {
        submitted = true;
        errorMessage = null;

        // Validación cliente-side antes de ir al servidor
        var errors = new List<string>();

        if (string.IsNullOrWhiteSpace(model.Name))
            errors.Add("El nombre es requerido.");

        if (string.IsNullOrWhiteSpace(model.LastName))
            errors.Add("El apellido es requerido.");

        if (!EmailValid)
            errors.Add("El correo electrónico no es válido.");

        if (model.Age < 18 || model.Age > 100)
            errors.Add("La edad debe estar entre 18 y 100 años.");

        if (!PasswordValid)
            errors.Add("La contraseña debe tener mínimo 8 caracteres, una mayúscula y un número.");

        if (model.Password != model.ConfirmPassword)
            errors.Add("Las contraseñas no coinciden.");

        if (model.RoleId < 1 || model.RoleId > 3)
            errors.Add("Selecciona un rol válido.");

        if (errors.Any())
        {
            errorMessage = string.Join(" · ", errors);
            return;
        }

        isLoading = true;

        try
        {
            await AuthService.CreateUserByAdminAsync(model);
            success = true;

            Snackbar.Add($"Usuario {model.Name} {model.LastName} creado exitosamente",
                         Severity.Success,
                         cfg => { cfg.VisibleStateDuration = 3000; });
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetForm()
    {
        model = new AdminRegisterModel { RoleId = 2 };
        submitted = false;
        success = false;
        errorMessage = null;
        _showPass = false;
        _showConfirm = false;
    }
}
