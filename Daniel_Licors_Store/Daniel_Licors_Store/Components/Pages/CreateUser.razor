@page "/admin/create-user"
@using Daniel_Licors_Store.Models.Users
@using Daniel_Licors_Store.Models.Users.Auth
@using Daniel_Licors_Store.Services.Auth
@using Daniel_Licors_Store.Data.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

<div class="cu-page">

    <!-- Botón volver -->
    <div style="max-width:540px; margin:0 auto 14px;">
        <button class="cu-btn-back" @onclick='() => Nav.NavigateTo("/admin/usuarios")'>
            ← Volver al panel
        </button>
    </div>

    <div class="cu-card">

        <!-- ── Header ── -->
        <div class="cu-header">
            <div style="display:flex; align-items:center; gap:12px">
                <div class="cu-header-accent"></div>
                <div>
                    <div class="cu-header-title">Crear nuevo usuario</div>
                    <div class="cu-header-sub">Solo accesible para administradores del sistema</div>
                </div>
            </div>
        </div>

        <!-- ── Body ── -->
        <div class="cu-body">

            @if (success)
            {
                <!-- ── Estado de éxito ── -->
                <div class="cu-success">
                    <div class="cu-success-icon">✅</div>
                    <div class="cu-success-name">@(model.Name) @(model.LastName) creado</div>
                    <div class="cu-success-sub">
                        Rol asignado: <strong>@RoleName</strong> · @(model.Email)
                    </div>
                    <MudButton Class="cu-btn-create" OnClick="ResetForm">
                        + Crear otro usuario
                    </MudButton>
                    <div style="margin-top:10px">
                        <MudButton Variant="Variant.Text"
                                   Style="color:rgba(255,255,255,0.35); font-size:0.78rem;"
                                   OnClick='() => Nav.NavigateTo("/admin/dashboard")'>
                            Ir al panel de administración
                        </MudButton>
                    </div>
                </div>
            }
            else
            {
                <!-- ── Error global ── -->
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="cu-error-box">
                        ⚠️ @errorMessage
                    </div>
                }

                <!-- ── SECCIÓN: Información personal ── -->
                <div class="cu-section-label">👤 Información personal</div>

                <div class="cu-field-row cu-cols-2">
                    <MudTextField @bind-Value="model.Name"
                                  Label="Nombre *"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Error="@(submitted && string.IsNullOrWhiteSpace(model.Name))"
                                  ErrorText="Requerido"
                                  FullWidth />

                    <MudTextField @bind-Value="model.LastName"
                                  Label="Apellido *"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Error="@(submitted && string.IsNullOrWhiteSpace(model.LastName))"
                                  ErrorText="Requerido"
                                  FullWidth />
                </div>

                <div class="cu-field-row cu-cols-2">
                    <MudTextField @bind-Value="model.Email"
                                  Label="Correo electrónico *"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Immediate="true"
                                  Error="@(submitted && !EmailValid)"
                                  ErrorText="Correo inválido"
                                  FullWidth />

                    <MudTextField T="int"
                                  @bind-Value="model.Age"
                                  Label="Edad *"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Error="@(submitted && (model.Age < 18 || model.Age > 100))"
                                  ErrorText="Mínimo 18 años"
                                  Adornment="Adornment.End"
                                  AdornmentText="años"
                                  FullWidth />
                </div>

                <!-- ── SECCIÓN: Contraseña ── -->
                <div class="cu-section-label">🔒 Contraseña</div>

                <div class="cu-field-row cu-cols-1">
                    <div>
                        <MudTextField T="string"
                                      Value="@model.Password"
                                      ValueChanged="@OnPasswordChanged"
                                      Label="Contraseña *"
                                      Variant="Variant.Outlined"
                                      InputType="@(_showPass ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showPass ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                      OnAdornmentClick="@ToggleShowPass"
                                      Immediate="true"
                                      Error="@(submitted && !PasswordValid)"
                                      ErrorText="Mínimo 8 caracteres, una mayúscula y un número"
                                      FullWidth />

                        <!-- Barra de fortaleza -->
                        @if (!string.IsNullOrEmpty(model.Password))
                        {
                            <div class="cu-strength-wrap">
                                <div class="cu-strength-bar">
                                    <div class="cu-strength-fill"
                                         style="width:@(StrengthPercent)%; background:@(StrengthColor)"></div>
                                </div>
                                <div class="cu-strength-label" style="color:@(StrengthColor)">
                                    @StrengthLabel
                                </div>
                            </div>
                        }
                    </div>

                    <MudTextField T="string"
                                  Value="@model.ConfirmPassword"
                                  ValueChanged="@OnConfirmPasswordChanged"
                                  Variant="Variant.Outlined"
                                  InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                  OnAdornmentClick="@ToggleShowConfirm"
                                  Immediate="true"
                                  Error="@(submitted && model.Password != model.ConfirmPassword)"
                                  ErrorText="Las contraseñas no coinciden"
                                  FullWidth />
                </div>

                <!-- ── SECCIÓN: Rol ── -->
                <div class="cu-section-label">🎭 Rol del usuario</div>

                <div class="cu-roles">

                    <!-- Admin -->
                    <div class="cu-role-card @(model.RoleId == 1 ? "selected-admin" : "")"
                         @onclick="() => SelectRole(1)">
                        <div class="cu-role-icon">👑</div>
                        <div class="cu-role-name">Admin</div>
                        <div class="cu-role-hint">Acceso total al sistema</div>
                    </div>

                    <!-- Empleado -->
                    <div class="cu-role-card @(model.RoleId == 2 ? "selected-empleado" : "")"
                         @onclick="() => SelectRole(2)">
                        <div class="cu-role-icon">🧑‍💼</div>
                        <div class="cu-role-name">Empleado</div>
                        <div class="cu-role-hint">Gestión de tienda</div>
                    </div>

                    <!-- Cliente -->
                    <div class="cu-role-card @(model.RoleId == 3 ? "selected-cliente" : "")"
                         @onclick="() => SelectRole(3)">
                        <div class="cu-role-icon">🛒</div>
                        <div class="cu-role-name">Cliente</div>
                        <div class="cu-role-hint">Acceso al catálogo</div>
                    </div>

                </div>

                <!-- Advertencia si seleccionan Admin -->
                @if (model.RoleId == 1)
                {
                    <div class="cu-admin-warning">
                        <span class="cu-admin-warning-icon">⚠️</span>
                        <span>
                            Estás asignando rol <strong>Admin</strong>. Este usuario tendrá
                            acceso completo: crear usuarios, modificar inventario, ver reportes
                            y gestionar toda la tienda.
                        </span>
                    </div>
                }

                <div class="cu-divider"></div>

                <!-- Botón crear -->
                <MudButton Class="cu-btn-create"
                           OnClick="HandleCreate"
                           Disabled="@isLoading">
                    @if (isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Creando usuario...</span>
                    }
                    else
                    {
                        <span>✦ Crear usuario</span>
                    }
                </MudButton>
            }

        </div>
    </div>
</div>
