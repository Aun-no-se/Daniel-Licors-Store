@page "/admin/create-user"

@using Daniel_Licors_Store.Models.Users.Auth
@using Daniel_Licors_Store.Services
@inject IAuthService AuthService
@inject NavigationManager Nav

@using Daniel_Licors_Store.Services.Auth
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">

    <MudPaper Class="pa-6">

        <MudText Typo="Typo.h5" Class="mb-4">
            Crear Usuario
        </MudText>

        <MudTextField @bind-Value="model.Name" Label="Nombre" FullWidth />
        <MudTextField @bind-Value="model.LastName" Label="Apellido" FullWidth Class="mt-2" />
        <MudTextField @bind-Value="model.Age" Label="Edad" FullWidth Class="mt-2" />
        <MudTextField @bind-Value="model.Email" Label="Correo" FullWidth Class="mt-2" />

        <MudTextField @bind-Value="model.Password"
                      Label="Contraseña"
                      InputType="InputType.Password"
                      FullWidth Class="mt-2" />

        <MudTextField @bind-Value="model.ConfirmPassword"
                      Label="Confirmar contraseña"
                      InputType="InputType.Password"
                      FullWidth Class="mt-2" />

        <MudSelect T="int" @bind-Value="model.RoleId" Label="Rol" Class="mt-4">
            <MudSelectItem Value="1">Admin</MudSelectItem>
            <MudSelectItem Value="2">Empleado</MudSelectItem>
            <MudSelectItem Value="3">Cliente</MudSelectItem>
        </MudSelect>

        <MudButton OnClick="HandleCreate"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   Class="mt-4"
                   FullWidth>
            Crear Usuario
        </MudButton>

    </MudPaper>

</MudContainer>

@code {

    private AdminRegisterModel model = new();

    private async Task HandleCreate()
    {
        try
        {
            await AuthService.CreateUserByAdminAsync(model);
            Nav.NavigateTo("/admin");

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
}