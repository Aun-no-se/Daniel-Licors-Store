@page "/admin/usuarios"
@using Daniel_Licors_Store.Models.Admin


<PageTitle>Gestión de Cuentas · Daniel Licors</PageTitle>

<div class="dl-users-page">

    @if (loading)
    {
        <div class="dl-users-loading">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <p>Cargando cuentas...</p>
        </div>
    }
    else
    {
        <!-- ══ HEADER ══════════════════════════════════════════════════════ -->
        <div class="dl-users-header">
            <div class="dl-users-title-block">
                <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Class="dl-users-title-icon" />
                <div>
                    <h1 class="dl-users-title">Gestión de Cuentas</h1>
                    <p class="dl-users-subtitle">Supervisión completa de usuarios, roles y actividad</p>
                </div>
            </div>
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       Class="dl-users-btn-new"
                       Href="/admin/create-user">
                Nueva Cuenta
            </MudButton>
        </div>

        <!-- ══ KPI CARDS ════════════════════════════════════════════════════ -->
        <div class="dl-users-kpi-grid">
            <!-- Total general -->
            <div class="dl-users-kpi">
                <div class="dl-users-kpi-icon total">
                    <MudIcon Icon="@Icons.Material.Filled.Group" />
                </div>
                <div>
                    <div class="dl-users-kpi-val">@TotalUsers</div>
                    <div class="dl-users-kpi-label">Total de cuentas</div>
                </div>
            </div>
            <!-- Activas -->
            <div class="dl-users-kpi">
                <div class="dl-users-kpi-icon active">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                </div>
                <div>
                    <div class="dl-users-kpi-val">@TotalActive</div>
                    <div class="dl-users-kpi-label">Cuentas activas</div>
                </div>
            </div>
            <!-- Inactivas -->
            <div class="dl-users-kpi">
                <div class="dl-users-kpi-icon inactive">
                    <MudIcon Icon="@Icons.Material.Filled.Cancel" />
                </div>
                <div>
                    <div class="dl-users-kpi-val">@TotalInactive</div>
                    <div class="dl-users-kpi-label">Deshabilitadas</div>
                </div>
            </div>
            <!-- Por rol -->
            @foreach (var rs in roleSummaries)
            {
                <div class="dl-users-kpi">
                    <div class="dl-users-kpi-icon role @rs.RoleName.ToLower()">
                        <MudIcon Icon="@RoleIcon(rs.RoleName)" />
                    </div>
                    <div>
                        <div class="dl-users-kpi-val">@rs.Total</div>
                        <div class="dl-users-kpi-label">
                            @rs.RoleName
                            <span class="dl-kpi-sub">@rs.Active activos · @rs.Inactive inactivos</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- ══ TABS ═════════════════════════════════════════════════════════ -->
        <MudTabs @bind-ActivePanelIndex="activeTab" Class="dl-users-tabs" PanelClass="dl-users-tabpanel">

            <!-- ── TAB 1: TODAS LAS CUENTAS ─────────────────────────────── -->
            <MudTabPanel Text="Cuentas" Icon="@Icons.Material.Filled.People">

                <!-- Filtros -->
                <div class="dl-users-filters">
                    <MudTextField T="string"
                                  Value="searchText"
                                  ValueChanged="OnSearchChanged"
                                  Placeholder="Buscar por nombre o email..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined"
                                  Clearable="true"
                                  Class="dl-filter-search" />

                    <MudSelect T="string"
                               Value="roleFilter"
                               ValueChanged="OnRoleFilterChanged"
                               Placeholder="Todos los roles"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               Class="dl-filter-select">
                        <MudSelectItem T="string" Value="@("Admin")">Admin</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Empleado")">Empleado</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Cliente")">Cliente</MudSelectItem>
                    </MudSelect>

                    <MudSelect T="string"
                               Value="statusFilter"
                               ValueChanged="OnStatusFilterChanged"
                               Placeholder="Todos los estados"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               Class="dl-filter-select">
                        <MudSelectItem T="string" Value="@("active")">Activas</MudSelectItem>
                        <MudSelectItem T="string" Value="@("inactive")">Deshabilitadas</MudSelectItem>
                    </MudSelect>

                    <MudSelect T="string"
                               Value="sortBy"
                               ValueChanged="OnSortChanged"
                               Label="Ordenar por"
                               Variant="Variant.Outlined"
                               Class="dl-filter-select">
                        <MudSelectItem T="string" Value="@("LastActivity")">Última actividad</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Name")">Nombre</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Created")">Fecha creación</MudSelectItem>
                    </MudSelect>
                </div>

                <!-- Contador -->
                <div class="dl-users-count">
                    @allUsers.Count cuenta(s) encontrada(s)
                </div>

                <!-- Lista de usuarios -->
                <div class="dl-users-list">
                    @foreach (var user in allUsers)
                    {
                        var isSelected = selectedUser?.UserId == user.UserId;
                        <div class="dl-user-card @(isSelected ? "selected" : "") @(!user.IsActive ? "disabled-account" : "")"
                             @onclick="() => SelectUserAsync(user)">

                            <!-- Avatar -->
                            <div class="dl-user-avatar @user.RoleName.ToLower()">
                                @user.Initials
                            </div>

                            <!-- Info principal -->
                            <div class="dl-user-info">
                                <div class="dl-user-name">
                                    @user.FullName @user.LastName
                                    @if (!user.IsActive)
                                    {
                                        <span class="dl-badge-disabled">DESHABILITADA</span>
                                    }
                                </div>
                                <div class="dl-user-email">@user.Email</div>
                                <div class="dl-user-meta">
                                    Registrado @user.CreatedAt.ToString("dd MMM yyyy")
                                    @if (user.TotalOrders > 0)
                                    {
                                        <span>· @user.TotalOrders pedido(s)</span>
                                    }
                                </div>
                            </div>

                            <!-- Rol -->
                            <span class="dl-role-chip @RoleChipClass(user.RoleName)">
                                <MudIcon Icon="@RoleIcon(user.RoleName)" Size="Size.Small" />
                                @user.RoleName
                            </span>

                            <!-- Última actividad -->
                            <div class="dl-user-activity">
                                @if (user.LastActivityAt.HasValue)
                                {
                                    <div class="dl-act-label">@user.LastAction</div>
                                    <div class="dl-act-entity">@user.LastEntity @(user.LastEntityId != null ? $"#{user.LastEntityId}" : "")</div>
                                    <div class="dl-act-time">@FormatRelativeTime(user.LastActivityAt)</div>
                                }
                                else
                                {
                                    <div class="dl-act-none">Sin actividad registrada</div>
                                }
                            </div>

                            <!-- Total acciones -->
                            <div class="dl-user-actions-count">
                                <div class="dl-act-num">@user.TotalActions</div>
                                <div class="dl-act-num-label">acciones</div>
                            </div>

                            <!-- Dot de estado -->
                            <div class="dl-status-dot @(user.IsActive ? "on" : "off")"
                                 title="@(user.IsActive ? "Cuenta activa" : "Cuenta deshabilitada")">
                            </div>

                            <!-- Botón toggle estado -->
                            <MudIconButton Icon="@(user.IsActive? Icons.Material.Filled.LockOpen : Icons.Material.Filled.Lock)"
                                           Color="@(user.IsActive ? Color.Success : Color.Error)"
                                           Size="Size.Small"
                                           Title="@(user.IsActive ? "Deshabilitar cuenta" : "Activar cuenta")"
                                           OnClick="@(async () => await ToggleUserStatusAsync(user))"
                                           Class="dl-toggle-btn" />

                        </div>

                        <!-- Panel expandible de logs del usuario seleccionado -->
                        @if (isSelected)
                        {
                            <div class="dl-user-logs-panel">
                                <div class="dl-logs-panel-header">
                                    <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" />
                                    Historial de actividad — @user.FullName @user.LastName
                                    <span class="dl-logs-count">@selectedUserLogs.Count acción(es)</span>
                                </div>

                                @if (auditLoading)
                                {
                                    <div class="dl-logs-loading">
                                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                                    </div>
                                }
                                else if (!selectedUserLogs.Any())
                                {
                                    <div class="dl-logs-empty">
                                        <MudIcon Icon="@Icons.Material.Filled.EventBusy" />
                                        Esta cuenta no tiene acciones registradas aún.
                                    </div>
                                }
                                else
                                {
                                    <div class="dl-logs-timeline">
                                        @foreach (var log in selectedUserLogs)
                                        {
                                            <div class="dl-log-entry">
                                                <div class="dl-log-icon-wrap">
                                                    <MudIcon Icon="@ActionIcon(log.Action)" Size="Size.Small" />
                                                </div>
                                                <div class="dl-log-body">
                                                    <span class="dl-log-action">@log.Action</span>
                                                    @if (!string.IsNullOrEmpty(log.Entity))
                                                    {
                                                        <span class="dl-log-entity">
                                                            en @log.Entity
                                                            @(log.EntityId != null ? $"#{log.EntityId}" : "")
                                                        </span>
                                                    }
                                                </div>
                                                <div class="dl-log-time">@log.CreatedAt.ToString("dd MMM, hh:mm tt")</div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }

                    @if (!allUsers.Any())
                    {
                        <div class="dl-users-empty">
                            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Class="dl-empty-icon" />
                            <p>No se encontraron cuentas con esos filtros.</p>
                        </div>
                    }
                </div>

            </MudTabPanel>

            <!-- ── TAB 2: FEED GLOBAL DE AUDITORÍA ──────────────────────── -->
            <MudTabPanel Text="Auditoría Global" Icon="@Icons.Material.Filled.Security">

                <div class="dl-global-feed-header">
                    <MudIcon Icon="@Icons.Material.Filled.Timeline" />
                    Últimas 100 acciones en el sistema
                </div>

                @if (!globalFeed.Any())
                {
                    <div class="dl-users-empty">
                        <MudIcon Icon="@Icons.Material.Filled.EventBusy" Class="dl-empty-icon" />
                        <p>No hay acciones registradas aún.</p>
                    </div>
                }
                else
                {
                    <div class="dl-global-timeline">
                        @foreach (var log in globalFeed)
                        {
                            <div class="dl-glog-row">
                                <div class="dl-glog-dot @log.RoleName.ToLower()"></div>
                                <div class="dl-glog-user">
                                    <span class="dl-glog-name">@log.UserName</span>
                                    <span class="dl-role-chip @RoleChipClass(log.RoleName) sm">@log.RoleName</span>
                                </div>
                                <div class="dl-glog-action">
                                    <MudIcon Icon="@ActionIcon(log.Action)" Size="Size.Small" />
                                    <span class="dl-glog-act-text">@log.Action</span>
                                    @if (!string.IsNullOrEmpty(log.Entity))
                                    {
                                        <span class="dl-glog-entity">
                                            · @log.Entity @(log.EntityId != null ? $"#{log.EntityId}" : "")
                                        </span>
                                    }
                                </div>
                                <div class="dl-glog-time">
                                    @log.CreatedAt.ToString("dd MMM, hh:mm tt")
                                </div>
                            </div>
                        }
                    </div>
                }

            </MudTabPanel>

        </MudTabs>
    }
</div>

<!-- ══ ESTILOS ══════════════════════════════════════════════════════════════ -->
<style>
    /* ═══════════════════════════════════════════
           GESTIÓN DE CUENTAS — tema oscuro crimson/gold
           Daniel Liquor Store
        ════════════════════════════════════════════ */

    .dl-users-page {
        --dl-red: #FF1744;
        --dl-red-dark: #B71C1C;
        --dl-gold: #E8C468;
        --dl-surface: rgba(255,255,255,0.045);
        --dl-surface-hover: rgba(255,255,255,0.07);
        --dl-border: rgba(255,255,255,0.09);
        --dl-text: #f5f5f5;
        --dl-text-muted: rgba(255,255,255,0.55);
        --dl-text-dim: rgba(255,255,255,0.35);
        padding: 1.25rem 1rem 3rem;
        max-width: 1200px;
        margin: 0 auto;
        font-family: var(--mud-typography-default-family, 'Inter', sans-serif);
    }

    .dl-users-loading {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        padding: 4rem 0;
        color: var(--dl-text-muted);
    }

    /* ── Header ──────────────────────────────────────────────────────── */
    .dl-users-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.75rem;
    }

    .dl-users-title-block {
        display: flex;
        align-items: center;
        gap: .85rem;
    }

    .dl-users-title-icon {
        font-size: 2.4rem;
        color: var(--dl-red);
    }

    .dl-users-title {
        margin: 0;
        font-size: 1.55rem;
        font-weight: 700;
        color: var(--dl-text);
    }

    .dl-users-subtitle {
        margin: 0;
        font-size: .83rem;
        color: var(--dl-text-muted);
    }

    .dl-users-btn-new {
        background: linear-gradient(135deg, var(--dl-red) 0%, var(--dl-red-dark) 100%) !important;
        color: #fff !important;
        border-radius: 10px !important;
        text-transform: none !important;
        box-shadow: 0 6px 18px rgba(255,23,68,0.35) !important;
        transition: box-shadow .2s ease, transform .2s ease;
    }

        .dl-users-btn-new:hover {
            box-shadow: 0 8px 22px rgba(255,23,68,0.5) !important;
            transform: translateY(-1px);
        }

    /* ── KPI Grid ────────────────────────────────────────────────────── */
    .dl-users-kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
        gap: .85rem;
        margin-bottom: 1.75rem;
    }

    .dl-users-kpi {
        background: var(--dl-surface);
        border: 1px solid var(--dl-border);
        border-radius: 12px;
        padding: 1rem 1.1rem;
        display: flex;
        align-items: center;
        gap: .85rem;
        backdrop-filter: blur(10px);
        transition: transform .18s ease, border-color .18s ease, background .18s ease;
    }

        .dl-users-kpi:hover {
            transform: translateY(-2px);
            border-color: rgba(255,23,68,0.3);
            background: var(--dl-surface-hover);
        }

    .dl-users-kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .dl-users-kpi-icon.total {
            background: rgba(156,39,176,0.15);
            color: #CE93D8;
        }

        .dl-users-kpi-icon.active {
            background: rgba(76,175,80,0.15);
            color: #66BB6A;
        }

        .dl-users-kpi-icon.inactive {
            background: rgba(255,23,68,0.15);
            color: #FF5C7F;
        }

        .dl-users-kpi-icon.admin {
            background: rgba(232,196,104,0.15);
            color: var(--dl-gold);
        }

        .dl-users-kpi-icon.empleado {
            background: rgba(33,150,243,0.15);
            color: #64B5F6;
        }

        .dl-users-kpi-icon.cliente {
            background: rgba(236,72,153,0.15);
            color: #F48FB1;
        }

    .dl-users-kpi-val {
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1;
        color: var(--dl-text);
    }

    .dl-users-kpi-label {
        font-size: .73rem;
        color: var(--dl-text-muted);
        margin-top: .15rem;
    }

    .dl-kpi-sub {
        display: block;
        font-size: .69rem;
        color: var(--dl-text-dim);
    }

    /* ── Tabs (Cuentas / Auditoría Global) ───────────────────────────── */
    .dl-users-tabs {
        background: transparent !important;
    }

        .dl-users-tabs .mud-tabs-tabbar {
            background: linear-gradient(135deg, var(--dl-red) 0%, var(--dl-red-dark) 100%) !important;
            border: 1px solid rgba(255,255,255,0.14) !important;
            border-radius: 14px !important;
            padding: 5px !important;
            box-shadow: 0 8px 22px rgba(255,23,68,0.32) !important;
            position: relative;
            overflow: hidden;
        }

            .dl-users-tabs .mud-tabs-tabbar[class*="mud-tabs-tabbar-"] {
                background-color: transparent !important;
            }

        .dl-users-tabs .mud-tab {
            text-transform: uppercase;
            font-weight: 700;
            font-size: .82rem;
            letter-spacing: .4px;
            color: rgba(255,255,255,0.75) !important;
            background-color: transparent !important;
            border-radius: 10px !important;
            margin: 2px;
            z-index: 1;
            transition: color .25s ease, background-color .25s ease, transform .2s ease;
        }

            .dl-users-tabs .mud-tab:hover {
                color: #fff !important;
                background-color: rgba(255,255,255,0.12) !important;
                transform: translateY(-1px);
            }

        .dl-users-tabs .mud-tab-active {
            color: #fff !important;
            background-color: rgba(0,0,0,0.22) !important;
            box-shadow: inset 0 0 0 1px rgba(255,255,255,0.18);
        }

        .dl-users-tabs .mud-tab-slider {
            background: linear-gradient(90deg, var(--dl-gold), #ffffff) !important;
            height: 3px !important;
            box-shadow: 0 0 10px rgba(232,196,104,0.85);
        }

    .dl-users-tabpanel {
        padding: 1rem 0 !important;
        background: transparent !important;
    }

    /* ── Filtros ─────────────────────────────────────────────────────── */
    .dl-users-filters {
        display: flex;
        flex-wrap: wrap;
        gap: .65rem;
        margin-bottom: .85rem;
    }

    .dl-filter-search {
        flex: 1 1 260px;
    }

    .dl-filter-select {
        flex: 1 1 160px;
        max-width: 200px;
    }

    .dl-users-count {
        font-size: .78rem;
        color: var(--dl-text-muted);
        margin-bottom: .75rem;
        padding-left: .25rem;
    }

    /* ── Lista de usuarios ───────────────────────────────────────────── */
    .dl-users-list {
        display: flex;
        flex-direction: column;
        gap: .5rem;
    }

    .dl-user-card {
        background: var(--dl-surface);
        border-radius: 14px;
        padding: .9rem 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        cursor: pointer;
        transition: transform .18s ease, border-color .18s ease, background .18s ease, box-shadow .18s ease;
        border: 1px solid var(--dl-border);
        flex-wrap: wrap;
        backdrop-filter: blur(10px);
    }

        .dl-user-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 26px rgba(0,0,0,0.35);
            border-color: rgba(255,23,68,0.3);
            background: var(--dl-surface-hover);
        }

        .dl-user-card.selected {
            border-color: var(--dl-red);
            background: rgba(255,23,68,0.06);
            box-shadow: 0 0 0 1px rgba(255,23,68,0.25), 0 10px 26px rgba(255,23,68,0.15);
        }

        .dl-user-card.disabled-account {
            opacity: .6;
        }

    /* Avatar */
    .dl-user-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: .95rem;
        color: #fff;
        flex-shrink: 0;
        text-transform: uppercase;
        box-shadow: 0 2px 8px rgba(0,0,0,0.4);
    }

        .dl-user-avatar.admin {
            background: linear-gradient(135deg,#f0b429,#b8860b);
        }

        .dl-user-avatar.empleado {
            background: linear-gradient(135deg,#3b82f6,#1d4ed8);
        }

        .dl-user-avatar.cliente {
            background: linear-gradient(135deg,#ec4899,#be185d);
        }

    /* Info */
    .dl-user-info {
        flex: 1 1 180px;
        min-width: 0;
    }

    .dl-user-name {
        font-weight: 600;
        font-size: .92rem;
        color: var(--dl-text);
        display: flex;
        align-items: center;
        gap: .4rem;
        flex-wrap: wrap;
    }

    .dl-user-email {
        font-size: .78rem;
        color: var(--dl-text-muted);
        margin-top: .1rem;
    }

    .dl-user-meta {
        font-size: .72rem;
        color: var(--dl-text-dim);
        margin-top: .1rem;
    }

    .dl-badge-disabled {
        background: rgba(255,23,68,0.15);
        color: #FF5C7F;
        border: 1px solid rgba(255,23,68,0.3);
        border-radius: 4px;
        font-size: .65rem;
        padding: 1px 6px;
        font-weight: 700;
        letter-spacing: .3px;
    }

    /* Chips de rol */
    .dl-role-chip {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .25rem .65rem;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 600;
        flex-shrink: 0;
        white-space: nowrap;
        border: 1px solid transparent;
    }

        .dl-role-chip.sm {
            font-size: .65rem;
            padding: .15rem .45rem;
        }

    .dl-chip-admin {
        background: rgba(232,196,104,0.14);
        color: var(--dl-gold);
        border-color: rgba(232,196,104,0.32);
    }

    .dl-chip-empleado {
        background: rgba(33,150,243,0.14);
        color: #64B5F6;
        border-color: rgba(33,150,243,0.32);
    }

    .dl-chip-cliente {
        background: rgba(236,72,153,0.14);
        color: #F48FB1;
        border-color: rgba(236,72,153,0.32);
    }

    .dl-chip-default {
        background: rgba(255,255,255,0.06);
        color: var(--dl-text-muted);
        border-color: rgba(255,255,255,0.14);
    }

    /* Actividad */
    .dl-user-activity {
        flex: 1 1 160px;
        min-width: 0;
    }

    .dl-act-label {
        font-size: .75rem;
        font-weight: 600;
        color: rgba(255,255,255,0.8);
    }

    .dl-act-entity {
        font-size: .72rem;
        color: var(--dl-text-muted);
    }

    .dl-act-time {
        font-size: .68rem;
        color: var(--dl-text-dim);
    }

    .dl-act-none {
        font-size: .72rem;
        color: var(--dl-text-dim);
        font-style: italic;
    }

