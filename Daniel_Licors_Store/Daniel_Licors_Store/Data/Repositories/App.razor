<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#B71C1C">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="css/layout.css" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="css/topbar.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="stylesheet" href="Daniel_Licors_Store.styles.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</head>
<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />

    <script src="_framework/blazor.web.js"></script>
    <script src="https://unpkg.com/@@dotlottie/player-component@2.7.12/dist/dotlottie-player.mjs" type="module"></script>
    <script>
        // Carrusel: scroll suave sin Swiper ni dependencias externas
        window.catCarousel = {
            scroll: function (trackId, direction) {
                const track = document.getElementById(trackId);
                if (!track) return;
                track.scrollBy({ left: direction * 236, behavior: 'smooth' });
            }
        };

        // Scroll reveal por IntersectionObserver
        window.initScrollReveal = () => {
            const sections = document.querySelectorAll('.cat-section');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) entry.target.classList.add('reveal');
                });
            }, { threshold: 0.1 });
            sections.forEach(s => observer.observe(s));
        };

        // Drag-to-scroll con mouse para filas horizontales (combos/promociones
        // en ProductDetail). En teléfono el dedo ya scrollea nativo gracias a
        // touch-action: pan-x en el CSS; esto es para cuando se prueba/usa con
        // mouse normal, que no arrastra un overflow-x sin esto.
        window.initDragScroll = () => {
            document.querySelectorAll('.pd-cards-scroll').forEach(el => {
                if (el.dataset.dragInit) return; // no enganchar el listener dos veces
                el.dataset.dragInit = "true";

                let isDown = false;
                let startX = 0;
                let scrollLeft = 0;
                let moved = false;

                el.addEventListener('mousedown', (e) => {
                    isDown = true;
                    moved = false;
                    el.classList.add('pd-dragging');
                    startX = e.pageX - el.offsetLeft;
                    scrollLeft = el.scrollLeft;
                });

                const stopDrag = () => {
                    isDown = false;
                    el.classList.remove('pd-dragging');
                };

                el.addEventListener('mouseleave', stopDrag);
                el.addEventListener('mouseup', stopDrag);

                el.addEventListener('mousemove', (e) => {
                    if (!isDown) return;
                    e.preventDefault();
                    const x = e.pageX - el.offsetLeft;
                    const walk = (x - startX) * 1.2;
                    if (Math.abs(walk) > 5) moved = true;
                    el.scrollLeft = scrollLeft - walk;
                });

                // Si hubo arrastre real, cancela el click posterior (evita que
                // "arrastrar" dispare accidentalmente el click de la tarjeta)
                el.addEventListener('click', (e) => {
                    if (moved) {
                        e.stopPropagation();
                        e.preventDefault();
                    }
                }, true);
            });
        };
    </script>
</body>
</html>
